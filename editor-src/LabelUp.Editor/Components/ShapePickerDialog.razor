@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@using Microsoft.AspNetCore.Components.Forms
@inject EditorSession Session
@inject HistoryService History
@implements IDisposable

@if (Session.Dialog == EditorDialog.Clipart)
{
  <div class="ed-modal" role="dialog" aria-label="클립아트" @onclick="Cancel">
    <div class="ed-modal__card ed-modal__card--wide" @onclick:stopPropagation="true">
      <header class="ed-modal__head">
        <div>
          <h3>클립아트</h3>
          <p>항목을 클릭하면 라벨에 추가됩니다. 닫아도 기본 도형은 생기지 않습니다.</p>
        </div>
        <button type="button" class="ed-modal__close" @onclick="Cancel">×</button>
      </header>
      <nav class="ed-clip-tabs" role="tablist">
        <button type="button" class="ed-clip-tabs__btn @(Session.ClipartTab == "clipart" ? "is-active" : null)" @onclick='() => SetTab("clipart")'>클립아트</button>
        <button type="button" class="ed-clip-tabs__btn @(Session.ClipartTab == "fa" ? "is-active" : null)" @onclick='() => SetTab("fa")'>폰트어썸</button>
        <button type="button" class="ed-clip-tabs__btn @(Session.ClipartTab == "user" ? "is-active" : null)" @onclick='() => SetTab("user")'>사용자데이터</button>
      </nav>
      <div class="ed-modal__body">
        @if (Session.ClipartTab == "user")
        {
          <label class="ed-btn ed-btn--file ed-clip-upload">
            이미지/SVG 추가
            <InputFile OnChange="OnUserFile" accept="image/*,.svg" />
          </label>
          @if (Session.UserAssets.Count == 0)
          {
            <p class="ed-props__hint">업로드한 파일이 없습니다. 파일을 선택한 뒤 항목을 클릭하세요.</p>
          }
          else
          {
            <div class="ed-shape-grid">
              @foreach (var asset in Session.UserAssets)
              {
                <button type="button" class="ed-shape-card" @onclick="() => PickUser(asset)">
                  <img src="@asset.DataUrl" alt="@asset.Name" />
                  <span>@asset.Name</span>
                </button>
              }
            </div>
          }
        }
        else
        {
          var isFa = Session.ClipartTab == "fa";
          var items = isFa ? SvgLibrary.Icons : SvgLibrary.Cliparts;
          <div class="ed-shape-grid">
            @foreach (var item in items)
            {
              var pick = item;
              <button type="button" class="ed-shape-card" @onclick="() => PickSvg(pick.Id, pick.Path, isFa)">
                @((MarkupString)SvgLibrary.ToSvg(item.Path, "#7B2840", 48))
                <span>@item.Label</span>
              </button>
            }
          </div>
        }
      </div>
    </div>
  </div>
}

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void SetTab(string tab)
    {
        Session.ClipartTab = tab;
        Session.Notify();
    }

    private void Cancel()
    {
        Session.PendingInsert = null;
        Session.SetTool(EditorTool.Select);
        Session.CloseDialog();
    }

    private void PickSvg(string id, string path, bool isIcon)
    {
        History.Push(Session.Document);
        if (Session.PendingInsert is ObjectType.Clipart or ObjectType.Icon || Session.Selected is null || !IsGraphic(Session.Selected))
        {
            Session.PlaceDefault(isIcon ? ObjectType.Icon : ObjectType.Clipart, o =>
            {
                o.Svg = path;
                if (isIcon) o.IconName = id;
                else o.ClipartId = id;
            });
        }
        else
        {
            var o = Session.Selected;
            o.Type = isIcon ? ObjectType.Icon : ObjectType.Clipart;
            o.Svg = path;
            if (isIcon) o.IconName = id;
            else o.ClipartId = id;
            Session.Dirty = true;
            Session.Notify();
        }
        Session.PendingInsert = null;
        Session.SetTool(EditorTool.Select);
        Session.CloseDialog();
    }

    private void PickUser(UserAsset asset)
    {
        History.Push(Session.Document);
        Session.PlaceDefault(ObjectType.Image, o =>
        {
            o.ImageData = asset.DataUrl;
        });
        Session.PendingInsert = null;
        Session.SetTool(EditorTool.Select);
        Session.CloseDialog();
    }

    private async Task OnUserFile(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file.Size > 8 * 1024 * 1024)
            {
                Session.Status = "파일은 8MB 이하만 가능";
                Session.Notify();
                return;
            }
            await using var stream = file.OpenReadStream(8 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            var mime = file.ContentType is { Length: > 0 } ? file.ContentType : "image/png";
            Session.UserAssets.Add(new UserAsset
            {
                Name = file.Name.Length > 18 ? file.Name[..18] + "…" : file.Name,
                DataUrl = $"data:{mime};base64,{b64}"
            });
            Session.Notify();
        }
        catch (Exception ex)
        {
            Session.Status = "업로드 실패: " + ex.Message;
            Session.Notify();
        }
    }

    private static bool IsGraphic(DesignObject o)
        => o.Type is ObjectType.Clipart or ObjectType.Icon or ObjectType.Image;
}
