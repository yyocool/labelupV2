@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@implements IDisposable

@if (Session.Document.Data is { } data)
{
  if (Session.Dialog == EditorDialog.DataManager && !Session.DataManagerMinimized)
  {
    <div class="ed-modal" role="dialog" aria-label="데이터 관리">
      <div class="ed-modal__card ed-modal__card--wide" @onclick:stopPropagation="true">
        <header class="ed-modal__head">
          <div>
            <h3>데이터 관리</h3>
            <p>@data.SourceName · @data.RowCount 행 · 셀을 수정하거나 행을 삭제할 수 있습니다.</p>
          </div>
          <button type="button" class="ed-modal__close" title="최소화" @onclick="Minimize">—</button>
        </header>
        <div class="ed-modal__body ed-data-scroll">
          <table class="ed-data-table">
            <thead>
              <tr>
                <th>#</th>
                @foreach (var col in data.Columns)
                {
                  <th>@col</th>
                }
                <th></th>
              </tr>
            </thead>
            <tbody>
              @for (var r = 0; r < data.Rows.Count; r++)
              {
                var row = r;
                <tr>
                  <td>@(row + 1)</td>
                  @for (var c = 0; c < data.Columns.Count; c++)
                  {
                    var col = c;
                    <td>
                      <input value="@data.Get(row, data.Columns[col])" @onchange="e => EditCell(data, row, col, e)" />
                    </td>
                  }
                  <td><button type="button" class="ed-btn" @onclick="() => data.RemoveRow(row)">삭제</button></td>
                </tr>
              }
            </tbody>
          </table>
        </div>
        <footer class="ed-modal__foot">
          <button type="button" class="ed-btn ed-btn--primary" @onclick="Minimize">최소화</button>
        </footer>
      </div>
    </div>
  }
  else if (Session.DataManagerMinimized)
  {
    <button type="button" class="ed-data-restore" title="데이터 관리 열기" @onclick="Restore">
      <strong>데이터 관리</strong>
      <span>@data.RowCount 행 · 클릭하여 펼치기</span>
    </button>
  }
}

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void EditCell(DataSheet data, int row, int col, ChangeEventArgs e)
        => data.SetCell(row, col, e.Value?.ToString() ?? string.Empty);

    private void Minimize()
    {
        Session.DataManagerMinimized = true;
        Session.DataPanelVisible = Session.Document.Data is { RowCount: > 0 };
        Session.Document.EnsurePagesForData();
        Session.Dirty = true;
        Session.Dialog = EditorDialog.None;
        Session.Notify();
    }

    private void Restore()
    {
        Session.DataManagerMinimized = false;
        Session.OpenDialog(EditorDialog.DataManager);
    }
}
