@using LabelUp.Editor.Models
@using LabelUp.Editor.Rendering
@using LabelUp.Editor.Services
@inject EditorSession Session
@inject HistoryService History
@implements IDisposable

<aside class="ed-props @(Session.PropsMinimized ? "is-minimized" : null)" data-ed-props-panel data-ed-snap-id="tr" data-tut="props" aria-label="속성 / 레이어">
  <div class="ed-props__chrome" data-ed-props-handle>
    <span class="ed-props__grip" aria-hidden="true">⋮⋮</span>
    <span class="ed-props__title">속성 / 레이어</span>
    <button type="button" class="ed-props__min" data-tut="props-expand" title="접기" @onclick="TogglePropsMin">—</button>
  </div>

  @if (!Session.PropsMinimized)
  {
    <div class="ed-props__inner">
      <div class="ed-props__tabs" data-tut="props-tabs">
        <button type="button" class="ed-props__tab @(Session.PropsTab == "props" ? "is-active" : null)" data-tut="tab-props" @onclick="ShowPropsTab">속성</button>
        <button type="button" class="ed-props__tab @(Session.PropsTab == "layers" ? "is-active" : null)" data-tut="tab-layers" @onclick="ShowLayersTab">레이어</button>
      </div>

      @if (Session.PropsTab == "props")
      {
        if (Session.Selected is { } o)
        {
          <div class="ed-props__body">
            <div class="ed-field-group">
              <div class="ed-field-label">공통</div>
              <div class="ed-checks">
                <label class="ed-field ed-field--check"><input type="checkbox" checked="@o.Locked" @onchange="e => SetBool(v => o.Locked = v, e)" /> <span>속성잠금</span></label>
                <label class="ed-field ed-field--check"><input type="checkbox" checked="@o.Visible" @onchange="e => SetBool(v => o.Visible = v, e)" /> <span>표시</span></label>
              </div>
              <div class="ed-field-row">
                <label class="ed-field">Z-Index <input type="number" step="1" value="@o.ZIndex" @onchange="e => SetInt(v => o.ZIndex = v, e)" /></label>
                <label class="ed-field">투명도 <input type="number" step="0.05" min="0" max="1" value="@o.Opacity.ToString("0.##")" @onchange="e => SetFloat(v => o.Opacity = Math.Clamp(v, 0, 1), e)" /></label>
              </div>
            </div>

            <div class="ed-field-group">
              <div class="ed-field-label">사이즈 &amp; 위치 (mm)</div>
              <div class="ed-field-row">
                <label class="ed-field">X <input type="number" step="0.1" value="@o.X.ToString("0.##")" @onchange="e => SetFloat(v => o.X = v, e)" /></label>
                <label class="ed-field">Y <input type="number" step="0.1" value="@o.Y.ToString("0.##")" @onchange="e => SetFloat(v => o.Y = v, e)" /></label>
                <label class="ed-field">W <input type="number" step="0.1" value="@o.Width.ToString("0.##")" @onchange="e => SetFloat(v => o.Width = Math.Max(1, v), e)" /></label>
                <label class="ed-field">H <input type="number" step="0.1" value="@o.Height.ToString("0.##")" @onchange="e => SetFloat(v => o.Height = Math.Max(1, v), e)" /></label>
              </div>
            </div>

            <div class="ed-field-group">
              <div class="ed-field-label">회전</div>
              <label class="ed-field ed-field--full">
                <input type="number" step="1" value="@o.Rotation.ToString("0.#")" @onchange="e => SetFloat(v => o.Rotation = v, e)" />
              </label>
            </div>

            <div class="ed-field-group">
              <div class="ed-field-label">자료 연결</div>
              <div class="ed-checks">
                <label class="ed-field ed-field--check"><input type="checkbox" checked="@o.DataBound" @onchange="e => SetBool(v => o.DataBound = v, e)" /> <span>자료 표시</span></label>
              </div>
              @if (Session.Document.Data is { Columns.Count: > 0 } data)
              {
                <label class="ed-field ed-field--full">
                  열
                  <select value="@o.DataColumn" @onchange="e => SetString(v => o.DataColumn = v, e)">
                    <option value="">선택</option>
                    @foreach (var col in data.Columns)
                    {
                      <option value="@col">@col</option>
                    }
                  </select>
                </label>
              }
              else
              {
                <p class="ed-props__hint">상단 「데이터 가져오기」로 CSV/엑셀을 연결하세요.</p>
              }
            </div>

            @if (o.Type == ObjectType.Text)
            {
              <div class="ed-field-group">
                <div class="ed-field-label">텍스트 (통합)</div>
                <textarea class="ed-textarea" rows="3" @onchange="e => SetText(o, e)">@o.Text</textarea>
                <label class="ed-field ed-field--full">
                  표현 방식
                  <select value="@o.TextMode" @onchange="OnTextMode">
                    <option value="@TextMode.Normal">일반 텍스트</option>
                    <option value="@TextMode.Extended">확장 문자열 (여러 줄)</option>
                    <option value="@TextMode.WordArt">워드아트</option>
                    <option value="@TextMode.Custom">사용자 정의 (날짜/일련번호)</option>
                  </select>
                </label>
                <div class="ed-field-row">
                  <label class="ed-field">크기 <input type="number" step="0.1" value="@o.FontSize.ToString("0.##")" @onchange="e => SetFloat(v => o.FontSize = Math.Max(1, v), e)" /></label>
                </div>
                <div class="ed-checks">
                  <label class="ed-field ed-field--check"><input type="checkbox" checked="@o.Bold" @onchange="e => SetBool(v => o.Bold = v, e)" /> <span>굵게</span></label>
                  <label class="ed-field ed-field--check"><input type="checkbox" checked="@o.Italic" @onchange="e => SetBool(v => o.Italic = v, e)" /> <span>기울임</span></label>
                  <label class="ed-field ed-field--check"><input type="checkbox" checked="@o.Underline" @onchange="e => SetBool(v => o.Underline = v, e)" /> <span>밑줄</span></label>
                </div>
                <div class="ed-field-row">
                  <label class="ed-field">가로정렬
                    <select value="@o.TextAlign" @onchange="e => SetString(v => o.TextAlign = v, e)">
                      <option value="left">왼쪽</option>
                      <option value="center">가운데</option>
                      <option value="right">오른쪽</option>
                    </select>
                  </label>
                  <label class="ed-field">세로정렬
                    <select value="@o.VerticalAlign" @onchange="e => SetString(v => o.VerticalAlign = v, e)">
                      <option value="top">위</option>
                      <option value="middle">가운데</option>
                      <option value="bottom">아래</option>
                    </select>
                  </label>
                </div>
                <div class="ed-field-row">
                  <label class="ed-field">행간 <input type="number" step="0.05" value="@o.LineHeight.ToString("0.##")" @onchange="e => SetFloat(v => o.LineHeight = v, e)" /></label>
                  <label class="ed-field">자간 <input type="number" step="0.1" value="@o.LetterSpacing.ToString("0.##")" @onchange="e => SetFloat(v => o.LetterSpacing = v, e)" /></label>
                </div>
                @if (o.TextMode == TextMode.WordArt)
                {
                  <label class="ed-field ed-field--full">
                    워드아트 모양
                    <select value="@o.WordArtStyle" @onchange="OnWordArt">
                      <option value="@WordArtStyle.ArcUp">위로 호</option>
                      <option value="@WordArtStyle.ArcDown">아래로 호</option>
                      <option value="@WordArtStyle.Wave">물결</option>
                      <option value="@WordArtStyle.Circle">원형</option>
                    </select>
                  </label>
                  <div class="ed-checks">
                    <label class="ed-field ed-field--check"><input type="checkbox" checked="@o.WordArtGuide" @onchange="e => SetBool(v => o.WordArtGuide = v, e)" /> <span>안내선</span></label>
                  </div>
                }
                @if (o.TextMode == TextMode.Custom)
                {
                  <label class="ed-field ed-field--full">
                    종류
                    <select value="@o.CustomKind" @onchange="e => SetString(v => o.CustomKind = v, e)">
                      <option value="date">날짜</option>
                      <option value="time">시간</option>
                      <option value="serial">일련번호</option>
                    </select>
                  </label>
                  <label class="ed-field ed-field--full">서식 <input value="@o.CustomFormat" @onchange="e => SetString(v => o.CustomFormat = v, e)" /></label>
                  <div class="ed-field-row">
                    <label class="ed-field">시작 <input type="number" value="@o.SerialStart" @onchange="e => SetInt(v => o.SerialStart = v, e)" /></label>
                    <label class="ed-field">증가 <input type="number" value="@o.SerialStep" @onchange="e => SetInt(v => o.SerialStep = v, e)" /></label>
                  </div>
                }
              </div>
            }

            @if (DesignObject.IsShape(o.Type))
            {
              <div class="ed-field-group">
                <div class="ed-field-label">도형</div>
                <label class="ed-field ed-field--full">
                  종류
                  <select value="@o.ShapeKind" @onchange="OnShapeKind">
                    <option value="@ShapeKind.Rect">사각형</option>
                    <option value="@ShapeKind.RoundRect">둥근 사각형</option>
                    <option value="@ShapeKind.Circle">원</option>
                    <option value="@ShapeKind.Triangle">삼각형</option>
                    <option value="@ShapeKind.Ellipse">타원</option>
                    <option value="@ShapeKind.Line">선</option>
                    <option value="@ShapeKind.Arrow">화살표</option>
                    <option value="@ShapeKind.Polygon">정다각형</option>
                  </select>
                </label>
                @if (o.ShapeKind == ShapeKind.Arrow)
                {
                  <label class="ed-field ed-field--full">
                    화살 머리
                    <select value="@o.ArrowHeads" @onchange="OnArrowHeads">
                      <option value="@ArrowHeads.End">오른쪽만</option>
                      <option value="@ArrowHeads.Start">왼쪽만</option>
                      <option value="@ArrowHeads.Both">양쪽</option>
                    </select>
                  </label>
                }
                @if (o.ShapeKind == ShapeKind.Polygon)
                {
                  <label class="ed-field ed-field--full">몇각형 <input type="number" min="3" max="16" value="@o.PolygonSides" @onchange="e => SetInt(v => o.PolygonSides = Math.Clamp(v, 3, 16), e)" /></label>
                }
                @if (o.ShapeKind == ShapeKind.RoundRect)
                {
                  <label class="ed-field ed-field--full">모서리 반경(mm) <input type="number" step="0.1" min="0" value="@o.CornerRadiusMm.ToString("0.##")" @onchange="e => SetFloat(v => o.CornerRadiusMm = Math.Max(0, v), e)" /></label>
                }
              </div>
            }

            @if (o.Type is ObjectType.Barcode or ObjectType.Qr)
            {
              <div class="ed-field-group">
                <div class="ed-field-label">@(o.Type == ObjectType.Qr ? "QR / 2D코드" : "바코드")</div>
                @if (o.Type == ObjectType.Barcode)
                {
                  <label class="ed-field ed-field--full">
                    심볼로지
                    <select value="@o.BarcodeFormat" @onchange="e => SetString(v => o.BarcodeFormat = v, e)">
                      @foreach (var spec in BarcodeCatalog.OneD)
                      {
                        <option value="@spec.Id">@spec.Label</option>
                      }
                    </select>
                  </label>
                  <div class="ed-checks">
                    <label class="ed-field ed-field--check"><input type="checkbox" checked="@o.BarcodeShowText" @onchange="e => SetBool(v => o.BarcodeShowText = v, e)" /> <span>내용 표시</span></label>
                    <label class="ed-field ed-field--check"><input type="checkbox" checked="@o.BarcodeShowStartEnd" @onchange="e => SetBool(v => o.BarcodeShowStartEnd = v, e)" /> <span>시작·끝 표시</span></label>
                  </div>
                }
                else
                {
                  <label class="ed-field ed-field--full">
                    종류
                    <select value="@o.BarcodeFormat" @onchange="e => SetString(v => o.BarcodeFormat = v, e)">
                      @foreach (var spec in BarcodeCatalog.TwoD)
                      {
                        <option value="@spec.Id">@spec.Label</option>
                      }
                    </select>
                  </label>
                  <label class="ed-field ed-field--full">
                    오류복원
                    <select value="@o.QrEcc" @onchange="e => SetString(v => o.QrEcc = v, e)">
                      <option value="L">L</option>
                      <option value="M">M</option>
                      <option value="Q">Q</option>
                      <option value="H">H</option>
                    </select>
                  </label>
                }
                <label class="ed-field ed-field--full">@BarcodeCatalog.ValueFieldLabel(o.BarcodeFormat) <input value="@o.BarcodeValue" @onchange="e => SetString(v => o.BarcodeValue = v, e)" /></label>
              </div>
            }

            @if (o.Type == ObjectType.Table)
            {
              <div class="ed-field-group">
                <div class="ed-field-label">표</div>
                <div class="ed-field-row">
                  <label class="ed-field">행 <input type="number" min="1" max="12" value="@o.TableRows" @onchange="e => SetInt(v => { o.TableRows = Math.Clamp(v, 1, 12); o.EnsureTableSize(); }, e)" /></label>
                  <label class="ed-field">열 <input type="number" min="1" max="12" value="@o.TableCols" @onchange="e => SetInt(v => { o.TableCols = Math.Clamp(v, 1, 12); o.EnsureTableSize(); }, e)" /></label>
                </div>
                @for (var r = 0; r < o.TableRows; r++)
                {
                  var row = r;
                  <div class="ed-field-row">
                    @for (var c = 0; c < o.TableCols; c++)
                    {
                      var col = c;
                      <label class="ed-field">
                        @(row + 1),@(col + 1)
                        <input value="@o.GetTableCell(row, col)" @onchange="e => SetTableCell(o, row, col, e)" />
                      </label>
                    }
                  </div>
                }
              </div>
            }

            @if (o.Type is ObjectType.Clipart or ObjectType.Icon)
            {
              <div class="ed-field-group">
                <div class="ed-field-label">@(o.Type == ObjectType.Icon ? "폰트어썸 / 아이콘" : "클립아트")</div>
                <button type="button" class="ed-btn" @onclick="OpenClipartReplace">모양 바꾸기</button>
              </div>
            }

            <div class="ed-field-group">
              <div class="ed-field-label">채우기</div>
              <label class="ed-field ed-field--full">
                <input type="color" value="@NormalizeHex(o.Fill)" @onchange="e => SetColor(v => o.Fill = v, e)" />
              </label>
            </div>

            <div class="ed-field-group">
              <div class="ed-field-label">선</div>
              <div class="ed-field-row">
                <label class="ed-field">색 <input type="color" value="@NormalizeHex(o.Stroke)" @onchange="e => SetColor(v => o.Stroke = v, e)" /></label>
                <label class="ed-field">굵기 <input type="number" step="0.05" min="0" value="@o.StrokeWidth.ToString("0.##")" @onchange="e => SetFloat(v => o.StrokeWidth = Math.Max(0, v), e)" /></label>
              </div>
            </div>

            @if (o.Type == ObjectType.Image)
            {
              <div class="ed-field-group">
                <div class="ed-field-label">이미지 파일</div>
                <InputFile OnChange="OnImage" accept="image/*" />
                <label class="ed-field ed-field--full">
                  맞춤
                  <select value="@o.ImageFit" @onchange="e => SetString(v => o.ImageFit = v, e)">
                    <option value="contain">맞춤</option>
                    <option value="cover">채우기</option>
                    <option value="stretch">늘리기</option>
                  </select>
                </label>
              </div>
            }
          </div>
        }
        else
        {
          <div class="ed-props__empty">
            오브젝트를 선택하거나, 플로팅 도구로 텍스트·바코드·표·클립아트를 추가하세요.
          </div>
        }
      }
      else
      {
        <div class="ed-props__body ed-props__layers">
          @if (Session.CurrentCell.Objects.Count == 0)
          {
            <div class="ed-props__empty">레이어가 없습니다.</div>
          }
          else
          {
            @foreach (var obj in Session.CurrentCell.Objects.OrderByDescending(x => x.ZIndex).ThenByDescending(x => Session.CurrentCell.Objects.IndexOf(x)))
            {
              <button type="button"
                      class="ed-layer-item @(Session.SelectedIds.Contains(obj.Id) ? "is-active" : null)"
                      @onclick="() => Session.Select(obj.Id)">
                <span>@(obj.Locked ? "🔒" : "👁")</span>
                <span>@LayerLabel(obj)</span>
                <em>z @obj.ZIndex</em>
              </button>
            }
          }
        </div>
      }
    </div>
  }
</aside>

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void SetTab(string tab) { Session.PropsTab = tab; Session.Notify(); }
    private void ShowPropsTab() => SetTab("props");
    private void ShowLayersTab() => SetTab("layers");
    private void TogglePropsMin() { Session.PropsMinimized = !Session.PropsMinimized; Session.Notify(); }

    private void OpenClipartReplace()
    {
        Session.PendingInsert = null;
        Session.ClipartTab = Session.Selected?.Type == ObjectType.Icon ? "fa" : "clipart";
        Session.OpenDialog(EditorDialog.Clipart);
    }

    private static string LayerLabel(DesignObject o) => o.Type switch
    {
        ObjectType.Text => string.IsNullOrWhiteSpace(o.Text) ? "텍스트" : (o.Text.Length > 18 ? o.Text[..18] + "…" : o.Text),
        ObjectType.Image => "이미지",
        ObjectType.Rect => "사각형",
        ObjectType.Ellipse => "원",
        ObjectType.Line => "선",
        ObjectType.Shape => o.ShapeKind switch
        {
            ShapeKind.RoundRect => "둥근 사각형",
            ShapeKind.Circle => "원",
            ShapeKind.Triangle => "삼각형",
            ShapeKind.Ellipse => "타원",
            ShapeKind.Line => "선",
            ShapeKind.Arrow => "화살표",
            ShapeKind.Polygon => $"{o.PolygonSides}각형",
            _ => "사각형"
        },
        ObjectType.Barcode => "바코드",
        ObjectType.Qr => "QR",
        ObjectType.Table => "표",
        ObjectType.Clipart => "클립아트",
        ObjectType.Icon => o.IconName ?? "아이콘",
        _ => o.Type.ToString()
    };

    private static string NormalizeHex(string? c)
    {
        if (string.IsNullOrWhiteSpace(c) || c is "transparent" or "none") return "#7B2840";
        return c.StartsWith('#') ? c : "#" + c;
    }

    private void Touch()
    {
        Session.Dirty = true;
        Session.Notify();
    }

    private void SetFloat(Action<float> apply, ChangeEventArgs e)
    {
        if (!float.TryParse(e.Value?.ToString(), out var v)) return;
        History.Push(Session.Document);
        apply(v);
        Touch();
    }

    private void SetInt(Action<int> apply, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return;
        History.Push(Session.Document);
        apply(v);
        Touch();
    }

    private void SetBool(Action<bool> apply, ChangeEventArgs e)
    {
        History.Push(Session.Document);
        apply(e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase));
        Touch();
    }

    private void SetColor(Action<string> apply, ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        if (string.IsNullOrEmpty(v)) return;
        History.Push(Session.Document);
        apply(v);
        Touch();
    }

    private void SetString(Action<string> apply, ChangeEventArgs e)
    {
        History.Push(Session.Document);
        apply(e.Value?.ToString() ?? "");
        Touch();
    }

    private void SetText(DesignObject o, ChangeEventArgs e)
    {
        History.Push(Session.Document);
        o.Text = e.Value?.ToString() ?? "";
        Touch();
    }

    private void OnTextMode(ChangeEventArgs e)
    {
        if (Session.Selected is null) return;
        History.Push(Session.Document);
        if (Enum.TryParse<TextMode>(e.Value?.ToString(), true, out var mode))
            Session.Selected.TextMode = mode;
        Touch();
    }

    private void OnShapeKind(ChangeEventArgs e)
    {
        if (Session.Selected is null) return;
        History.Push(Session.Document);
        if (Enum.TryParse<ShapeKind>(e.Value?.ToString(), true, out var kind))
        {
            Session.Selected.Type = ObjectType.Shape;
            Session.Selected.ShapeKind = kind;
        }
        Touch();
    }

    private void OnArrowHeads(ChangeEventArgs e)
    {
        if (Session.Selected is null) return;
        History.Push(Session.Document);
        if (Enum.TryParse<ArrowHeads>(e.Value?.ToString(), true, out var heads))
            Session.Selected.ArrowHeads = heads;
        Touch();
    }

    private void OnWordArt(ChangeEventArgs e)
    {
        if (Session.Selected is null) return;
        History.Push(Session.Document);
        if (Enum.TryParse<WordArtStyle>(e.Value?.ToString(), true, out var style))
            Session.Selected.WordArtStyle = style;
        Touch();
    }

    private void SetTableCell(DesignObject o, int row, int col, ChangeEventArgs e)
    {
        History.Push(Session.Document);
        o.SetTableCell(row, col, e.Value?.ToString() ?? string.Empty);
        Touch();
    }

    private async Task OnImage(InputFileChangeEventArgs e)
    {
        if (Session.Selected is null || Session.Selected.Type != ObjectType.Image) return;
        var file = e.File;
        if (file.Size > 8 * 1024 * 1024) { Session.Status = "이미지는 8MB 이하만 가능"; return; }
        await using var stream = file.OpenReadStream(8 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var b64 = Convert.ToBase64String(ms.ToArray());
        var mime = file.ContentType is { Length: > 0 } ? file.ContentType : "image/png";
        History.Push(Session.Document);
        DocumentRenderer.InvalidateImage(Session.Selected.Id);
        Session.Selected.ImageData = $"data:{mime};base64,{b64}";
        Touch();
        Session.Status = "이미지 적용됨";
    }
}
