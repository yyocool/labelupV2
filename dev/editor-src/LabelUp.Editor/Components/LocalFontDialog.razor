@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@inject FontCatalog Fonts
@inject IJSRuntime Js
@implements IDisposable

@if (Session.Dialog == EditorDialog.LocalFont)
{
  <div class="ed-modal" role="dialog" aria-label="윈도우 글꼴 가져오기" data-local-font-dialog>
    <div class="ed-modal__card ed-modal__card--confirm" @onclick:stopPropagation="true">
      <header class="ed-modal__head">
        <div>
          <h3>이 PC 글꼴을 쓸까요?</h3>
          <p>Chrome 또는 Edge에서 「허용」을 누르면, 이미 설치된 글꼴로 그립니다. 파일은 서버로 보내지 않습니다.</p>
        </div>
        <button type="button" class="ed-modal__close" @onclick="Skip" disabled="@_busy">×</button>
      </header>
      <div class="ed-modal__body">
        <p>대상 글꼴</p>
        <p class="ed-vendor-report__counts">
          @foreach (var name in Session.PendingLocalFonts)
          {
            <span>@name</span>
          }
        </p>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
          <p class="ed-vendor-report__error">@_error</p>
        }
        else if (_notFound.Count == 0)
        {
          <p>「Chrome에서 허용」을 누르면 바로 아래 허용 창이 떠야 합니다.</p>
        }
        @if (_notFound.Count > 0)
        {
          <p>못 찾은 글꼴은 대체 글꼴로 그립니다. 글꼴 파일을 직접 고르면 그대로 씁니다.</p>
          <ul class="ed-local-font__picks">
            @foreach (var name in _notFound)
            {
              <li>
                <span class="ed-local-font__name">@name</span>
                <label class="ed-btn ed-btn--file">
                  글꼴 파일 고르기
                  <InputFile OnChange="e => OnFontFile(e, name)" accept=".ttf,.otf,.ttc,.otc" disabled="@_busy" />
                </label>
              </li>
            }
          </ul>
          <p class="ed-local-font__hint">윈도우 글꼴은 C:\Windows\Fonts 에 있습니다.</p>
        }
      </div>
      <footer class="ed-modal__foot">
        <button type="button" class="ed-btn" @onclick="Skip" disabled="@_busy">대체 글꼴로 보기</button>
        <button type="button" class="ed-btn ed-btn--primary" data-local-font-grant
                disabled="@_busy"
                onclick="event.stopPropagation(); window.labelUpEditor && labelUpEditor.grantLocalFonts();">
          @(_busy ? "글꼴을 읽는 중…" : _notFound.Count > 0 ? "다시 찾기" : "Chrome에서 허용")
        </button>
      </footer>
    </div>
  </div>
}

@code {
    /// <summary>글꼴 파일 하나가 이보다 크면 받지 않는다. ttc 모음집도 이 안에 든다.</summary>
    private const long MaxFontBytes = 48L * 1024 * 1024;

    private bool _busy;
    private bool _wasOpen;
    private string _error = "";
    private List<string> _notFound = [];
    private DotNetObjectReference<LocalFontDialog>? _self;

    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose()
    {
        Session.Changed -= OnChanged;
        _self?.Dispose();
    }

    private void OnChanged()
    {
        var open = Session.Dialog == EditorDialog.LocalFont;
        if (open && !_wasOpen)
        {
            _notFound = [];
            _error = "";
        }
        _wasOpen = open;
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _self = DotNetObjectReference.Create(this);
        if (Session.Dialog != EditorDialog.LocalFont || _self is null)
            return;
        try
        {
            await Js.InvokeVoidAsync("labelUpEditor.registerLocalFontDialog", _self);
        }
        catch (Exception ex)
        {
            EditorLog.Warn("로컬 글꼴 대화상자 연결 실패: " + ex.Message);
        }
    }

    [JSInvokable]
    public async Task OnLocalFontsGranted(int count)
    {
        if (count <= 0)
        {
            try
            {
                _error = await Js.InvokeAsync<string>("labelUpEditor.localFontLastError");
            }
            catch
            {
                _error = "";
            }
            if (string.IsNullOrWhiteSpace(_error))
                _error = "허용 창이 뜨지 않았습니다. Chrome/Edge · HTTPS(또는 localhost)인지 확인하고, 주소창 왼쪽에서 글꼴을 허용해 주세요.";
            else if (_error.Contains("Permissions", StringComparison.OrdinalIgnoreCase)
                     || _error.Contains("policy", StringComparison.OrdinalIgnoreCase))
                _error = "서버가 로컬 글꼴을 막고 있습니다. 관리자가 Permissions-Policy: local-fonts=* 헤더를 넣어야 합니다.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        await LoadGrantedAsync();
    }

    private async Task LoadGrantedAsync()
    {
        var names = CurrentNames();
        if (names.Count == 0)
        {
            Close("이 PC 글꼴을 적용했습니다");
            return;
        }
        _busy = true;
        _error = "";
        try
        {
            await Fonts.TryChromeLocalFontsAsync(names);
            var still = Fonts.MissingLocalFamilies(names);
            var applied = names.Where(n => !still.Contains(n, StringComparer.OrdinalIgnoreCase)).ToList();
            // 못 찾은 이름을 적어 둬야 이 창이 닫힌 뒤 다시 열리지 않는다.
            Fonts.MarkLocalMissing(still);
            Session.InvalidateRender();
            if (still.Count == 0)
            {
                Close("이 PC 글꼴을 적용했습니다: " + string.Join(", ", applied));
                return;
            }
            _notFound = still.ToList();
            Session.PendingLocalFonts = _notFound.ToList();
            _error = applied.Count > 0
                ? string.Join(", ", applied) + " 적용. 나머지 글꼴은 이 PC에서 찾지 못했습니다."
                : "이 PC에서 해당 글꼴을 찾지 못했습니다.";
        }
        catch (Exception ex)
        {
            EditorLog.Warn("로컬 글꼴 적용 실패: " + ex.Message);
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>고른 글꼴 파일을 그 이름에 묶는다. 이름이 달라도 고른 대로 쓴다.</summary>
    private async Task OnFontFile(InputFileChangeEventArgs e, string family)
    {
        var file = e.File;
        if (file is null || _busy) return;
        _busy = true;
        _error = "";
        try
        {
            if (file.Size > MaxFontBytes)
            {
                _error = "글꼴 파일이 너무 큽니다 (최대 48MB).";
                return;
            }
            using var stream = file.OpenReadStream(MaxFontBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            if (Fonts.AttachPickedFile(file.Name, buffer.ToArray(), family) is { } reason)
            {
                _error = reason;
                return;
            }

            _notFound.Remove(family);
            Session.PendingLocalFonts = _notFound.ToList();
            Session.InvalidateRender();
            if (_notFound.Count == 0)
            {
                Close($"{family} 글꼴 파일을 적용했습니다");
                return;
            }
            _error = $"{family} 적용. 남은 글꼴: {string.Join(", ", _notFound)}";
        }
        catch (Exception ex)
        {
            EditorLog.Warn($"고른 글꼴 파일 적용 실패: {family} · {ex.Message}");
            _error = "글꼴 파일을 읽지 못했습니다. ttf · otf · ttc만 됩니다.";
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Skip()
    {
        if (_busy) return;
        var names = CurrentNames().ToList();
        // 닫고 나서 같은 이름으로 다시 묻지 않는다.
        Fonts.MarkLocalMissing(names);
        Close(names.Count > 0
            ? string.Join(", ", names) + " → 대체 글꼴로 표시합니다"
            : "대체 글꼴로 표시합니다");
    }

    private List<string> CurrentNames()
        => Session.PendingLocalFonts.Count > 0
            ? Session.PendingLocalFonts
            : Fonts.MissingLocalFamilies(
                Session.Document.Pages.SelectMany(p => p.Cells).SelectMany(c => c.Objects).SelectMany(RichTextModel.FamiliesUsed)).ToList();

    private void Close(string status)
    {
        Session.PendingLocalFonts = [];
        Session.Status = status;
        Session.CloseDialog();
        Session.InvalidateRender();
    }
}
