@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@inject TemplateCatalog Themes
@inject HistoryService History
@implements IDisposable

@if (Session.Dialog == EditorDialog.ThemePicker)
{
  <div class="ed-modal" role="dialog" aria-label="템플릿선택" @onclick="Session.CloseDialog">
    <div class="ed-modal__card ed-modal__card--papers" @onclick:stopPropagation="true">
      <header class="ed-modal__head">
        <div>
          <h3>템플릿선택</h3>
          <p>등록된 라벨 디자인 템플릿을 고르면 바로 편집할 수 있습니다.</p>
        </div>
        <button type="button" class="ed-modal__close" @onclick="Session.CloseDialog">×</button>
      </header>

      @if (_preview is not null)
      {
        <div class="ed-theme-hero">
          <div class="ed-theme-hero__stage">
            <div class="ed-theme-hero__label" style="@HeroAspect(_preview)">
              @if (!string.IsNullOrWhiteSpace(_preview.PreviewSvg))
              {
                @((MarkupString)_preview.PreviewSvg)
              }
              else
              {
                <div class="ed-theme-card__fallback" style="--tpl-tone:@_preview.Tone">@_preview.Name</div>
              }
            </div>
          </div>
          <div class="ed-theme-hero__meta">
            <p class="ed-theme-hero__kicker">미리보기</p>
            <h4>@_preview.Name</h4>
            <p>@_preview.DisplayCategory @(string.IsNullOrWhiteSpace(_preview.SizeText) ? "" : " · " + _preview.SizeText)</p>
            @if (!string.IsNullOrWhiteSpace(_preview.Description))
            {
              <p class="ed-theme-hero__desc">@_preview.Description</p>
            }
            <button type="button" class="ed-btn ed-btn--primary" @onclick="() => ApplyAsync(_preview)">이 템플릿으로 편집</button>
          </div>
        </div>
      }

      <div class="ed-paper-toolbar">
        <input class="ed-paper-search" type="search" placeholder="이름, 태그, 용지번호 검색"
               @bind="_query" @bind:event="oninput" />
        <select class="ed-paper-select" @bind="_category">
          <option value="">전체 템플릿</option>
          @foreach (var cat in Themes.Categories)
          {
            <option value="@cat.Key">@cat.Name</option>
          }
        </select>
        <span class="ed-paper-count">@Filtered.Count() / @_source.Count</span>
      </div>

      <div class="ed-modal__body ed-paper-grid ed-theme-grid">
        @if (_loading)
        {
          <p class="ed-paper-empty">템플릿을 불러오는 중…</p>
        }
        else if (!string.IsNullOrWhiteSpace(_error) && !_source.Any())
        {
          <p class="ed-paper-empty">@_error</p>
        }
        else if (!Filtered.Any())
        {
          <p class="ed-paper-empty">검색 결과가 없습니다.</p>
        }
        else
        {
          @foreach (var item in Filtered)
          {
            var active = _preview?.Id == item.Id && string.Equals(_preview?.Slug, item.Slug, StringComparison.OrdinalIgnoreCase);
            <button type="button"
                    class="ed-paper-card ed-theme-card @(active ? "is-active" : null)"
                    @onclick="() => ApplyAsync(item)"
                    @onmouseenter="() => Show(item)"
                    @onfocus="() => Show(item)">
              <div class="ed-theme-card__preview" style="--tpl-tone:@item.Tone">
                @if (!string.IsNullOrWhiteSpace(item.PreviewSvg))
                {
                  @((MarkupString)item.PreviewSvg)
                }
                else
                {
                  <span>@(string.IsNullOrWhiteSpace(item.PreviewText) ? item.Name : item.PreviewText)</span>
                }
              </div>
              <div class="ed-paper-card__meta">
                <strong>@item.Name</strong>
                <span>@item.DisplayCategory @(string.IsNullOrWhiteSpace(item.SizeText) ? "" : " · " + item.SizeText)</span>
              </div>
            </button>
          }
        }
      </div>
    </div>
  </div>
}

@code {
    private string _query = "";
    private string _category = "";
    private bool _loading;
    private bool _tried;
    private string? _error;
    private IReadOnlyList<LabelThemeItem> _source = [];
    private LabelThemeItem? _preview;

    private IEnumerable<LabelThemeItem> Filtered => _source.Where(Matches);

    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Session.Dialog != EditorDialog.ThemePicker)
        {
            _tried = false;
            return;
        }
        if (!_tried && !_loading)
        {
            _tried = true;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            await Themes.EnsureLoadedAsync();
            _source = Themes.Items;
            _preview = _source.FirstOrDefault(item => string.Equals(Session.Document.Name, item.Name, StringComparison.OrdinalIgnoreCase))
                ?? _source.FirstOrDefault();
            if (_source.Count == 0)
                _error = "등록된 템플릿이 없습니다. 관리자 컨텐츠관리 › 템플릿관리에서 시드를 반영해 주세요.";
        }
        catch (Exception ex)
        {
            _error = "템플릿 목록을 불러오지 못했습니다.";
            EditorLog.Warn("템플릿 선택 목록 실패: " + ex.Message);
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private bool Matches(LabelThemeItem item)
    {
        if (!string.IsNullOrWhiteSpace(_category)
            && !string.Equals(item.CategoryKey, _category, StringComparison.OrdinalIgnoreCase)
            && !string.Equals(item.Category, _category, StringComparison.OrdinalIgnoreCase))
            return false;
        if (string.IsNullOrWhiteSpace(_query)) return true;
        var hay = string.Join(' ', item.Name, item.Slug, item.Tags, item.Description, item.PaperNo, item.DisplayCategory);
        return hay.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private void Show(LabelThemeItem item) => _preview = item;

    private static string HeroAspect(LabelThemeItem item)
        => item.WidthMm > 0 && item.HeightMm > 0
            ? $"--theme-ar:{item.WidthMm.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}/{item.HeightMm.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}"
            : "--theme-ar:7/4";

    private async Task ApplyAsync(LabelThemeItem item)
    {
        try
        {
            var key = item.Id > 0 ? item.Id.ToString() : item.Slug;
            var doc = await Themes.LoadDocumentAsync(key);
            if (doc is null)
            {
                Session.Status = "템플릿 문서를 불러오지 못했습니다";
                return;
            }
            History.Push(Session.Document);
            Session.ReplaceDocument(doc);
            Session.Status = $"「{doc.Name}」 템플릿으로 편집합니다";
            Session.CloseDialog();
        }
        catch (Exception ex)
        {
            Session.Status = "템플릿 적용에 실패했습니다";
            EditorLog.Warn("템플릿 적용 실패: " + ex.Message);
        }
    }

    private static string ShapeLabel(string? shape) => (shape ?? "").ToLowerInvariant() switch
    {
        "ellipse" => "원형",
        "roundrect" => "라운드",
        _ => "사각형"
    };
}
