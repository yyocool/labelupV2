@using System.Text.Json
@using System.Text.Json.Serialization
@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@inject IJSRuntime Js
@implements IDisposable

@if (Session.Dialog == EditorDialog.LabelShop)
{
  <div class="ed-modal ed-shop-modal" role="dialog" aria-label="라벨쇼핑" @onclick="Session.CloseDialog">
    <div class="ed-modal__card ed-modal__card--shop" @onclick:stopPropagation="true">
      <header class="ed-modal__head">
        <div>
          <h3>라벨쇼핑</h3>
          <p>편집하면서 필요한 라벨지를 바로 담고 주문할 수 있어요.</p>
        </div>
        <div class="ed-shop-head-actions">
          <button type="button" class="ed-btn ed-shop-cart-btn" @onclick="OpenCart">
            장바구니
            @if (_cartCount > 0)
            {
              <em>@_cartCount</em>
            }
          </button>
          <button type="button" class="ed-modal__close" @onclick="Session.CloseDialog">×</button>
        </div>
      </header>

      <div class="ed-shop-toolbar">
        <input class="ed-paper-search" type="search" placeholder="상품명, 규격, SKU 검색"
               @bind="_query" @bind:event="oninput" @onkeydown="OnSearchKey" />
        <button type="button" class="ed-btn" @onclick="() => LoadCatalogAsync(1)">검색</button>
        <select class="ed-paper-select" @bind="_category" @bind:after="() => LoadCatalogAsync(1)">
          <option value="">전체 카테고리</option>
          @foreach (var cat in _categories)
          {
            <option value="@cat.Slug">@cat.Name</option>
          }
        </select>
        <span class="ed-paper-count">@_total 개</span>
      </div>

      <div class="ed-modal__body ed-shop-body">
        @if (!string.IsNullOrWhiteSpace(_error))
        {
          <p class="ed-shop-flash ed-shop-flash--err">@_error</p>
        }
        else if (!string.IsNullOrWhiteSpace(_flash))
        {
          <p class="ed-shop-flash">@_flash</p>
        }

        @if (_view == ShopView.Catalog)
        {
          if (_loading)
          {
            <p class="ed-paper-empty">상품을 불러오는 중…</p>
          }
          else if (_products.Count == 0)
          {
            <p class="ed-paper-empty">조건에 맞는 상품이 없습니다.</p>
          }
          else
          {
            <div class="ed-shop-grid">
              @foreach (var p in _products)
              {
                <article class="ed-shop-card">
                  <button type="button" class="ed-shop-card__media" @onclick="() => OpenDetailAsync(p.Id)">
                    <img src="@p.Thumbnail" alt="@p.Name" />
                    @if (p.Soldout)
                    {
                      <span class="ed-shop-badge">품절</span>
                    }
                    else if (p.OnSale)
                    {
                      <span class="ed-shop-badge ed-shop-badge--sale">SALE</span>
                    }
                  </button>
                  <div class="ed-shop-card__meta">
                    <small>@p.Category</small>
                    <strong>@p.Name</strong>
                    <span>@(string.IsNullOrWhiteSpace(p.Spec) ? p.Sku : p.Spec)</span>
                    <div class="ed-shop-price">
                      @if (p.OnSale)
                      {
                        <del>@p.ListPriceLabel</del>
                      }
                      <em>@p.PriceLabel</em>
                    </div>
                    <div class="ed-shop-card__actions">
                      <button type="button" class="ed-btn" @onclick="() => OpenDetailAsync(p.Id)">자세히</button>
                      @if (!p.Soldout)
                      {
                        <button type="button" class="ed-btn ed-btn--primary" @onclick="() => AddCartAsync(p.Id, 1)">담기</button>
                      }
                    </div>
                  </div>
                </article>
              }
            </div>
            @if (_pages > 1)
            {
              <nav class="ed-shop-pages" aria-label="상품 페이지">
                @for (var i = 1; i <= _pages; i++)
                {
                  var n = i;
                  <button type="button" class="@(_page == n ? "is-active" : null)" @onclick="() => LoadCatalogAsync(n)">@n</button>
                }
              </nav>
            }
          }
        }
        else if (_view == ShopView.Detail && _detail is not null)
        {
          <article class="ed-shop-detail">
            <button type="button" class="ed-shop-back" @onclick="BackToCatalog">← 목록</button>
            <div class="ed-shop-detail__grid">
              <div class="ed-shop-detail__media">
                <img src="@_detail.Thumbnail" alt="@_detail.Name" />
              </div>
              <div class="ed-shop-detail__info">
                <small>@_detail.Category</small>
                <h4>@_detail.Name</h4>
                <p class="ed-shop-sku">SKU · @_detail.Sku</p>
                @if (!string.IsNullOrWhiteSpace(_detail.Spec))
                {
                  <p class="ed-shop-spec">@_detail.Spec</p>
                }
                <div class="ed-shop-price ed-shop-price--lg">
                  @if (_detail.OnSale)
                  {
                    <del>@_detail.ListPriceLabel</del>
                  }
                  <em>@_detail.PriceLabel</em>
                </div>
                <p class="ed-shop-stock">@(_detail.Soldout ? "품절" : $"재고 {_detail.StockQty:N0}개")</p>
                @if (!string.IsNullOrWhiteSpace(_detail.Description))
                {
                  <p class="ed-shop-desc">@_detail.Description</p>
                }
                @if (!_detail.Soldout)
                {
                  <div class="ed-shop-buy">
                    <div class="ed-shop-qty">
                      <button type="button" @onclick="() => _qty = Math.Max(1, _qty - 1)">−</button>
                      <input type="number" min="1" max="@Math.Max(1, _detail.StockQty)" @bind="_qty" />
                      <button type="button" @onclick="() => _qty = Math.Min(Math.Max(1, _detail.StockQty), _qty + 1)">+</button>
                    </div>
                    <button type="button" class="ed-btn" @onclick="() => AddCartAsync(_detail.Id, _qty)">장바구니</button>
                    <button type="button" class="ed-btn ed-btn--primary" @onclick="() => BuyNowAsync(_detail.Id, _qty)">바로 주문</button>
                  </div>
                }
              </div>
            </div>
          </article>
        }
        else if (_view == ShopView.Cart)
        {
          <div class="ed-shop-cart">
            <button type="button" class="ed-shop-back" @onclick="BackToCatalog">← 쇼핑 계속</button>
            @if (_cart.Items.Count == 0)
            {
              <p class="ed-paper-empty">장바구니가 비어 있습니다.</p>
            }
            else
            {
              <div class="ed-shop-cart-list">
                @foreach (var item in _cart.Items)
                {
                  <article class="ed-shop-cart-item">
                    <img src="@item.Thumbnail" alt="" />
                    <div>
                      <strong>@item.Name</strong>
                      <span>@item.PriceLabel</span>
                    </div>
                    <div class="ed-shop-qty">
                      <button type="button" @onclick="() => UpdateQtyAsync(item.Id, item.Qty - 1)">−</button>
                      <input type="number" value="@item.Qty" readonly />
                      <button type="button" @onclick="() => UpdateQtyAsync(item.Id, item.Qty + 1)">+</button>
                    </div>
                    <em>@item.LineTotalLabel</em>
                    <button type="button" class="ed-shop-remove" @onclick="() => RemoveCartAsync(item.Id)">삭제</button>
                  </article>
                }
              </div>
              <aside class="ed-shop-summary">
                <dl>
                  <div><dt>상품 금액</dt><dd>@_cart.SubtotalLabel</dd></div>
                  <div><dt>배송비</dt><dd>@_cart.ShippingLabel</dd></div>
                  <div class="ed-shop-summary__total"><dt>결제 예정</dt><dd>@_cart.TotalLabel</dd></div>
                </dl>
                <p>5만원 이상 구매 시 배송비 무료</p>
                <button type="button" class="ed-btn ed-btn--primary ed-shop-block" @onclick="OpenCheckout">주문하기</button>
              </aside>
            }
          </div>
        }
        else if (_view == ShopView.Checkout)
        {
          <form class="ed-shop-checkout" @onsubmit="PlaceOrderAsync" @onsubmit:preventDefault="true">
            <button type="button" class="ed-shop-back" @onclick="OpenCart">← 장바구니</button>
            <div class="ed-shop-checkout__grid">
              <div class="ed-shop-fields">
                <label>이름<input @bind="_form.Name" required maxlength="80" /></label>
                <label>이메일<input type="email" @bind="_form.Email" required maxlength="190" /></label>
                <label>연락처<input @bind="_form.Phone" required maxlength="30" placeholder="010-0000-0000" /></label>
                <label>배송지<textarea @bind="_form.Address" required rows="3" maxlength="500" placeholder="주소와 상세주소를 입력하세요"></textarea></label>
                <label>배송 메모<textarea @bind="_form.Memo" rows="2" maxlength="255" placeholder="문 앞, 경비실 등"></textarea></label>
              </div>
              <aside class="ed-shop-summary">
                <h4>주문 요약</h4>
                <ul>
                  @foreach (var item in _cart.Items)
                  {
                    <li>@item.Name × @item.Qty</li>
                  }
                </ul>
                <dl>
                  <div><dt>상품 금액</dt><dd>@_cart.SubtotalLabel</dd></div>
                  <div><dt>배송비</dt><dd>@_cart.ShippingLabel</dd></div>
                  <div class="ed-shop-summary__total"><dt>결제 금액</dt><dd>@_cart.TotalLabel</dd></div>
                </dl>
                <button type="submit" class="ed-btn ed-btn--primary ed-shop-block" disabled="@_busy">
                  @(_busy ? "주문 처리 중…" : "주문 접수")
                </button>
                <p class="ed-shop-note">주문 접수 후 담당자가 결제를 확인합니다.</p>
              </aside>
            </div>
          </form>
        }
        else if (_view == ShopView.Done && _order is not null)
        {
          <div class="ed-shop-done">
            <strong>주문이 접수되었습니다</strong>
            <p>주문번호 <b>@_order.OrderNo</b></p>
            <p>결제 예정 금액 <em>@_order.TotalLabel</em></p>
            <p>마이페이지에서 주문 상태를 확인할 수 있어요.</p>
            <div class="ed-shop-done__actions">
              <button type="button" class="ed-btn" @onclick="BackToCatalog">쇼핑 계속</button>
              <a class="ed-btn ed-btn--primary" href="/account">내 주문 보기</a>
            </div>
          </div>
        }
      </div>
    </div>
  </div>
}

@code {
    private enum ShopView { Catalog, Detail, Cart, Checkout, Done }

    private static readonly JsonSerializerOptions JsonOpts = new()
    {
        PropertyNameCaseInsensitive = true,
        PropertyNamingPolicy = new SnakeLowerPolicy()
    };

    /// <summary>
    /// WASM 런타임의 System.Text.Json에 JsonNamingPolicy.SnakeCaseLower가
    /// 없어 타입 초기화가 실패하던 문제를 피하기 위한 로컬 구현.
    /// </summary>
    private sealed class SnakeLowerPolicy : JsonNamingPolicy
    {
        public override string ConvertName(string name)
        {
            if (string.IsNullOrEmpty(name)) return name;
            var chars = new char[name.Length + 8];
            var n = 0;
            for (var i = 0; i < name.Length; i++)
            {
                var c = name[i];
                if (char.IsUpper(c))
                {
                    if (i > 0) chars[n++] = '_';
                    chars[n++] = char.ToLowerInvariant(c);
                }
                else
                {
                    chars[n++] = c;
                }
            }
            return new string(chars, 0, n);
        }
    }

    private ShopView _view = ShopView.Catalog;
    private bool _opened;
    private bool _loading;
    private bool _busy;
    private string _query = "";
    private string _category = "";
    private string _error = "";
    private string _flash = "";
    private int _page = 1;
    private int _pages = 1;
    private int _total;
    private int _qty = 1;
    private int _cartCount;
    private ShopProductDto? _detail;
    private ShopOrderDto? _order;
    private ShopCartDto _cart = new();
    private ShopCheckoutForm _form = new();
    private List<ShopProductDto> _products = [];
    private List<ShopCategoryDto> _categories = [];

    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Session.Dialog != EditorDialog.LabelShop)
        {
            _opened = false;
            return;
        }
        if (_opened) return;
        _opened = true;
        _error = "";
        _flash = "";
        var buyNow = Session.PendingShopBuyNow;
        var paperNo = Session.PendingShopPaperNo;
        var knownId = Session.CurrentShopProductId;
        Session.ClearPendingShopBuyNow();
        if (buyNow)
        {
            await StartBuyNowAsync(knownId, paperNo);
            return;
        }
        _view = ShopView.Catalog;
        await LoadCatalogAsync(1);
        await LoadCartAsync();
    }

    private async Task StartBuyNowAsync(int? knownId, string? paperNo)
    {
        await LoadCartAsync();
        var productId = knownId is > 0 ? knownId : null;
        if (productId is null && !string.IsNullOrWhiteSpace(paperNo))
        {
            try
            {
                var json = await Js.InvokeAsync<string>("labelUpEditor.apiGetJson", "/api/shop/lookup?code=" + Uri.EscapeDataString(paperNo.Trim()));
                var found = JsonSerializer.Deserialize<ShopProductDto>(json, JsonOpts);
                if (found is { Id: > 0 })
                {
                    productId = found.Id;
                    Session.CurrentShopProductId = found.Id;
                }
            }
            catch (Exception ex)
            {
                _error = "";
                _flash = string.IsNullOrWhiteSpace(ex.Message)
                    ? "현재 용지에 맞는 상품을 찾지 못했습니다. 목록에서 선택해 주세요."
                    : ex.Message;
            }
        }

        if (productId is > 0)
        {
            await BuyNowAsync(productId.Value, 1);
            if (_view is ShopView.Checkout or ShopView.Done)
                return;
            if (_cart.Items.Count > 0 && string.IsNullOrWhiteSpace(_error))
            {
                _view = ShopView.Cart;
                return;
            }
        }

        _query = paperNo ?? "";
        if (string.IsNullOrWhiteSpace(_flash) && string.IsNullOrWhiteSpace(_error))
            _flash = "현재 용지에 맞는 상품을 찾지 못했습니다. 목록에서 선택해 주세요.";
        await LoadCatalogAsync(1);
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadCatalogAsync(1);
    }

    private void BackToCatalog()
    {
        _view = ShopView.Catalog;
        _detail = null;
        _error = "";
    }

    private async Task LoadCatalogAsync(int page)
    {
        _loading = true;
        _error = "";
        _page = page;
        _view = ShopView.Catalog;
        try
        {
            var qs = $"q={Uri.EscapeDataString(_query.Trim())}&category={Uri.EscapeDataString(_category)}&page={page}";
            var json = await Js.InvokeAsync<string>("labelUpEditor.apiGetJson", "/api/shop/catalog?" + qs);
            var data = JsonSerializer.Deserialize<ShopCatalogDto>(json, JsonOpts) ?? new();
            _products = data.Items;
            _categories = data.Categories.Count > 0 ? data.Categories : _categories;
            _total = data.Total;
            _page = data.Page;
            _pages = Math.Max(1, data.Pages);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OpenDetailAsync(int id)
    {
        _error = "";
        try
        {
            var json = await Js.InvokeAsync<string>("labelUpEditor.apiGetJson", $"/api/shop/products/{id}");
            _detail = JsonSerializer.Deserialize<ShopProductDto>(json, JsonOpts);
            _qty = 1;
            _view = ShopView.Detail;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task LoadCartAsync()
    {
        try
        {
            var json = await Js.InvokeAsync<string>("labelUpEditor.apiGetJson", "/api/shop/cart");
            _cart = JsonSerializer.Deserialize<ShopCartDto>(json, JsonOpts) ?? new();
            _cartCount = _cart.Count;
        }
        catch
        {
            _cart = new();
        }
    }

    private async Task OpenCart()
    {
        _error = "";
        await LoadCartAsync();
        _view = ShopView.Cart;
    }

    private async Task AddCartAsync(int id, int qty)
    {
        _error = "";
        try
        {
            var raw = await Js.InvokeAsync<string>("labelUpEditor.apiPostJson", "/api/shop/cart/add", new { product_id = id, qty });
            ApplyCartPayload(raw);
            _flash = "장바구니에 담았습니다.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task BuyNowAsync(int id, int qty)
    {
        await AddCartAsync(id, qty);
        if (string.IsNullOrWhiteSpace(_error))
            await OpenCheckout();
    }

    private async Task UpdateQtyAsync(int id, int qty)
    {
        try
        {
            var raw = await Js.InvokeAsync<string>("labelUpEditor.apiPostJson", "/api/shop/cart/update", new { product_id = id, qty });
            ApplyCartPayload(raw);
            if (_cart.Items.Count == 0)
                _view = ShopView.Cart;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task RemoveCartAsync(int id)
    {
        try
        {
            var raw = await Js.InvokeAsync<string>("labelUpEditor.apiPostJson", "/api/shop/cart/remove", new { product_id = id });
            ApplyCartPayload(raw);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OpenCheckout()
    {
        await LoadCartAsync();
        if (_cart.Items.Count == 0)
        {
            _error = "장바구니가 비어 있습니다.";
            _view = ShopView.Cart;
            return;
        }
        if (!await EnsureLoginAsync())
            return;
        await PrefillUserAsync();
        _view = ShopView.Checkout;
    }

    private async Task PlaceOrderAsync()
    {
        if (_busy) return;
        if (!await EnsureLoginAsync())
            return;
        _busy = true;
        _error = "";
        try
        {
            var raw = await Js.InvokeAsync<string>("labelUpEditor.apiPostJson", "/api/shop/checkout", new
            {
                customer_name = _form.Name,
                customer_email = _form.Email,
                customer_phone = _form.Phone,
                shipping_address = _form.Address,
                shipping_memo = _form.Memo
            });
            using var doc = JsonDocument.Parse(raw);
            var data = doc.RootElement.TryGetProperty("data", out var d) ? d.GetRawText() : raw;
            _order = JsonSerializer.Deserialize<ShopOrderDto>(data, JsonOpts);
            _cart = new();
            _cartCount = 0;
            _view = ShopView.Done;
            _flash = "";
        }
        catch (JSException ex) when (ex.Message.Contains("로그인"))
        {
            await EnsureLoginAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<bool> EnsureLoginAsync()
    {
        try
        {
            var user = await Js.InvokeAsync<JsonElement>("labelUpEditor.getAuthUser");
            if (user.ValueKind == JsonValueKind.Object)
                return true;
            return await Js.InvokeAsync<bool>("labelUpEditor.showSaveAuthPrompt");
        }
        catch
        {
            return false;
        }
    }

    private async Task PrefillUserAsync()
    {
        try
        {
            var user = await Js.InvokeAsync<JsonElement>("labelUpEditor.getAuthUser");
            if (user.ValueKind != JsonValueKind.Object)
                return;
            var el = user;
            if (string.IsNullOrWhiteSpace(_form.Name))
                _form.Name = ReadUser(el, "name");
            if (string.IsNullOrWhiteSpace(_form.Email))
                _form.Email = ReadUser(el, "email");
            if (string.IsNullOrWhiteSpace(_form.Phone))
                _form.Phone = ReadUser(el, "phone");
        }
        catch { }
    }

    private static string ReadUser(JsonElement el, string key)
        => el.TryGetProperty(key, out var p) && p.ValueKind == JsonValueKind.String ? (p.GetString() ?? "") : "";

    private void ApplyCartPayload(string raw)
    {
        using var doc = JsonDocument.Parse(string.IsNullOrWhiteSpace(raw) ? "{}" : raw);
        var root = doc.RootElement;
        var data = root.TryGetProperty("data", out var d) ? d.GetRawText() : raw;
        _cart = JsonSerializer.Deserialize<ShopCartDto>(data, JsonOpts) ?? new();
        _cartCount = _cart.Count;
        if (root.TryGetProperty("message", out var m) && m.ValueKind == JsonValueKind.String)
            _flash = m.GetString() ?? _flash;
    }

    private sealed class ShopCatalogDto
    {
        public List<ShopProductDto> Items { get; set; } = [];
        public List<ShopCategoryDto> Categories { get; set; } = [];
        public int Total { get; set; }
        public int Page { get; set; } = 1;
        public int Pages { get; set; } = 1;
    }

    private sealed class ShopCategoryDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Slug { get; set; } = "";
    }

    private sealed class ShopProductDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Sku { get; set; } = "";
        public string Category { get; set; } = "";
        public string Spec { get; set; } = "";
        public string Thumbnail { get; set; } = "";
        public string Description { get; set; } = "";
        public string PriceLabel { get; set; } = "";
        public string ListPriceLabel { get; set; } = "";
        [JsonPropertyName("line_total_label")]
        public string LineTotalLabel { get; set; } = "";
        public bool OnSale { get; set; }
        public bool Soldout { get; set; }
        public int StockQty { get; set; }
        public int Qty { get; set; } = 1;
    }

    private sealed class ShopCartDto
    {
        public List<ShopProductDto> Items { get; set; } = [];
        public int Count { get; set; }
        public string SubtotalLabel { get; set; } = "0원";
        public string ShippingLabel { get; set; } = "무료";
        public string TotalLabel { get; set; } = "0원";
    }

    private sealed class ShopOrderDto
    {
        public string OrderNo { get; set; } = "";
        public string TotalLabel { get; set; } = "";
    }

    private sealed class ShopCheckoutForm
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Address { get; set; } = "";
        public string Memo { get; set; } = "";
    }
}
