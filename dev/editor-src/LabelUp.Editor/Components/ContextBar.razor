    private void Touch()
    {
        Session.Dirty = true;
        Session.Notify();
    }

    private void ApplySelected(Action<DesignObject> apply)
    {
        foreach (var obj in Session.SelectedObjects)
            apply(obj);
    }

    private void BeginStyleHistory()
    {
        if (_styleHistoryPushed) return;
        History.Push(Session.Document);
        _styleHistoryPushed = true;
    }

    private async Task LiveFill(ChangeEventArgs e)
    {
        var v = ColorUtil.ToHtmlColor(e.Value?.ToString(), "");
        if (v.Length != 7) return;
        if (Session.Selected is { } o && RichTextModel.UsesRich(o) && await HasRichSelection())
        {
            await ApplyRichCommand("color", v);
            return;
        }
        BeginStyleHistory();
        ApplySelected(obj =>
        {
            obj.Fill = v;
            if (RichTextModel.UsesRich(obj))
                RichTextModel.ApplyAllSpans(obj, s => s.Fill = v);
        });
        Touch();
    }

    private async Task CommitFill(ChangeEventArgs e)
    {
        await LiveFill(e);
        _styleHistoryPushed = false;
    }

    private void LiveStroke(ChangeEventArgs e)
    {
        var v = ColorUtil.ToHtmlColor(e.Value?.ToString(), "");
        if (v.Length != 7) return;
        BeginStyleHistory();
        ApplySelected(obj => obj.Stroke = v);
        Touch();
    }

    private void CommitStroke(ChangeEventArgs e)
    {
        LiveStroke(e);
        _styleHistoryPushed = false;
    }

    private void LiveGradientEnd(ChangeEventArgs e)
    {
        var v = ColorUtil.ToHtmlColor(e.Value?.ToString(), "");
        if (v.Length != 7) return;
        BeginStyleHistory();
        ApplySelected(obj => obj.GradientEnd = v);
        Touch();
    }

    private void CommitGradientEnd(ChangeEventArgs e)
