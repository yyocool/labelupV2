    private async Task SetFontSizePt(DesignObject o, ChangeEventArgs e)
    {
        if (BindGuarded) return;
        if (!float.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var pt)
            && !float.TryParse(e.Value?.ToString(), out pt))
            return;
        pt = Math.Clamp(pt, 4f, 200f);
        if (RichTextModel.UsesRich(o) && await HasRichSelection())
        {
            await ApplyRichCommand("size", pt.ToString(System.Globalization.CultureInfo.InvariantCulture));
            return;
        }
        History.Push(Session.Document);
        o.FontSize = FontCatalog.FromPt(pt);
        if (RichTextModel.UsesRich(o))
            RichTextModel.ApplyAllSpans(o, s => s.FontSize = o.FontSize);
        Touch();
    }

    private string FontSelectValue(DesignObject o)
    {
        var raw = (DisplayFamily(o) ?? "").Trim();
        return raw.Length == 0 ? "Pretendard" : FontCatalog.CanonicalId(raw);
    }

    private string DisplayFamily(DesignObject o)
        => string.IsNullOrWhiteSpace(_caret?.FontFamily) ? o.FontFamily : _caret.FontFamily;

    private float DisplayFontSizePt(DesignObject o)
        => _caret is { FontSizePt: > 0 } ? _caret.FontSizePt : FontCatalog.ToPt(o.FontSize);

    private bool DisplayBold(DesignObject o) => _caret?.Bold ?? o.Bold;
    private bool DisplayItalic(DesignObject o) => _caret?.Italic ?? o.Italic;
    private bool DisplayUnderline(DesignObject o) => _caret?.Underline ?? o.Underline;
    private string DisplayAlign(DesignObject o)
        => string.IsNullOrWhiteSpace(_caret?.Align) ? o.TextAlign : _caret.Align;
    private string DisplayFill(DesignObject o)
        => string.IsNullOrWhiteSpace(_caret?.Fill) ? o.Fill : _caret.Fill;

    private async Task OnFontFamily(ChangeEventArgs e)
    {
        if (BindGuarded || Session.Selected is null) return;
        try
        {
            var id = e.Value?.ToString() ?? "Pretendard";
            var o = Session.Selected;
            if (string.Equals(DisplayFamily(o), id, StringComparison.OrdinalIgnoreCase)
                && !await HasRichSelection())
                return;
            if (RichTextModel.UsesRich(o) && await HasRichSelection())
            {
                Session.Status = "글꼴을 불러오는 중…";
                await Fonts.EnsureFamilyAsync(id);
                await ApplyRichCommand("font", id);
                Session.Status = Fonts.IsFamilyReady(id)
                    ? "글꼴 적용됨"
                    : "글꼴을 불러오지 못해 기본 글꼴로 표시합니다.";
                Session.Notify();
                return;
            }
            History.Push(Session.Document);
            o.FontFamily = id;
            if (RichTextModel.UsesRich(o))
                RichTextModel.ApplyAllSpans(o, s => s.FontFamily = id);
            Session.Status = "글꼴을 불러오는 중…";
            Touch();
            await Fonts.EnsureFamilyAsync(id);
            Session.Status = Fonts.IsFamilyReady(id)
                ? "글꼴 적용됨"
                : "글꼴을 불러오지 못해 기본 글꼴로 표시합니다.";
            Session.Notify();
        }
        catch (Exception ex)
        {
            EditorLog.Error("글꼴 변경 실패", ex);
            Session.Status = "글꼴 오류: " + ex.Message;
            Session.Notify();
        }
    }

    private void OnTextMode(ChangeEventArgs e)
    {
        if (BindGuarded || Session.Selected is null) return;
        History.Push(Session.Document);
        if (Enum.TryParse<TextMode>(e.Value?.ToString(), true, out var mode))
        {
            if (mode == TextMode.Extended)
                mode = TextMode.Normal;
            Session.Selected.TextMode = mode;
            if (TextModes.IsPlain(mode))
                RichTextModel.Ensure(Session.Selected);
            if (mode == TextMode.Custom)
            {
                if (Session.Selected.CustomKind is "none" or "")
                {
                    Session.Selected.CustomKind = "date";
                    Session.Selected.CustomFormat = "2";
                }
                CustomTextFormats.ApplyToken(Session.Selected);
            }
        }
        Touch();
    }

