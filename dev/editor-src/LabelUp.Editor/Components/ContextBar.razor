    private async Task SetAlign(string align)
    {
        if (BindGuarded || Session.Selected is null) return;
        var o = Session.Selected;
        if (RichTextModel.UsesRich(o) && await HasRichSelection())
        {
            await ApplyRichCommand("align", align);
            return;
        }
        History.Push(Session.Document);
        if (RichTextModel.UsesRich(o))
            RichTextModel.ApplyAlign(o, align);
        else
            o.TextAlign = align;
        Touch();
    }

    private static bool IsVertical(DesignObject o)
        => string.Equals(o.TextDirection, "vertical", StringComparison.OrdinalIgnoreCase);

    private void ToggleVertical(DesignObject o)
        => Toggle(v => o.TextDirection = v ? "vertical" : "horizontal", IsVertical(o));

    private static bool IsKoreanPost(DesignObject o)
        => string.Equals(o.BarcodeFormat, "KOREAN_POST", StringComparison.OrdinalIgnoreCase);

    private static string BarcodeFieldValue(DesignObject o)
        => IsKoreanPost(o) ? FormtecRecords.ToPostalDisplayValue(o.BarcodeValue ?? "") : (o.BarcodeValue ?? "");

    private static string BarcodeFieldStore(DesignObject o, string value)
        => IsKoreanPost(o) ? FormtecRecords.ToPostalDisplayValue(value) : value;

