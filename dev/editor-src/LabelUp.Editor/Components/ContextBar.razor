        _styleHistoryPushed = false;
    }

    private void LiveShadowFill(ChangeEventArgs e)
    {
        var v = ColorUtil.ToHtmlColor(e.Value?.ToString(), "");
        if (v.Length != 7) return;
        BeginStyleHistory();
        ApplySelected(obj => obj.ShadowFill = v);
        Touch();
    }

    private void CommitShadowFill(ChangeEventArgs e)
