    private async Task ApplyRichCommand(string cmd, string value)
    {
        if (!_richHistory)
        {
            History.Push(Session.Document);
            _richHistory = true;
        }
        try { await Js.InvokeVoidAsync("labelUpEditor.richText.apply", _richRef, cmd, value); }
        catch (Exception ex) { EditorLog.Error("일반텍스트 서식 적용 실패", ex); }
    }

    private async Task ToggleRich(DesignObject o, string cmd)
    {
        if (BindGuarded) return;
        if (RichTextModel.UsesRich(o) && await HasRichSelection())
        {
            await ApplyRichCommand(cmd, "");
            return;
        }
        History.Push(Session.Document);
        if (RichTextModel.UsesRich(o))
        {
            switch (cmd)
            {
                case "bold":
                    var bold = !DisplayBold(o);
                    RichTextModel.ApplyAllSpans(o, s => s.Bold = bold);
                    break;
                case "italic":
                    var italic = !DisplayItalic(o);
                    RichTextModel.ApplyAllSpans(o, s => s.Italic = italic);
                    break;
                case "underline":
                    var under = !DisplayUnderline(o);
                    RichTextModel.ApplyAllSpans(o, s => s.Underline = under);
                    break;
            }
        }
        else
        {
            switch (cmd)
            {
                case "bold": o.Bold = !o.Bold; break;
                case "italic": o.Italic = !o.Italic; break;
                case "underline": o.Underline = !o.Underline; break;
            }
        }
        Touch();
    }

    [JSInvokable]
