    private async Task SetFontSizePt(DesignObject o, ChangeEventArgs e)
    {
        if (BindGuarded) return;
        if (!float.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var pt)
            && !float.TryParse(e.Value?.ToString(), out pt))
            return;
        pt = Math.Clamp(pt, 4f, 200f);
        if (RichTextModel.UsesRich(o) && await HasRichSelection())
        {
            await ApplyRichCommand("size", pt.ToString(System.Globalization.CultureInfo.InvariantCulture));
            return;
        }
        History.Push(Session.Document);
        o.FontSize = FontCatalog.FromPt(pt);
        if (RichTextModel.UsesRich(o))
            RichTextModel.ApplyAllSpans(o, s => s.FontSize = o.FontSize);
        Touch();
    }

    private string FontSelectValue(DesignObject o)
    {
        var raw = (DisplayFamily(o) ?? "").Trim();
        return raw.Length == 0 ? "Pretendard" : FontCatalog.CanonicalId(raw);
    }

    private string DisplayFamily(DesignObject o)
        => string.IsNullOrWhiteSpace(_caret?.FontFamily) ? o.FontFamily : _caret.FontFamily;

    private float DisplayFontSizePt(DesignObject o)
        => _caret is { FontSizePt: > 0 } ? _caret.FontSizePt : FontCatalog.ToPt(o.FontSize);

    private bool DisplayBold(DesignObject o) => _caret?.Bold ?? o.Bold;
    private bool DisplayItalic(DesignObject o) => _caret?.Italic ?? o.Italic;
    private bool DisplayUnderline(DesignObject o) => _caret?.Underline ?? o.Underline;
    private string DisplayAlign(DesignObject o)
        => string.IsNullOrWhiteSpace(_caret?.Align) ? o.TextAlign : _caret.Align;
    private string DisplayFill(DesignObject o)
        => string.IsNullOrWhiteSpace(_caret?.Fill) ? o.Fill : _caret.Fill;

    private async Task OnFontFamily(ChangeEventArgs e)
    {
        if (BindGuarded || Session.Selected is null) return;
        try
        {
            var id = e.Value?.ToString() ?? "Pretendard";
            var o = Session.Selected;
            if (string.Equals(DisplayFamily(o), id, StringComparison.OrdinalIgnoreCase)
                && !await HasRichSelection())
                return;
            if (RichTextModel.UsesRich(o) && await HasRichSelection())
            {
                Session.Status = "글꼴을 불러오는 중…";
                await Fonts.EnsureFamilyAsync(id);
                await ApplyRichCommand("font", id);
                Session.Status = Fonts.IsFamilyReady(id)
                    ? "글꼴 적용됨"
                    : "글꼴을 불러오지 못해 기본 글꼴로 표시합니다.";
                Session.Notify();
                return;
            }
            History.Push(Session.Document);
            o.FontFamily = id;
            if (RichTextModel.UsesRich(o))
                RichTextModel.ApplyAllSpans(o, s => s.FontFamily = id);
            Session.Status = "글꼴을 불러오는 중…";
            Touch();
            await Fonts.EnsureFamilyAsync(id);
            Session.Status = Fonts.IsFamilyReady(id)
                ? "글꼴 적용됨"
                : "글꼴을 불러오지 못해 기본 글꼴로 표시합니다.";
            Session.Notify();
        }
        catch (Exception ex)
        {
            EditorLog.Error("글꼴 변경 실패", ex);
            Session.Status = "글꼴 오류: " + ex.Message;
            Session.Notify();
        }
    }

    private void OnTextMode(ChangeEventArgs e)
    {
        if (BindGuarded || Session.Selected is null) return;
        History.Push(Session.Document);
        if (Enum.TryParse<TextMode>(e.Value?.ToString(), true, out var mode))
        {
            if (mode == TextMode.Extended)
                mode = TextMode.Normal;
            Session.Selected.TextMode = mode;
            if (TextModes.IsPlain(mode))
                RichTextModel.Ensure(Session.Selected);
            if (mode == TextMode.Custom)
            {
                if (Session.Selected.CustomKind is "none" or "")
                {
                    Session.Selected.CustomKind = "date";
                    Session.Selected.CustomFormat = "2";
                }
                CustomTextFormats.ApplyToken(Session.Selected);
            }
        }
        Touch();
    }

    private async Task SaveRichSel()
    {
        if (Session.Selected is not { } o || !RichTextModel.UsesRich(o)) return;
        try { await Js.InvokeVoidAsync("labelUpEditor.richText.saveSel", _richRef); }
        catch { /* ignore */ }
    }

    private async Task<bool> HasRichSelection()
    {
        if (Session.Selected is not { } o || !RichTextModel.UsesRich(o)) return false;
        try { return await Js.InvokeAsync<bool>("labelUpEditor.richText.hasSelection", _richRef); }
        catch { return false; }
    }

    private async Task ApplyRichCommand(string cmd, string value)
    {
        if (!_richHistory)
        {
            History.Push(Session.Document);
            _richHistory = true;
        }
        try { await Js.InvokeVoidAsync("labelUpEditor.richText.apply", _richRef, cmd, value); }
        catch (Exception ex) { EditorLog.Error("일반텍스트 서식 적용 실패", ex); }
    }

    private async Task ToggleRich(DesignObject o, string cmd)
    {
        if (BindGuarded) return;
        if (RichTextModel.UsesRich(o) && await HasRichSelection())
        {
            await ApplyRichCommand(cmd, "");
            return;
        }
        History.Push(Session.Document);
        if (RichTextModel.UsesRich(o))
        {
            switch (cmd)
            {
                case "bold":
                    var bold = !DisplayBold(o);
                    RichTextModel.ApplyAllSpans(o, s => s.Bold = bold);
                    break;
                case "italic":
                    var italic = !DisplayItalic(o);
                    RichTextModel.ApplyAllSpans(o, s => s.Italic = italic);
                    break;
                case "underline":
                    var under = !DisplayUnderline(o);
                    RichTextModel.ApplyAllSpans(o, s => s.Underline = under);
                    break;
            }
        }
        else
        {
            switch (cmd)
            {
                case "bold": o.Bold = !o.Bold; break;
                case "italic": o.Italic = !o.Italic; break;
                case "underline": o.Underline = !o.Underline; break;
            }
        }
        Touch();
    }

    [JSInvokable]
    public void OnRichModel(string json)
    {
        if (Session.Selected is not { } o || !RichTextModel.UsesRich(o)) return;
        try
        {
            var dto = JsonSerializer.Deserialize<RichTextDto>(json, LabelDocumentJson.Options);
            if (dto is null) return;
            if (!_richHistory)
            {
                History.Push(Session.Document);
                _richHistory = true;
            }
            RichTextModel.ReplaceFromDto(o, dto);
            Session.Dirty = true;
            Session.Notify();
        }
        catch (Exception ex)
        {
            EditorLog.Error("일반텍스트 내용 반영 실패", ex);
        }
    }

    [JSInvokable]
    public void OnRichCaret(string json)
    {
        try
        {
            _caret = JsonSerializer.Deserialize<RichCaretStyle>(json, LabelDocumentJson.Options);
            _ = InvokeAsync(StateHasChanged);
        }
        catch { /* ignore */ }
    }

    [JSInvokable]
    public void OnRichBlur()
    {
        _richHistory = false;
        _caret = null;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnCustomKind(DesignObject o, ChangeEventArgs e)
    {
        if (BindGuarded) return;
        History.Push(Session.Document);
        o.CustomKind = e.Value?.ToString() ?? "date";
        o.CustomFormat = o.CustomKind switch
        {
            "date" => "2",
            "time" => "1",
            _ => o.CustomFormat
        };
        CustomTextFormats.ApplyToken(o);
        if (o.CustomKind is "serial" or "hexserial")
            Session.ExpandCustomSerial();
        Touch();
    }

    private void OnCustomFormat(DesignObject o, ChangeEventArgs e)
    {
        if (BindGuarded) return;
        History.Push(Session.Document);
        o.CustomFormat = e.Value?.ToString() ?? "1";
        CustomTextFormats.ApplyToken(o);
        Touch();
    }

    /// <summary>테두리를 켜 줄 때 쓰는 굵기(mm). <see cref="DesignObject.StrokeWidth"/> 의 클래스 기본값과 같다.</summary>
    private const float DefaultStrokeMm = 0.4f;

    private void OnDashStyle(ChangeEventArgs e)
    {
        if (BindGuarded) return;
        if (!int.TryParse(e.Value?.ToString(), out var dash)) return;
        History.Push(Session.Document);
        var style = Math.Clamp(dash, 0, 4);
        ApplySelected(obj =>
        {
            obj.DashStyle = style;
            // 선 종류는 테두리에만 나타난다. 테두리가 안 그려지는 상태에서 고르면 화면이 그대로여서
            // 항목이 고장 난 것처럼 보인다. 아이콘·클립아트는 기본 굵기가 0이라 늘 이 경우다.
            if (style > 0)
                EnsureStrokeVisible(obj);
        });
        Touch();
    }

    /// <summary>테두리가 그려지지 않는 상태면 기본 굵기·색으로 켠다. 이미 보이면 건드리지 않는다.</summary>
    private static void EnsureStrokeVisible(DesignObject o)
    {
        if (o.StrokeWidth <= 0f)
            o.StrokeWidth = DefaultStrokeMm;
        if (ColorUtil.IsTransparent(o.Stroke))
            o.Stroke = ColorUtil.IsTransparent(o.Fill) ? "#2E2A27" : ColorUtil.ToHtmlColor(o.Fill);
    }

    private void OnShapeKind(ChangeEventArgs e)
    {
        if (Session.Selected is null) return;
        History.Push(Session.Document);
        if (Enum.TryParse<ShapeKind>(e.Value?.ToString(), true, out var kind))
        {
            Session.Selected.Type = ObjectType.Shape;
            Session.Selected.ShapeKind = kind;
            // 원으로 바꾸면 상자도 정사각형이어야 한다. 아니면 타원으로 그려진다.
            // 가운데를 그대로 두고 짧은 변에 맞춰 줄인다.
            if (Session.Selected.KeepsSquare)
                SquareUp(Session.Selected);
        }
        Touch();
    }

    /// <summary>가운데를 고정한 채 상자를 짧은 변 길이의 정사각형으로 맞춘다.</summary>
    private static void SquareUp(DesignObject o)
    {
        var d = Math.Min(o.Width, o.Height);
        if (d <= 0.01f || Math.Abs(o.Width - o.Height) < 0.001f) return;
        o.X += (o.Width - d) / 2f;
        o.Y += (o.Height - d) / 2f;
        o.Width = d;
        o.Height = d;
    }

