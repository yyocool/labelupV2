        _styleHistoryPushed = false;
    }

    /// <summary>
    /// 배경색을 고르면 곧바로 칠한다. 색을 골랐다는 건 배경을 쓰겠다는 뜻이므로 배경투명도 같이 푼다.
    /// 배경을 그리지 않는 종류는 죽은 값을 남기지 않도록 건너뛴다.
    /// </summary>
    private void LiveBackground(ChangeEventArgs e)
    {
        var v = ColorUtil.ToHtmlColor(e.Value?.ToString(), "");
        if (v.Length != 7) return;
        BeginStyleHistory();
        ApplySelected(obj =>
        {
            if (!ShowBackground(obj)) return;
            obj.BackgroundFill = v;
            obj.BackgroundTransparent = false;
        });
        Touch();
    }

    private void CommitBackground(ChangeEventArgs e)
    {
        LiveBackground(e);
        _styleHistoryPushed = false;
    }

    private void OnBackgroundTransparent(ChangeEventArgs e)
    {
        if (BindGuarded) return;
        var on = e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        History.Push(Session.Document);
        ApplySelected(obj =>
        {
            if (!ShowBackground(obj)) return;
            obj.BackgroundTransparent = on;
            if (!on && ColorUtil.IsTransparent(obj.BackgroundFill))
                obj.BackgroundFill = WhiteFallback;
        });
        Touch();
    }

    private void OnFillTransparent(ChangeEventArgs e)
    {
        if (BindGuarded) return;
        var on = e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        History.Push(Session.Document);
        ApplySelected(obj => obj.Fill = on ? "transparent" : ColorUtil.ToHtmlColor(obj.Fill, "#7b2840"));
        Touch();
    }

