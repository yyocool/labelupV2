@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@implements IDisposable

@if (Session.Dialog == EditorDialog.Error)
{
  <div class="ed-modal" role="alertdialog" aria-label="@Session.ErrorTitle" @onclick="Close">
    <div class="ed-modal__card ed-modal__card--confirm" @onclick:stopPropagation="true">
      <header class="ed-modal__head">
        <div>
          <h3>@Session.ErrorTitle</h3>
          <p>작업을 중단하고 이전 화면을 유지합니다.</p>
        </div>
        <button type="button" class="ed-modal__close" @onclick="Close">×</button>
      </header>
      <div class="ed-modal__body">
        <p class="ed-error-dialog__msg">@Session.ErrorMessage</p>
      </div>
      <footer class="ed-modal__foot">
        <button type="button" class="ed-btn ed-btn--primary" @onclick="Close">확인</button>
      </footer>
    </div>
  </div>
}

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Close()
    {
        Session.ErrorMessage = "";
        Session.CloseDialog();
    }
}
