@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@using Microsoft.JSInterop
@inject EditorSession Session
@inject HistoryService History
@inject IJSRuntime Js
@implements IDisposable

<aside class="ed-props @(Session.PropsMinimized ? "is-minimized" : null)" data-ed-props-panel data-ed-snap-id="tr" data-tut="props" aria-label="레이어">
  <div class="ed-props__chrome" data-ed-props-handle>
    <span class="ed-props__grip" aria-hidden="true">⋮⋮</span>
    <span class="ed-props__title">레이어</span>
    <button type="button" class="ed-props__min" data-tut="props-expand" title="접기" @onclick="TogglePropsMin">—</button>
  </div>

  @if (!Session.PropsMinimized)
  {
    <div class="ed-props__inner">
      <div class="ed-props__body ed-props__layers" data-tut="tab-layers">
        @if (Session.CurrentCell.Objects.Count == 0)
        {
          <div class="ed-props__empty">레이어가 없습니다.</div>
        }
        else
        {
          @foreach (var obj in Session.CurrentCell.Objects.OrderByDescending(x => x.ZIndex).ThenByDescending(x => Session.CurrentCell.Objects.IndexOf(x)))
          {
            <button type="button"
                    class="ed-layer-item @(Session.SelectedIds.Contains(obj.Id) ? "is-active" : null)"
                    @onclick="() => Session.Select(obj.Id)">
              <span>@(obj.Locked ? "🔒" : "👁")</span>
              <span>@LayerLabel(obj)</span>
              <em>z @obj.ZIndex</em>
            </button>
          }
        }
      </div>
    </div>
  }
</aside>

@code {
    private DotNetObjectReference<InspectorPanel>? _self;

    protected override void OnInitialized()
    {
        Session.PropsTab = "layers";
        Session.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        try { await Js.InvokeVoidAsync("labelUpEditor.bindLayerDragHost", _self); }
        catch (Exception ex) { EditorLog.Warn("레이어 드래그 연결 실패: " + ex.Message); }
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        _self?.Dispose();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    private void TogglePropsMin() { Session.PropsMinimized = !Session.PropsMinimized; Session.Notify(); }

    [JSInvokable]
    public void ReorderLayers(int fromIndex, int toIndex)
    {
        if (fromIndex == toIndex) return;
        History.Push(Session.Document);
        if (!Session.ReorderLayerVisual(fromIndex, toIndex))
            EditorLog.Warn($"레이어 순서 변경 실패 {fromIndex}→{toIndex}");
    }

    private static string LayerLabel(DesignObject o) => o.Type switch
    {
        ObjectType.Text => string.IsNullOrWhiteSpace(o.Text) ? "텍스트" : (o.Text.Length > 18 ? o.Text[..18] + "…" : o.Text),
        ObjectType.Image => "이미지",
        ObjectType.Rect => "사각형",
        ObjectType.Ellipse => "원",
        ObjectType.Line => "선",
        ObjectType.Shape => o.ShapeKind switch
        {
            ShapeKind.RoundRect => "둥근 사각형",
            ShapeKind.Circle => "원",
            ShapeKind.Triangle => "삼각형",
            ShapeKind.Ellipse => "타원",
            ShapeKind.Arc => "원호",
            ShapeKind.Line => "선",
            ShapeKind.Arrow => "화살표",
            ShapeKind.Polygon => $"{o.PolygonSides}각형",
            ShapeKind.Star => $"별 {o.PolygonSides}꼭지",
            ShapeKind.Trapezoid => "사다리꼴",
            ShapeKind.Parallelogram => "평행사변형",
            _ => "사각형"
        },
        ObjectType.Barcode => "바코드",
        ObjectType.Qr => "QR",
        ObjectType.Table => "표",
        ObjectType.Clipart => "클립아트",
        ObjectType.Icon => o.IconName ?? "아이콘",
        ObjectType.Gradient => "그라데이션",
        _ => o.Type.ToString()
    };
}
