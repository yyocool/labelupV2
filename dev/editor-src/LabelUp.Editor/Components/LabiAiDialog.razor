@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@inject IJSRuntime Js
@implements IDisposable

@if (Session.Dialog == EditorDialog.LabiAi)
{
  <div class="ed-modal ed-labi-modal" role="dialog" aria-label="라비AI" @onclick="Session.CloseDialog">
    <div class="ed-modal__card ed-modal__card--labi ed-labi" @onclick:stopPropagation="true">
      <header class="ed-modal__head">
        <div>
          <h3>라비AI</h3>
          <p>원하는 라벨을 말하면 상품과 클립아트를 바로 편집기에 넣을 수 있어요.</p>
        </div>
        <button type="button" class="ed-modal__close" @onclick="Session.CloseDialog">×</button>
      </header>
      <div class="ed-modal__body ed-labi__body">
        <section class="prompt" id="aiPromptPanel">
          <div class="prompt-head">
            <div class="prompt-title">
              <b>라비와 라벨 만들기</b>
              <span>추천 상품·클립아트를 이 편집기에 바로 적용해요</span>
            </div>
            <span class="prompt-badge">AI DESIGN</span>
          </div>

          <div class="ai-chat-log" id="aiChatLog" hidden aria-live="polite"></div>

          <div class="prompt-composer">
            <div class="ai-attach-preview" id="aiAttachPreview" hidden></div>
            <div class="prompt-row">
              <div class="spark" aria-hidden="true">✦</div>
              <div class="prompt-input">
                <textarea id="promptInput" rows="2" placeholder="어떤 라벨을 만들고 싶으신가요? 이미지·엑셀·타사포맷도 첨부할 수 있어요" readonly></textarea>
                <div class="prompt-helper" id="promptHelper">제품명 · 용도 · 규격, 또는 폼텍·아이라벨·애니라벨 파일을 끌어다 놓으면 변환해요</div>
              </div>
              <div class="prompt-tools">
                <input type="file" id="aiFileInput" hidden multiple accept="image/*,.xlsx,.xls,.csv,.tsv,.docx,.doc,.txt,.json,.md,.pdf,.lbl,.idf,.xml,.dgz,.dgf,.fmt,.fdx,.zip">
                <button class="prompt-tool-btn" id="aiAttachBtn" type="button" title="파일 첨부" aria-label="파일 첨부">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21.44 11.05 12.25 20.24a5.5 5.5 0 0 1-7.78-7.78l9.19-9.19a3.5 3.5 0 1 1 4.95 4.95l-9.2 9.19a1.5 1.5 0 1 1-2.12-2.12l8.49-8.48" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button class="send" id="sendBtn" type="button" disabled title="전송">➤</button>
              </div>
            </div>
          </div>

          <div class="prompt-actions"></div>
        </section>
      </div>
    </div>
  </div>
}

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Session.Dialog != EditorDialog.LabiAi) return;
        try { await Js.InvokeVoidAsync("labelUpEditor.mountLabiChat"); }
        catch (Exception ex) { EditorLog.Warn("라비AI 채팅 연결 실패: " + ex.Message); }
    }
}
