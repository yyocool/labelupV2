@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@inject HistoryService History
@implements IDisposable

@if (Session.Dialog == EditorDialog.DeleteBoundConfirm)
{
  <div class="ed-modal" role="alertdialog" aria-label="자료연결 항목 삭제" @onclick="Cancel">
    <div class="ed-modal__card ed-modal__card--confirm" @onclick:stopPropagation="true">
      <header class="ed-modal__head">
        <div>
          <h3>자료연결 항목 삭제</h3>
          <p>@ColumnLine</p>
        </div>
        <button type="button" class="ed-modal__close" @onclick="Cancel">×</button>
      </header>
      <div class="ed-modal__body">
        <p class="ed-confirm-msg">데이터에 연결된 항목입니다. 삭제시 모든 라벨에서 연결이 해제 됩니다. 다시 추가하시려면 데이터 판넬에서 다시 추가하셔야 합니다.</p>
      </div>
      <footer class="ed-modal__foot">
        <button type="button" class="ed-btn" @onclick="Cancel">취소</button>
        <button type="button" class="ed-btn ed-btn--primary" @onclick="Confirm">확인</button>
      </footer>
    </div>
  </div>
}

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    /// <summary>어느 열을 지우는지 제목 아래에 밝힌다.</summary>
    private string ColumnLine
    {
        get
        {
            var cols = Session.SelectedBoundColumns;
            return cols.Count == 0
                ? "연결된 열을 확인할 수 없습니다"
                : string.Join(", ", cols.Select(c => c + " 열"));
        }
    }

    private void Cancel()
    {
        Session.CloseDialog();
        Session.Status = "삭제를 취소했습니다";
        Session.Notify();
    }

    private void Confirm()
    {
        History.Push(Session.Document);
        Session.DeleteSelectionWithBound();
        Session.CloseDialog();
    }
}
