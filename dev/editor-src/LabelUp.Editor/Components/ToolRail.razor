@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@implements IDisposable

<aside class="tool-rail" aria-label="편집 도구">
  <div class="tool-rail__brand">
    <span class="tool-rail__mark">LU</span>
  </div>

  <nav class="tool-rail__nav">
    @foreach (var (tool, label, icon) in Tools)
    {
      <button type="button"
              class="tool-btn @(Session.Tool == tool ? "is-active" : null)"
              title="@label"
              @onclick="() => Session.SetTool(tool)">
        <span class="tool-btn__ico">@icon</span>
        <span class="tool-btn__lbl">@label</span>
      </button>
    }
  </nav>

  <div class="tool-rail__presets">
    <div class="tool-rail__section">용지</div>
    <button type="button" class="preset-btn" @onclick="() => Session.OpenDialog(EditorDialog.PaperPicker)">
      용지선택
    </button>
  </div>
</aside>

@code {
    private static readonly (EditorTool Tool, string Label, string Icon)[] Tools =
    [
        (EditorTool.Select, "선택", "↖"),
        (EditorTool.Text, "텍스트", "T"),
        (EditorTool.Barcode, "바코드", "▮"),
        (EditorTool.Qr, "QR", "▣"),
        (EditorTool.Image, "이미지", "🖼"),
        (EditorTool.Table, "표", "▦"),
        (EditorTool.Clipart, "클립아트", "★"),
        (EditorTool.Icon, "아이콘", "❖"),
        (EditorTool.Shape, "도형", "▭")
    ];

    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
}
