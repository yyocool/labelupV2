@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@inject DesignSaveService Save
@implements IDisposable

@if (Session.Dialog == EditorDialog.UnsavedChanges)
{
  <div class="ed-modal" role="dialog" aria-label="저장하지 않은 변경 사항" @onclick="Cancel">
    <div class="ed-modal__card ed-modal__card--confirm" @onclick:stopPropagation="true">
      <header class="ed-modal__head">
        <div>
          <h3>저장하지 않은 변경 사항</h3>
          <p>새 파일을 열거나 변환하면 지금 작업이 사라집니다.</p>
        </div>
        <button type="button" class="ed-modal__close" @onclick="Cancel" disabled="@_busy">×</button>
      </header>
      <div class="ed-modal__body">
        <p>「@Session.Document.Name」에 수정한 내용이 있습니다. 저장할까요?</p>
      </div>
      <footer class="ed-modal__foot">
        <button type="button" class="ed-btn" @onclick="Cancel" disabled="@_busy">취소</button>
        <button type="button" class="ed-btn" @onclick="Discard" disabled="@_busy">저장 안 함</button>
        <button type="button" class="ed-btn ed-btn--primary" @onclick="SaveThenContinue" disabled="@_busy">저장</button>
      </footer>
    </div>
  </div>
}

@code {
    private bool _busy;

    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Cancel()
    {
        if (_busy) return;
        Session.CancelPendingContinue();
        Session.Status = "파일 열기를 취소했습니다";
        Session.Notify();
    }

    private async Task Discard()
    {
        if (_busy) return;
        await ContinuePendingAsync();
    }

    private async Task SaveThenContinue()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var ok = await Save.TrySaveAsync();
            if (!ok) return;
            await ContinuePendingAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ContinuePendingAsync()
    {
        var next = Session.PendingContinueAsync;
        Session.PendingContinueAsync = null;
        Session.CloseDialog();
        if (next is null) return;
        try
        {
            await next();
        }
        catch (Exception ex)
        {
            Session.ShowConversionError(ex);
        }
    }
}
