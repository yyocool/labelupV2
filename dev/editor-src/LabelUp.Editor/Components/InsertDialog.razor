@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@inject HistoryService History
@implements IDisposable

@if (Session.Dialog is EditorDialog.Barcode or EditorDialog.Qr or EditorDialog.Table)
{
  <div class="ed-modal" role="dialog" aria-label="항목 추가" @onclick="Cancel">
    <div class="ed-modal__card" @onclick:stopPropagation="true">
      <header class="ed-modal__head">
        <div>
          <h3>@Title</h3>
          <p>값을 지정한 뒤에 라벨에 추가됩니다.</p>
        </div>
        <button type="button" class="ed-modal__close" @onclick="Cancel">×</button>
      </header>
      <div class="ed-modal__body">
        @if (Session.Dialog == EditorDialog.Barcode)
        {
          <div class="ed-form-grid">
            <label class="ed-form-grid__full">
              바코드 종류
              <select @bind="_barcodeFormat">
                @foreach (var spec in BarcodeCatalog.OneD)
                {
                  <option value="@spec.Id">@spec.Label</option>
                }
              </select>
            </label>
            <label class="ed-form-grid__full">
              @BarcodeCatalog.ValueFieldLabel(_barcodeFormat)
              <input @bind="_value" />
            </label>
            <label>
              <input type="checkbox" @bind="_showText" /> 내용 표시
            </label>
            <label>
              <input type="checkbox" @bind="_showStartEnd" /> 시작·끝 표시
            </label>
          </div>
        }
        else if (Session.Dialog == EditorDialog.Qr)
        {
          <div class="ed-form-grid">
            <label class="ed-form-grid__full">
              종류
              <select @bind="_barcodeFormat">
                @foreach (var spec in BarcodeCatalog.TwoD)
                {
                  <option value="@spec.Id">@spec.Label</option>
                }
              </select>
            </label>
            <label class="ed-form-grid__full">
              @BarcodeCatalog.ValueFieldLabel(_barcodeFormat)
              <input @bind="_value" />
            </label>
          </div>
        }
        else
        {
          <div class="ed-form-grid">
            <label>행 <input type="number" min="1" max="12" @bind="_rows" /></label>
            <label>열 <input type="number" min="1" max="12" @bind="_cols" /></label>
          </div>
        }
      </div>
      <footer class="ed-modal__foot">
        <button type="button" class="ed-btn" @onclick="Cancel">취소</button>
        <button type="button" class="ed-btn ed-btn--primary" @onclick="Confirm">추가</button>
      </footer>
    </div>
  </div>
}

@code {
    private string _barcodeFormat = "CODE_128";
    private string _value = "LABELUP";
    private bool _showText = true;
    private bool _showStartEnd;
    private int _rows = 2;
    private int _cols = 2;
    private EditorDialog _last;

    private string Title => Session.Dialog switch
    {
        EditorDialog.Barcode => "바코드 추가",
        EditorDialog.Qr => "QR / 2D코드 추가",
        _ => "표 추가"
    };

    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;

    private void OnChanged()
    {
        if (Session.Dialog != _last)
        {
            _last = Session.Dialog;
            if (Session.Dialog == EditorDialog.Barcode)
            {
                _barcodeFormat = "CODE_128";
                _value = "LABELUP";
                _showText = true;
                _showStartEnd = false;
            }
            else if (Session.Dialog == EditorDialog.Qr)
            {
                _barcodeFormat = "QR_CODE";
                _value = "https://labelup.kr";
            }
            else if (Session.Dialog == EditorDialog.Table)
            {
                _rows = 2;
                _cols = 2;
            }
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private void Cancel()
    {
        Session.PendingInsert = null;
        Session.SetTool(EditorTool.Select);
        Session.CloseDialog();
    }

    private void Confirm()
    {
        History.Push(Session.Document);
        if (Session.Dialog == EditorDialog.Barcode)
        {
            Session.PlaceDefault(ObjectType.Barcode, o =>
            {
                o.BarcodeFormat = _barcodeFormat;
                o.BarcodeValue = _value;
                o.BarcodeShowText = _showText;
                o.BarcodeShowStartEnd = _showStartEnd;
            });
        }
        else if (Session.Dialog == EditorDialog.Qr)
        {
            Session.PlaceDefault(ObjectType.Qr, o =>
            {
                o.BarcodeFormat = _barcodeFormat;
                o.BarcodeValue = _value;
                o.BarcodeShowText = false;
            });
        }
        else
        {
            Session.PlaceDefault(ObjectType.Table, o =>
            {
                o.TableRows = Math.Clamp(_rows, 1, 12);
                o.TableCols = Math.Clamp(_cols, 1, 12);
                o.EnsureTableSize();
            });
        }
        Session.PendingInsert = null;
        Session.CloseDialog();
    }
}
