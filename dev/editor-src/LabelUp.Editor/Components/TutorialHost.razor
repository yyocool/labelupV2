@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@using Microsoft.JSInterop
@inject EditorSession Session
@inject IJSRuntime Js
@implements IAsyncDisposable

@if (_showInvite)
{
  <div class="lu-tut-invite" role="dialog" aria-modal="true" aria-label="튜토리얼 안내">
    <div class="lu-tut-invite__card">
      <img class="lu-tut-invite__labi" src="img/labi-icon.png" alt="" width="88" height="88" />
      <h3>라비와 함께 편집기 둘러볼까요?</h3>
      <p>
        처음이라면 튜토리얼 모드로 도구바·용지·템플릿·캔버스·라비AI 사용법을
        가상 커서와 함께 배워볼 수 있어요.
      </p>
      <div class="lu-tut-invite__actions">
        <button type="button" class="is-primary" @onclick="StartTutorial">튜토리얼 시작</button>
        <button type="button" @onclick="DismissInvite">나중에 하기</button>
        <button type="button" class="is-ghost" @onclick="SkipForever">다시 보지 않기</button>
      </div>
    </div>
  </div>
}

<button type="button" class="ed-tut-reopen" title="튜토리얼 다시 보기" @onclick="StartTutorial">
  ✦ 튜토리얼
</button>

@code {
    private DotNetObjectReference<TutorialHost>? _self;
    private bool _showInvite;
    private bool _mounted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _mounted) return;
        _mounted = true;
        _self = DotNetObjectReference.Create(this);

        for (var i = 0; i < 10; i++)
        {
            try
            {
                await Js.InvokeVoidAsync("labelUpEditor.tutorial.mount", "[data-ed-root]", _self);
                var offer = await Js.InvokeAsync<bool>("labelUpEditor.tutorial.shouldAutoOffer");
                if (offer)
                {
                    _showInvite = true;
                    StateHasChanged();
                }
                return;
            }
            catch
            {
                await Task.Delay(150);
            }
        }
    }

    private async Task StartTutorial()
    {
        _showInvite = false;
        try
        {
            await Js.InvokeVoidAsync("labelUpEditor.tutorial.start", 0);
        }
        catch
        {
            Session.Status = "튜토리얼을 시작할 수 없습니다";
            Session.Notify();
        }
    }

    private void DismissInvite() => _showInvite = false;

    private async Task SkipForever()
    {
        _showInvite = false;
        try { await Js.InvokeVoidAsync("labelUpEditor.tutorial.markSkipped"); }
        catch { /* ignore */ }
    }

    [JSInvokable]
    public Task TutorialAction(string action)
    {
        if (string.IsNullOrWhiteSpace(action)) return Task.CompletedTask;

        if (action.StartsWith("setTool:", StringComparison.Ordinal))
        {
            var name = action["setTool:".Length..];
            if (Enum.TryParse<EditorTool>(name, ignoreCase: true, out var tool))
            {
                Session.SetTool(tool);
                Session.Status = $"도구 · {tool}";
            }
            return Task.CompletedTask;
        }

        if (action == "openPaperPicker")
        {
            Session.OpenDialog(EditorDialog.PaperPicker);
            return Task.CompletedTask;
        }

        if (action == "closePaperPicker")
        {
            if (Session.Dialog == EditorDialog.PaperPicker)
                Session.CloseDialog();
            return Task.CompletedTask;
        }

        if (action == "expandProps")
        {
            if (Session.Dialog == EditorDialog.PaperPicker)
                Session.CloseDialog();
            if (Session.PropsMinimized)
            {
                Session.PropsMinimized = false;
                Session.Notify();
            }
            return Task.CompletedTask;
        }

        if (action == "expandPreview")
        {
            if (Session.PreviewMinimized)
            {
                Session.PreviewMinimized = false;
                Session.Notify();
            }
            return Task.CompletedTask;
        }

        if (action.StartsWith("propsTab:", StringComparison.Ordinal))
        {
            var tab = action["propsTab:".Length..];
            Session.PropsTab = tab == "layers" ? "layers" : "props";
            if (Session.PropsMinimized)
            {
                Session.PropsMinimized = false;
            }
            Session.Notify();
            return Task.CompletedTask;
        }

        if (action == "openVendorPicker")
        {
            Session.OpenDialog(EditorDialog.VendorPicker);
            return Task.CompletedTask;
        }

        if (action == "closeVendorPicker")
        {
            if (Session.Dialog == EditorDialog.VendorPicker)
                Session.CloseDialog();
            return Task.CompletedTask;
        }

        if (action == "closeVendorPickerThenImport")
        {
            if (Session.Dialog == EditorDialog.VendorPicker)
                Session.CloseDialog();
            return Task.CompletedTask;
        }

        if (action is "openImport" or "closeImport" || action.StartsWith("importTab:", StringComparison.Ordinal)
            || action.StartsWith("paperTab:", StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_mounted)
                await Js.InvokeVoidAsync("labelUpEditor.tutorial.stop");
        }
        catch { /* ignore */ }
        _self?.Dispose();
    }
}
