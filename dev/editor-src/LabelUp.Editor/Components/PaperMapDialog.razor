@using System.Text.Json
@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@inject PaperCatalog Papers
@inject DraftStorage Drafts
@inject ExportService Export
@implements IDisposable

@if (Session.Dialog == EditorDialog.PaperMap)
{
  <div class="ed-modal" role="dialog" aria-label="용지 규격 변환 만들기" @onclick="Session.CloseDialog">
    <div class="ed-modal__card ed-modal__card--wide" @onclick:stopPropagation="true">
      <header class="ed-modal__head">
        <div>
          <h3>용지 규격 변환 만들기</h3>
          <p>애니라벨·폼텍·아이라벨 용지번호를 우리 용지번호와 짝짓습니다. 타사 포맷 가져오기 때 자동 변환됩니다.</p>
        </div>
        <button type="button" class="ed-modal__close" @onclick="Session.CloseDialog">×</button>
      </header>
      <div class="ed-modal__body">
        <table class="ed-map-table">
          <thead>
            <tr>
              <th>제조사</th>
              <th>타사 용지번호</th>
              <th>우리 용지번호</th>
              <th>메모</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @for (var i = 0; i < _map.Entries.Count; i++)
            {
              var idx = i;
              var row = _map.Entries[idx];
              <tr>
                <td>
                  <select @bind="row.Vendor">
                    <option value="anylabel">anylabel</option>
                    <option value="formtec">formtec</option>
                    <option value="ilabel">ilabel</option>
                  </select>
                </td>
                <td><input @bind="row.VendorPaperNo" placeholder="V3230" /></td>
                <td>
                  <select @bind="row.OurPaperNo">
                    @foreach (var p in Papers.Papers)
                    {
                      <option value="@p.PaperNo">@p.PaperNo</option>
                    }
                  </select>
                </td>
                <td><input @bind="row.Note" /></td>
                <td><button type="button" class="ed-btn" @onclick="() => _map.Entries.RemoveAt(idx)">삭제</button></td>
              </tr>
            }
          </tbody>
        </table>
        <button type="button" class="ed-btn" @onclick="AddRow">행 추가</button>
      </div>
      <footer class="ed-modal__foot">
        <button type="button" class="ed-btn" @onclick="SaveLocal">브라우저에 저장</button>
        <button type="button" class="ed-btn ed-btn--primary" @onclick="Download">JSON 내려받기</button>
      </footer>
    </div>
  </div>
}

@code {
    private VendorPaperMap _map = new();

    private bool _opened;

    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;

    private void OnChanged()
    {
        if (Session.Dialog == EditorDialog.PaperMap && !_opened)
        {
            _opened = true;
            _map = Papers.Map.Clone();
        }
        if (Session.Dialog != EditorDialog.PaperMap) _opened = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void AddRow() => _map.Entries.Add(new VendorPaperMapEntry { OurPaperNo = Papers.Papers.FirstOrDefault()?.PaperNo ?? "LU-3230" });

    private async Task SaveLocal()
    {
        Papers.ReplaceMap(_map);
        await Drafts.SaveMapAsync(_map);
        Session.Status = "변환표를 저장했습니다";
        Session.CloseDialog();
    }

    private async Task Download()
    {
        Papers.ReplaceMap(_map);
        await Drafts.SaveMapAsync(_map);
        var json = JsonSerializer.Serialize(_map, LabelDocumentJson.Options);
        await Export.DownloadTextAsync(json, "vendor-map.json", "application/json");
        Session.Status = "vendor-map.json 을 내려받았습니다. paperData/maps 에 넣으세요.";
        Session.CloseDialog();
    }
}
