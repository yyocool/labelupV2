@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@implements IDisposable

@if (Session.Dialog == EditorDialog.DataCreateConfirm)
{
  <div class="ed-modal" role="alertdialog" aria-label="데이터 생성 확인" @onclick="Cancel">
    <div class="ed-modal__card ed-modal__card--confirm" @onclick:stopPropagation="true">
      <header class="ed-modal__head">
        <div>
          <h3>데이터 생성하기</h3>
          <p>@CurrentLine</p>
        </div>
        <button type="button" class="ed-modal__close" @onclick="Cancel">×</button>
      </header>
      <div class="ed-modal__body">
        <p class="ed-confirm-msg">기존에 연결된 데이터가 있습니다. 새 데이터를 생성하면 기존 데이터가 지워집니다. 진행하시겠습니까?</p>
      </div>
      <footer class="ed-modal__foot">
        <button type="button" class="ed-btn" @onclick="Cancel">취소</button>
        <button type="button" class="ed-btn ed-btn--primary" @onclick="Confirm">확인</button>
      </footer>
    </div>
  </div>
}

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    /// <summary>지금 쓰고 있는 자료가 무엇인지 제목 아래에 밝힌다.</summary>
    private string CurrentLine
    {
        get
        {
            if (Session.Document.Data is not { } data) return "";
            var name = string.IsNullOrWhiteSpace(data.SourceName) ? "이름 없는 자료" : data.SourceName;
            return $"지금 쓰는 자료 · {name} · {data.ColumnCount}열 {data.RowCount}행";
        }
    }

    private void Cancel()
    {
        Session.CloseDialog();
        Session.Status = "데이터 생성을 취소했습니다";
        Session.Notify();
    }

    private void Confirm() => Session.OpenDialog(EditorDialog.DataCreate);
}
