@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@inject DesignSaveService Save
@inject HistoryService History
@inject DraftStorage Drafts
@implements IDisposable

@if (Session.Dialog == EditorDialog.NewDesignConfirm)
{
  <div class="ed-modal" role="alertdialog" aria-label="새 디자인 시작" @onclick="Cancel">
    <div class="ed-modal__card ed-modal__card--confirm" @onclick:stopPropagation="true">
      <header class="ed-modal__head">
        <div>
          <h3>새 디자인 시작</h3>
          <p>@SummaryLine</p>
        </div>
        <button type="button" class="ed-modal__close" @onclick="Cancel" disabled="@_busy">×</button>
      </header>
      <div class="ed-modal__body">
        <p class="ed-confirm-msg">지금 작업한 「@DesignName」을(를) 계정에 저장한 뒤 새로 시작할까요? 저장하지 않으면 지금 내용은 사라집니다. 용지는 그대로 두고 라벨 안의 내용만 모두 비웁니다.</p>
      </div>
      <footer class="ed-modal__foot">
        <button type="button" class="ed-btn" @onclick="Cancel" disabled="@_busy">취소</button>
        <button type="button" class="ed-btn" @onclick="StartWithoutSaving" disabled="@_busy">저장 안 함</button>
        <button type="button" class="ed-btn ed-btn--primary" @onclick="SaveThenStart" disabled="@_busy">
          @(_busy ? "저장 중…" : "저장하고 시작")
        </button>
      </footer>
    </div>
  </div>
}

@code {
    private bool _busy;

    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private string DesignName
    {
        get
        {
            var name = Session.Document.Name?.Trim();
            return string.IsNullOrEmpty(name) ? "이름 없는 디자인" : name;
        }
    }

    /// <summary>무엇이 지워지는지 제목 아래에 세어 보여 준다.</summary>
    private string SummaryLine
    {
        get
        {
            var objects = Session.Document.Pages.SelectMany(p => p.Cells).Sum(c => c.Objects.Count);
            var rows = Session.Document.Data?.RowCount ?? 0;
            return rows > 0
                ? $"항목 {objects}개 · 연결된 자료 {rows}행이 지워집니다"
                : $"항목 {objects}개가 지워집니다";
        }
    }

    private void Cancel()
    {
        if (_busy) return;
        Session.CloseDialog();
        Session.Status = "새 디자인을 취소했습니다";
        Session.Notify();
    }

    private void StartWithoutSaving()
    {
        if (_busy) return;
        Start();
    }

    private async Task SaveThenStart()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            // 저장에 실패하면 새로 시작하지 않는다. 지우고 나면 되돌릴 수 없기 때문이다.
            if (!await Save.TrySaveAsync()) return;
            Start();
        }
        catch (Exception ex)
        {
            EditorLog.Error("새 디자인 전 저장 실패", ex);
            Session.Status = "저장 실패로 새 디자인을 시작하지 않았습니다: " + EditorSession.FriendlyError(ex);
            Session.Notify();
        }
        finally
        {
            _busy = false;
        }
    }

    private void Start()
    {
        // 되돌리기로 지운 디자인이 되살아나면 헷갈린다. 기록을 비우고 새로 센다.
        History.Clear();
        Session.StartNewDesign();
        _ = Drafts.ClearAsync();
        Session.CloseDialog();
    }
}
