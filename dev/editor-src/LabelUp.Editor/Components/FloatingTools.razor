@using LabelUp.Editor.Models
@using LabelUp.Editor.Rendering
@using LabelUp.Editor.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject EditorSession Session
@inject HistoryService History
@inject DataImportService DataImport
@inject EditorCloudStorage Cloud
@inject IJSRuntime Js
@implements IDisposable

<div class="ed-float-tools" data-ed-float-tools data-ed-float-corner="tl" data-ed-float-orient="horizontal" data-tut="float-tools" aria-label="왼쪽 도구바">
  <div class="ed-float-tools__bar" data-ed-float-tools-bar>
    <button type="button" class="ed-float-tools__grip" data-ed-float-tools-grip title="드래그하여 이동 · 모서리에 자석 도킹" aria-label="도구바 이동">
      <span aria-hidden="true">⋮⋮</span>
    </button>

    <div class="ed-float-tools__group" role="group">
      @foreach (var item in Tools)
      {
        <button type="button"
                class="ed-float-tools__item @(Session.Tool == item.Tool ? "is-active" : null)"
                data-tut="@item.Tut"
                @onclick="() => OnTool(item)">
          <span class="ed-float-tools__ico">@IconMarkup(item)</span>
          <span class="ed-float-tools__label">@item.Label</span>
        </button>
      }

      <div class="ed-float-tools__shape">
        <button type="button"
                class="ed-float-tools__item @(Session.ShapeMenuOpen || Session.Tool == EditorTool.Shape ? "is-active" : null)"
                data-tut="tool-rect"
                @onclick="ToggleShapeMenu">
          <span class="ed-float-tools__ico">▭</span>
          <span class="ed-float-tools__label">도형</span>
        </button>
        @if (Session.ShapeMenuOpen)
        {
          <button type="button" class="ed-shape-pop-backdrop" aria-label="도형 메뉴 닫기" @onclick="CloseShapeMenu"></button>
          <div class="ed-shape-pop" role="menu">
            @foreach (var shape in Shapes)
            {
              <button type="button" class="ed-shape-pop__item" @onclick="() => PlaceShape(shape.Kind)">
                <span>@shape.Icon</span>
                <em>@shape.Label</em>
              </button>
            }
          </div>
        }
      </div>
    </div>

    <span class="ed-float-tools__divider" aria-hidden="true"></span>

    <div class="ed-float-tools__group ed-float-tools__group--stack" role="group">
      <button type="button" class="ed-float-tools__paper" data-tut="presets" @onclick="() => Session.OpenDialog(EditorDialog.PaperPicker)">
        <span class="ed-float-tools__paper-kicker">용지선택</span>
        <strong>@Session.Document.Paper.PaperNo</strong>
        <em>@Session.Document.Paper.LabelWidthMm.ToString("0.#")×@Session.Document.Paper.LabelHeightMm.ToString("0.#") mm · @Session.Document.Paper.LabelsPerPage 칸</em>
      </button>
      <button type="button" class="ed-float-tools__paper" data-tut="themes" title="@ThemeTitleFull" @onclick="() => Session.OpenDialog(EditorDialog.ThemePicker)">
        <span class="ed-float-tools__paper-kicker">템플릿선택</span>
        @if (!string.IsNullOrEmpty(ThemeTitle))
        {
          <strong>@ThemeTitle</strong>
        }
        <em>@ThemeMeta</em>
      </button>
      <label class="ed-float-tools__file" data-tut="data-import" title="데이터 가져오기">
        <svg class="ed-float-tools__ico" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M3.2 2.2h9.6c.7 0 1.2.5 1.2 1.2v9.2c0 .7-.5 1.2-1.2 1.2H3.2c-.7 0-1.2-.5-1.2-1.2V3.4c0-.7.5-1.2 1.2-1.2Zm0 1.4v1.8h9.6V3.6H3.2Zm0 3.2v1.8h3V6.8h-3Zm4.4 0v1.8h5.2V6.8H7.6Zm-4.4 3.2V13h3v-3h-3Zm4.4 0V13h5.2v-3H7.6Z"/></svg>
        <span>데이터 가져오기</span>
        <InputFile OnChange="OnDataFile" accept=".csv,.txt,.xlsx,.xls,.mdb" />
      </label>
    </div>

    <span class="ed-float-tools__divider ed-float-tools__divider--files" aria-hidden="true"></span>

    <div class="ed-float-tools__group ed-float-tools__group--files" role="group">
      <button type="button" class="ed-float-tools__file" data-tut="mydesign" title="내 디자인 불러오기" @onclick="OpenProjects">
        <svg class="ed-float-tools__ico" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M2.4 3.2A1.4 1.4 0 0 1 3.8 2h3.1c.3 0 .6.1.8.4L8.4 3H12a1.6 1.6 0 0 1 1.6 1.6v7.8A1.6 1.6 0 0 1 12 14H4a1.6 1.6 0 0 1-1.6-1.6V3.2Zm1.4.6v8.6c0 .1.1.2.2.2h8c.1 0 .2-.1.2-.2V5H8.2L7.5 4H4c-.1 0-.2.1-.2.2Z"/></svg>
        <span>내 디자인</span>
      </button>
      <button type="button" class="ed-float-tools__file" data-tut="data-create" title="데이터 생성하기" @onclick="OpenDataCreate">
        <svg class="ed-float-tools__ico" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M3 2.2h10c.6 0 1 .4 1 1V13c0 .6-.4 1-1 1H3c-.6 0-1-.4-1-1V3.2c0-.6.4-1 1-1Zm0 1.4V5h10V3.6H3Zm0 2.8v1.8h3.2V6.4H3Zm4.6 0v1.8H13V6.4H7.6ZM3 9.6V13h3.2V9.6H3Zm4.6 0V13H13V9.6H7.6Z"/></svg>
        <span>데이터 생성하기</span>
      </button>
    </div>

    <span class="ed-float-tools__divider" aria-hidden="true"></span>
    <div class="ed-float-tools__dock" data-ed-float-dock data-tut="dock">
      <button type="button" class="ed-float-tools__dock-btn" data-ed-float-dock-toggle title="모서리 · 배치 설정" aria-label="도구바 설정">⌖</button>
      <div class="ed-float-tools__dock-menu" data-ed-float-dock-menu hidden>
        <p class="ed-float-tools__dock-label">모서리 위치</p>
        <div class="ed-float-tools__dock-grid ed-float-tools__dock-grid--corner">
          <button type="button" data-ed-float-corner="tl" title="좌측 상단">↖</button>
          <button type="button" data-ed-float-corner="tr" title="우측 상단">↗</button>
          <button type="button" data-ed-float-corner="bl" title="좌측 하단">↙</button>
          <button type="button" data-ed-float-corner="br" title="우측 하단">↘</button>
        </div>
        <p class="ed-float-tools__dock-label">아이콘 배치</p>
        <div class="ed-float-tools__dock-grid ed-float-tools__dock-grid--orient">
          <button type="button" data-ed-float-orient="horizontal" title="가로 배치">⇔ 가로</button>
          <button type="button" data-ed-float-orient="vertical" title="세로 배치">⇕ 세로</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="ed-hidden-file" data-lu-image-pick>
  <InputFile OnChange="OnImageFile" accept="image/*" />
</div>

@code {
    private readonly record struct ToolItem(EditorTool Tool, ObjectType? Type, string Icon, string Label, string Tut);

    /// <summary>
    /// 도구 아이콘을 그대로 내보낸다. 글자 아이콘과 SVG 그림을 섞어 쓰기 때문이다.
    /// 값은 모두 아래 Tools 에 박아 둔 상수여서 바깥에서 들어온 글이 섞일 일이 없다.
    /// </summary>
    private static MarkupString IconMarkup(ToolItem item) => new(item.Icon);

    /// <summary>바코드 아이콘. 굵기가 다른 막대로 실제 바코드처럼 보이게 한다.</summary>
    private const string BarcodeIcon =
        "<svg class='ed-float-tools__gico' viewBox='0 0 16 16' aria-hidden='true'>"
        + "<path fill='currentColor' d='M1.5 2.5h1.4v11H1.5V2.5Zm2.4 0h1v11h-1V2.5Zm2 0h2v11h-2V2.5Zm3 0h1v11h-1V2.5Zm2 0h1.4v11h-1.4V2.5Zm2.4 0h1.2v11h-1.2V2.5Z'/></svg>";

    /// <summary>QR 아이콘. 모서리 눈 세 개와 오른쪽 아래 점으로 QR 느낌을 낸다.</summary>
    private const string QrIcon =
        "<svg class='ed-float-tools__gico' viewBox='0 0 16 16' aria-hidden='true'>"
        + "<path fill='currentColor' fill-rule='evenodd' d='M1 1h5.5v5.5H1V1Zm1.4 1.4v2.7h2.7V2.4H2.4ZM9.5 1H15v5.5H9.5V1Z"
        + "m1.4 1.4v2.7h2.7V2.4h-2.7ZM1 9.5h5.5V15H1V9.5Zm1.4 1.4v2.7h2.7v-2.7H2.4Zm7.1-1.4h2.2v2.2H9.5V9.5Z"
        + "m3.3 0H15v2.2h-2.2V9.5Zm-3.3 3.3h2.2V15H9.5v-2.2Zm3.3 0H15V15h-2.2v-2.2Z'/></svg>";

    /// <summary>이미지 아이콘. 사진틀 안에 해와 산을 넣은 흔한 그림 기호다.</summary>
    private const string ImageIcon =
        "<svg class='ed-float-tools__gico' viewBox='0 0 16 16' aria-hidden='true'>"
        + "<path fill='currentColor' fill-rule='evenodd' d='M2.4 2h11.2c.8 0 1.4.6 1.4 1.4v9.2c0 .8-.6 1.4-1.4 1.4H2.4c-.8 0-1.4-.6-1.4-1.4V3.4C1 2.6 1.6 2 2.4 2Zm0 1.4v9.2h11.2V3.4H2.4Z'/>"
        + "<path fill='currentColor' d='M5.3 5.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4Z'/>"
        + "<path fill='currentColor' d='M2.9 11.6h10.2L10 7.6l-2.2 2.6-1.4-1.3-3.5 2.7Z'/></svg>";

    private static readonly ToolItem[] Tools =
    [
        new(EditorTool.Select, null, "↖", "선택", "tool-select"),
        new(EditorTool.Text, ObjectType.Text, "T", "텍스트", "tool-text"),
        new(EditorTool.Barcode, ObjectType.Barcode, BarcodeIcon, "바코드", "tool-barcode"),
        new(EditorTool.Qr, ObjectType.Qr, QrIcon, "QR", "tool-qr"),
        new(EditorTool.Image, ObjectType.Image, ImageIcon, "이미지", "tool-image"),
        new(EditorTool.Table, ObjectType.Table, "▦", "표", "tool-table"),
        new(EditorTool.Clipart, ObjectType.Clipart, "★", "클립아트", "tool-clipart")
    ];

    private static readonly (ShapeKind Kind, string Icon, string Label)[] Shapes =
    [
        (ShapeKind.Rect, "▭", "사각형"),
        (ShapeKind.RoundRect, "▢", "둥근 사각형"),
        (ShapeKind.Circle, "○", "원"),
        (ShapeKind.Triangle, "△", "삼각형"),
        (ShapeKind.Ellipse, "⬭", "타원"),
        (ShapeKind.Line, "／", "선"),
        (ShapeKind.Arrow, "→", "화살표"),
        (ShapeKind.Polygon, "⬠", "정다각형"),
        (ShapeKind.Star, "★", "별"),
        (ShapeKind.Trapezoid, "⏢", "사다리꼴"),
        (ShapeKind.Parallelogram, "▱", "평행사변형")
    ];

    private bool HasSelectedTheme
    {
        get
        {
            var name = Session.Document.Name?.Trim();
            return !string.IsNullOrWhiteSpace(name) && name is not "새 라벨 디자인";
        }
    }

    private string ThemeTitleFull => HasSelectedTheme ? Session.Document.Name.Trim() : "템플릿선택";

    private string ThemeTitle => HasSelectedTheme ? TruncateDisplay(ThemeTitleFull, 8) : "";

    private static string TruncateDisplay(string text, int maxChars)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxChars) return text;
        return string.Concat(text.AsSpan(0, maxChars), "...");
    }

    private string ThemeMeta
    {
        get
        {
            var paper = Session.Document.Paper;
            var shape = paper.Shape?.Kind switch
            {
                "ellipse" => "원형",
                "roundrect" => "라운드",
                _ => "사각형"
            };
            return $"{shape} · {paper.LabelWidthMm:0.#}×{paper.LabelHeightMm:0.#} mm";
        }
    }

    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task OnTool(ToolItem item)
    {
        Session.ShapeMenuOpen = false;
        if (item.Tool == EditorTool.Select || item.Type is null)
        {
            Session.SetTool(EditorTool.Select);
            return;
        }

        Session.SetTool(item.Tool);
        Session.PendingInsert = item.Type;
        switch (item.Type)
        {
            case ObjectType.Text:
                History.Push(Session.Document);
                Session.PlaceDefault(ObjectType.Text);
                break;
            case ObjectType.Barcode:
                Session.OpenDialog(EditorDialog.Barcode);
                break;
            case ObjectType.Qr:
                Session.OpenDialog(EditorDialog.Qr);
                break;
            case ObjectType.Image:
                await Js.InvokeVoidAsync("labelUpEditor.clickSelector", "[data-lu-image-pick] input");
                break;
            case ObjectType.Table:
                Session.OpenDialog(EditorDialog.Table);
                break;
            case ObjectType.Clipart:
                Session.ClipartTab = "clipart";
                Session.OpenDialog(EditorDialog.Clipart);
                break;
        }
    }

    private void ToggleShapeMenu()
    {
        Session.ShapeMenuOpen = !Session.ShapeMenuOpen;
        Session.Notify();
    }

    private void CloseShapeMenu()
    {
        Session.ShapeMenuOpen = false;
        Session.Notify();
    }

    private void PlaceShape(ShapeKind kind)
    {
        History.Push(Session.Document);
        Session.PlaceShape(kind);
        Session.ShapeMenuOpen = false;
        Session.Notify();
    }

    private async Task OpenProjects()
    {
        var loggedIn = await Cloud.EnsureLoggedInForSaveAsync();
        if (!loggedIn)
        {
            Session.Status = "로그인하면 저장된 프로젝트를 불러올 수 있어요";
            Session.Notify();
            return;
        }
        Session.OpenDialog(EditorDialog.ProjectPicker);
    }

    private void OpenDataCreate() => Session.RequestDataCreate();

    private Task OnDataFile(InputFileChangeEventArgs e)
        => DataImportActions.ImportAsync(
            Session, DataImport, History, e.File,
            async () =>
            {
                await InvokeAsync(StateHasChanged);
                await Task.Delay(1);
            });

    private async Task OnImageFile(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file.Size > 8 * 1024 * 1024)
            {
                Session.Status = "이미지는 8MB 이하만 가능";
                Session.Notify();
                return;
            }
            await using var stream = file.OpenReadStream(8 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var b64 = Convert.ToBase64String(bytes);
            var mime = file.ContentType is { Length: > 0 } ? file.ContentType : "image/png";
            History.Push(Session.Document);
            Session.PlaceImage($"data:{mime};base64,{b64}", bytes);
            Session.PendingInsert = null;
            Session.Status = "이미지 추가됨";
            Session.Notify();
        }
        catch (Exception ex)
        {
            EditorLog.Error("이미지 추가 실패", ex);
            Session.Status = "이미지 추가 실패: " + ex.Message;
            Session.Notify();
        }
    }
}
