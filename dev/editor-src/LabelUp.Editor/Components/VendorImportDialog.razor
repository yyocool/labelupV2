@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@inject HistoryService History
@implements IDisposable

@if (Session.Dialog == EditorDialog.VendorImport && Session.PendingVendorImport is { } r)
{
  <div class="ed-modal" role="dialog" aria-label="타사 포맷 변환 분석" @onclick="Cancel">
    <div class="ed-modal__card ed-modal__card--wide ed-vendor-report" @onclick:stopPropagation="true">
      <header class="ed-modal__head">
        <div>
          <h3>타사 포맷 변환 분석</h3>
          <p>변환하기 전에 인식된 회사·용지·데이터·항목을 확인합니다.</p>
        </div>
        <button type="button" class="ed-modal__close" @onclick="Cancel">×</button>
      </header>
      <div class="ed-modal__body">
        <dl class="ed-vendor-report__grid">
          <div>
            <dt>파일</dt>
            <dd>@r.FileName</dd>
          </div>
          <div>
            <dt>회사</dt>
            <dd>@(string.IsNullOrWhiteSpace(r.VendorName) ? "판별 실패" : r.VendorName)</dd>
          </div>
          <div>
            <dt>용지 번호</dt>
            <dd>@(string.IsNullOrWhiteSpace(r.PaperNo) ? "-" : r.PaperNo)
              @if (!string.IsNullOrWhiteSpace(r.PaperName))
              {
                <span class="ed-vendor-report__muted">@r.PaperName</span>
              }
            </dd>
          </div>
          <div>
            <dt>용지 구성</dt>
            <dd>@(string.IsNullOrWhiteSpace(r.PaperLayout) ? "-" : r.PaperLayout)</dd>
          </div>
        </dl>

        <section class="ed-vendor-report__block">
          <h4>데이터</h4>
          @if (r.HasData)
          {
            <p>연결됨 · @r.DataRows 행 · 열 @string.Join(", ", r.DataColumns)</p>
            @if (r.DataPreview.Count > 0)
            {
              <ul>
                @foreach (var line in r.DataPreview)
                {
                  <li>@line</li>
                }
              </ul>
            }
          }
          else
          {
            <p class="ed-vendor-report__muted">연결된 데이터가 없습니다.</p>
          }
        </section>

        <section class="ed-vendor-report__block">
          <h4>분석된 항목 (@r.ObjectCount)</h4>
          @if (r.TypeCounts.Count > 0)
          {
            <p class="ed-vendor-report__counts">
              @foreach (var kv in r.TypeCounts)
              {
                <span>@kv.Key @kv.Value</span>
              }
            </p>
          }
          @if (r.Items.Count > 0)
          {
            <ul class="ed-vendor-report__items">
              @foreach (var item in r.Items.Take(40))
              {
                <li><b>@item.Kind</b> @item.Summary <em>@item.Geometry</em></li>
              }
            </ul>
            @if (r.Items.Count > 40)
            {
              <p class="ed-vendor-report__muted">외 @(r.Items.Count - 40)개</p>
            }
          }
          else
          {
            <p class="ed-vendor-report__muted">인식된 디자인 항목이 없습니다.</p>
          }
        </section>

        @if (!r.Ok)
        {
          <p class="ed-vendor-report__error">변환 실패: @r.Error</p>
        }
      </div>
      <footer class="ed-modal__foot">
        <button type="button" class="ed-btn" @onclick="Cancel">취소</button>
        <button type="button" class="ed-btn ed-btn--primary" disabled="@(!r.Ok || r.Document is null)" @onclick="Apply">변환하기</button>
      </footer>
    </div>
  </div>
}

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Cancel()
    {
        Session.PendingVendorImport = null;
        Session.CloseDialog();
    }

    private void Apply()
    {
        var r = Session.PendingVendorImport;
        if (r?.Document is null)
        {
            Session.Status = "변환할 문서가 없습니다";
            Session.Notify();
            return;
        }
        History.Push(Session.Document);
        Session.ReplaceDocument(r.Document);
        Session.PendingVendorImport = null;
        Session.Status = $"{r.VendorName} 변환 완료 · {r.PaperNo} · 항목 {r.ObjectCount}개";
        Session.CloseDialog();
    }
}
