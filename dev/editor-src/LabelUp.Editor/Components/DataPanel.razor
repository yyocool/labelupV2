@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@inject HistoryService History
@inject IJSRuntime Js
@implements IDisposable

@if (Session.DataPanelVisible && Session.Document.Data is { } data)
{
  var preview = data.Rows.Take(3).ToList();
  <aside class="ed-data-panel @(Session.DataPanelExpanded ? "is-expanded" : "is-mini")"
         style="@HeightStyle"
         data-ed-data-panel
         aria-label="데이터 패널">
    @* 위쪽 선을 잡고 위아래로 끌어 판넬을 키우고 줄인다. 넉넉해지면 고쳐 쓰는 표로 바뀐다. *@
    <div class="ed-data-panel__grip" data-ed-data-grip
         title="위아래로 끌어 데이터 판넬 크기를 조절합니다"></div>
    <div class="ed-data-panel__bar">
      <strong>데이터</strong>
      <span>@data.ColumnCount 열 · @data.RowCount 행@(data.SourceName.Length > 0 ? $" · {data.SourceName}" : "")</span>
      @if (Session.DataPanelExpanded)
      {
        @* 모든 열을 라벨에 올리고 나면 「라벨에 추가」 창이 더 열리지 않는다.
           그 뒤에도 첫 줄을 넣고 뺄 수 있게 여기에도 둔다. *@
        @if (data.CanUseFirstRowAsData)
        {
          <label class="ed-data-panel__firstrow" title="머리글 없이 첫 줄부터 기록이 적힌 파일이면 켜세요">
            <input type="checkbox" checked="@data.FirstRowIsData" @onchange="e => SetFirstRow(data, e)" />
            파일 첫 줄도 자료로
          </label>
        }
        <button type="button" class="ed-btn" @onclick="AddRow">행 추가</button>
        <button type="button" class="ed-btn" @onclick="AddColumn">열 추가</button>
        <button type="button" class="ed-btn ed-btn--primary" @onclick="Minimize">최소화</button>
      }
    </div>

    <div class="ed-data-panel__table-wrap">
      <table class="ed-data-table ed-data-table--panel">
        <thead>
          <tr>
            @if (Session.DataPanelExpanded)
            {
              <th class="ed-data-table__idx">#</th>
            }
            @* 「라벨에 추가」는 두 모습 모두에 둔다. 예전에는 미리보기에만 있어서, 판넬을 키워
               고쳐 쓰는 표로 바꾸고 나면 열을 라벨에 올릴 길이 사라졌다. *@
            @for (var c = 0; c < data.Columns.Count; c++)
            {
              var ci = c;
              var col = data.Columns[ci];
              var onLabel = Session.Document.HasBoundColumn(col);
              <th>
                <div class="ed-data-colhead">
                  <em>@col</em>
                  <span class="ed-data-colhead__acts">
                    @if (onLabel)
                    {
                      <span class="ed-data-colhead__on">추가됨</span>
                    }
                    else
                    {
                      <button type="button" class="ed-data-colhead__add" @onclick="() => AskBind(col)">라벨에 추가</button>
                    }
                    @if (Session.DataPanelExpanded)
                    {
                      <button type="button" class="ed-data-colhead__del" title="이 열을 지웁니다"
                              disabled="@(data.Columns.Count <= 1)"
                              @onclick="() => DeleteColumn(data, ci)">열 삭제</button>
                    }
                  </span>
                </div>
              </th>
            }
            @if (Session.DataPanelExpanded)
            {
              <th></th>
            }
          </tr>
        </thead>
        <tbody>
          @if (Session.DataPanelExpanded)
          {
            @for (var r = 0; r < data.Rows.Count; r++)
            {
              var row = r;
              @* 번호 칸이 그대로 끌기 손잡이다. 칸 안에 글을 고치는 상자가 들어 있어
                 행 아무 데나 잡게 두면 글을 고르려는 끌기와 구별되지 않는다. *@
              <tr data-ed-row="@row">
                <td class="ed-data-table__idx ed-data-table__idx--handle" data-ed-row-handle
                    title="끌어서 행 차례를 바꿉니다">@(row + 1)</td>
                @for (var c = 0; c < data.Columns.Count; c++)
                {
                  var col = c;
                  <td>
                    <input id="@CellId(row, col)"
                           class="@(IsBoundColumn(data, col) ? "is-bound" : null)"
                           value="@data.Get(row, data.Columns[col])"
                           @onchange="e => EditCell(data, row, col, e)" />
                  </td>
                }
                <td><button type="button" class="ed-btn" @onclick="() => DeleteRow(data, row)">삭제</button></td>
              </tr>
            }
          }
          else
          {
            @foreach (var row in preview)
            {
              <tr>
                @for (var c = 0; c < data.Columns.Count; c++)
                {
                  <td>@(c < row.Count ? row[c] : "")</td>
                }
              </tr>
            }
            @if (preview.Count == 0)
            {
              <tr>
                <td colspan="@Math.Max(1, data.ColumnCount)" class="ed-data-panel__empty">행이 없습니다. 판넬 위쪽 선을 위로 끌어 행을 추가하세요.</td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>

  </aside>
}

@code {
    private DotNetObjectReference<DataPanel>? _self;

    protected override void OnInitialized() => Session.Changed += OnChanged;

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        _self?.Dispose();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// 끌어 놓기로 자료 행 차례를 바꾼다. <paramref name="toIndex"/> 는 끌던 행을 빼낸 뒤에
    /// 세는 자리 번호다. 행 차례가 곧 라벨 차례라 되돌리기 단계를 남긴다.
    /// </summary>
    [JSInvokable]
    public void ReorderDataRows(int fromIndex, int toIndex)
    {
        if (fromIndex == toIndex) return;
        if (Session.Document.Data is not { } data) return;
        if (fromIndex < 0 || fromIndex >= data.RowCount) return;
        History.Push(Session.Document);
        if (!Session.MoveDataRow(fromIndex, toIndex))
            EditorLog.Warn($"자료 행 순서 변경 실패 {fromIndex}→{toIndex}");
    }

    /// <summary>칸마다 붙는 아이디. 자료연결 항목을 더블클릭했을 때 이 아이디로 커서를 보낸다.</summary>
    private static string CellId(int row, int col) => $"lu-dcell-{row}-{col}";

    /// <summary>라벨에 올라간 열인지. 표에서 눈에 띄게 하려고 표시한다.</summary>
    private bool IsBoundColumn(DataSheet data, int col)
        => col >= 0 && col < data.Columns.Count && Session.Document.HasBoundColumn(data.Columns[col]);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            try { await Js.InvokeVoidAsync("labelUpEditor.bindDataRowDrag", _self); }
            catch (Exception ex) { EditorLog.Warn("자료 행 드래그 연결 실패: " + ex.Message); }
        }
        if (Session.FocusDataCell is not { } at) return;
        Session.FocusDataCell = null;
        if (!Session.DataPanelVisible || !Session.DataPanelExpanded) return;
        try
        {
            await Js.InvokeVoidAsync("labelUpEditor.focusSelect", "#" + CellId(at.Row, at.Col));
        }
        catch (Exception ex)
        {
            EditorLog.Warn("데이터 칸으로 커서 옮기기 실패: " + ex.Message);
        }
    }

    /// <summary>
    /// 끌어서 정한 높이. 아직 정한 적이 없으면 비워 두고 CSS 에 적힌 기본 높이를 그대로 쓴다.
    /// max-height 를 풀어 주는 까닭은, 기본값으로 걸린 168px·50vh 위로도 끌어 올릴 수 있어야 해서다.
    /// </summary>
    private string? HeightStyle => Session.DataPanelHeight > 0
        ? $"height:{Session.DataPanelHeight}px;max-height:none"
        : null;

    /// <summary>높이를 기본값으로 되돌려 한 번에 접는다. 선을 끝까지 끌어내리는 수고를 던다.</summary>
    private void Minimize()
    {
        Session.DataPanelExpanded = false;
        Session.DataPanelHeight = 0;
        Session.SyncDataLabels();
        Session.Dirty = true;
        Session.Notify();
    }

    private void AskBind(string column)
    {
        Session.PendingBindColumn = column;
        Session.OpenDialog(EditorDialog.ColumnBind);
    }

    private void EditCell(DataSheet data, int row, int col, ChangeEventArgs e)
    {
        data.SetCell(row, col, e.Value?.ToString() ?? "");
        Session.Dirty = true;
        Session.Notify();
    }

    private void DeleteRow(DataSheet data, int row)
    {
        History.Push(Session.Document);
        data.RemoveRow(row);
        Session.SyncDataLabels();
        Session.Dirty = true;
        Session.Status = "데이터 행을 삭제했습니다";
        Session.Notify();
    }

    /// <summary>파일 첫 줄을 자료로 쓸지 바꾼다. 라벨 칸 수가 한 칸 늘거나 준다.</summary>
    private void SetFirstRow(DataSheet data, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        if (!data.CanUseFirstRowAsData || on == data.FirstRowIsData) return;
        History.Push(Session.Document);
        data.SetFirstRowIsData(on);
        Session.SyncDataLabels();
        Session.Dirty = true;
        Session.Status = on
            ? "파일 첫 줄을 1행 자료로 넣었습니다"
            : "파일 첫 줄을 열 이름으로만 씁니다";
        Session.Notify();
    }

    private void AddRow()
    {
        if (Session.Document.Data is not { } data) return;
        History.Push(Session.Document);
        data.AddRow();
        Session.SyncDataLabels();
        Session.Dirty = true;
        Session.Notify();
    }

    /// <summary>
    /// 빈 열을 하나 붙인다. 새 열은 아직 라벨에 올라가 있지 않으므로 라벨 수는 그대로다.
    /// 이름은 자료표가 겹치지 않게 지어 준다.
    /// </summary>
    private void AddColumn()
    {
        if (Session.Document.Data is not { } data) return;
        History.Push(Session.Document);
        var name = data.AddColumn();
        Session.Dirty = true;
        Session.Status = $"‘{name}’ 열을 추가했습니다";
        Session.Notify();
    }

    /// <summary>
    /// 열 하나를 지운다. 라벨에 올라가 있는 열이면 그 항목이 모든 라벨에서 함께 사라지므로
    /// 먼저 묻는다. 되돌리기로 되살릴 수 있지만, 묻지 않고 지우기에는 잃는 것이 크다.
    /// 마지막 한 열은 남겨 둔다. 열이 하나도 없는 자료표는 판넬에 보일 것이 없다.
    /// </summary>
    private async Task DeleteColumn(DataSheet data, int col)
    {
        if (col < 0 || col >= data.Columns.Count) return;
        if (data.Columns.Count <= 1)
        {
            Session.Status = "열이 하나뿐이라 지울 수 없습니다";
            Session.Notify();
            return;
        }
        var name = data.Columns[col];
        if (Session.Document.HasBoundColumn(name) && !await Confirm(
                $"‘{name}’ 열을 지우면 이 열을 쓰는 라벨 항목이 모든 라벨에서 함께 사라집니다.\n지울까요?"))
            return;
        History.Push(Session.Document);
        Session.RemoveDataColumn(col);
    }

    private async Task<bool> Confirm(string message)
    {
        try
        {
            return await Js.InvokeAsync<bool>("confirm", message);
        }
        catch (Exception ex)
        {
            EditorLog.Warn("열 삭제 확인 창을 띄우지 못했습니다: " + ex.Message);
            return false;
        }
    }
}
