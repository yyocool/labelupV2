@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@inject HistoryService History
@implements IDisposable

@if (Session.DataPanelVisible && Session.Document.Data is { } data)
{
  var start = Session.DataPage * Session.DataPageSize;
  var pageRows = data.Rows.Skip(start).Take(Session.DataPanelExpanded ? Session.DataPageSize : 1).ToList();
  var pageCount = Math.Max(1, (int)Math.Ceiling(data.RowCount / (double)Session.DataPageSize));
  <aside class="ed-data-panel @(Session.DataPanelExpanded ? "is-expanded" : null)" aria-label="데이터 패널">
    <div class="ed-data-panel__bar">
      <strong>데이터</strong>
      <span>@data.RowCount 행 · 더블클릭 또는 드래그하여 라벨에 넣기</span>
      <button type="button" class="ed-btn" @onclick="OpenManager">관리</button>
      <button type="button" class="ed-btn" @onclick="Toggle">@(Session.DataPanelExpanded ? "접기" : "펼치기")</button>
    </div>
    <div class="ed-data-panel__table-wrap">
      <table class="ed-data-table ed-data-table--panel">
        <thead>
          <tr>
            @foreach (var col in data.Columns)
            {
              <th>@col</th>
            }
          </tr>
        </thead>
        <tbody>
          @foreach (var row in pageRows)
          {
            <tr>
              @for (var c = 0; c < data.Columns.Count; c++)
              {
                var colName = data.Columns[c];
                var val = c < row.Count ? row[c] : "";
                <td draggable="true"
                    @ondblclick="() => Place(colName)"
                    @ondragstart="e => OnDrag(e, colName)"
                    title="더블클릭 또는 드래그">
                  @val
                </td>
              }
            </tr>
          }
        </tbody>
      </table>
    </div>
    @if (Session.DataPanelExpanded && pageCount > 1)
    {
      <div class="ed-data-panel__pager">
        <button type="button" @onclick="() => Session.DataPage = Math.Max(0, Session.DataPage - 1)">‹</button>
        <span>@(Session.DataPage + 1) / @pageCount</span>
        <button type="button" @onclick="() => Session.DataPage = Math.Min(pageCount - 1, Session.DataPage + 1)">›</button>
      </div>
    }
  </aside>
}

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OpenManager()
    {
        Session.DataManagerMinimized = false;
        Session.OpenDialog(EditorDialog.DataManager);
    }

    private void Toggle()
    {
        Session.DataPanelExpanded = !Session.DataPanelExpanded;
        Session.Notify();
    }

    private void Place(string column)
    {
        History.Push(Session.Document);
        Session.PlaceBoundText(column);
        Session.Notify();
    }

    private void OnDrag(DragEventArgs e, string column)
    {
        Session.DragColumn = column;
    }
}
