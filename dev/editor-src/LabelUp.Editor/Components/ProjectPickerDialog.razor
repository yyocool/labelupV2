@using LabelUp.Editor.Models
@using LabelUp.Editor.Services
@inject EditorSession Session
@inject EditorCloudStorage Cloud
@inject HistoryService History
@inject IJSRuntime Js
@implements IDisposable

@if (Session.Dialog == EditorDialog.ProjectPicker)
{
  <div class="ed-modal" role="dialog" aria-label="프로젝트 불러오기" @onclick="Session.CloseDialog">
    <div class="ed-modal__card ed-modal__card--papers" @onclick:stopPropagation="true">
      <header class="ed-modal__head">
        <div>
          <h3>프로젝트 불러오기</h3>
          <p>계정에 저장한 라벨 작업을 골라 이어서 편집할 수 있습니다.</p>
        </div>
        <button type="button" class="ed-modal__close" @onclick="Session.CloseDialog">×</button>
      </header>

      <div class="ed-paper-toolbar">
        <input class="ed-paper-search" type="search" placeholder="프로젝트 이름 검색"
               @bind="_query" @bind:event="oninput" />
        <span class="ed-paper-count">@Filtered.Count() / @_items.Count</span>
      </div>

      <div class="ed-modal__body ed-paper-grid ed-project-grid">
        @if (_loading)
        {
          <p class="ed-paper-empty">저장된 작업을 불러오는 중…</p>
        }
        else if (!string.IsNullOrWhiteSpace(_error) && _items.Count == 0)
        {
          <p class="ed-paper-empty">@_error</p>
        }
        else if (!Filtered.Any())
        {
          <p class="ed-paper-empty">@(string.IsNullOrWhiteSpace(_query) ? "저장된 프로젝트가 없습니다. 편집기에서 저장하면 여기에 모입니다." : "검색 결과가 없습니다.")</p>
        }
        else
        {
          @foreach (var item in Filtered)
          {
            var active = Session.WorkspaceId == item.Id;
            <div class="ed-paper-card ed-project-card @(active ? "is-active" : null)" data-workspace-id="@item.Id">
              <div class="ed-project-card__preview" @onclick="() => OpenAsync(item)">
                @if (!string.IsNullOrWhiteSpace(item.PreviewUrl))
                {
                  <img src="@item.PreviewUrl" alt="@item.Title" />
                }
                else
                {
                  <span>라벨</span>
                }
              </div>
              <div class="ed-paper-card__meta">
                <strong>@item.Title</strong>
                <span>@(string.IsNullOrWhiteSpace(item.UpdatedLabel) ? item.UpdatedAt : item.UpdatedLabel)</span>
              </div>
              <div class="ed-project-card__acts">
                <button type="button" class="ed-btn ed-btn--primary" disabled="@_opening" @onclick="() => OpenAsync(item)">불러오기</button>
                <button type="button" class="ed-btn" disabled="@_opening" @onclick="() => CopyAsync(item)">복사하기</button>
              </div>
            </div>
          }
        }
      </div>
    </div>
  </div>
}

@code {
    private string _query = "";
    private bool _loading;
    private bool _tried;
    private bool _opening;
    private string? _error;
    private IReadOnlyList<EditorWorkspaceListItem> _items = [];

    private IEnumerable<EditorWorkspaceListItem> Filtered =>
        string.IsNullOrWhiteSpace(_query)
            ? _items
            : _items.Where(i => (i.Title ?? "").Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Session.Dialog != EditorDialog.ProjectPicker)
        {
            _tried = false;
            return;
        }
        if (!_tried && !_loading)
        {
            _tried = true;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            _items = await Cloud.ListWorkspacesAsync(48);
            if (_items.Count == 0)
                _error = "저장된 프로젝트가 없습니다. 편집기에서 저장하면 여기에 모입니다.";
        }
        catch (Exception ex)
        {
            _error = "프로젝트 목록을 불러오지 못했습니다.";
            EditorLog.Warn("프로젝트 목록 실패: " + ex.Message);
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private const string CopySuffix = "-복사";

    private async Task<bool> ConfirmLeaveAsync(string question)
    {
        if (!Session.Dirty) return true;
        try
        {
            return await Js.InvokeAsync<bool>("confirm", "저장하지 않은 내용이 있습니다. " + question);
        }
        catch
        {
            return true;
        }
    }

    private async Task<EditorWorkspacePayload?> FetchAsync(EditorWorkspaceListItem item)
    {
        var workspace = await Cloud.LoadWorkspaceAsync(item.Id);
        if (workspace?.Document is null)
        {
            Session.Status = "저장된 작업을 찾지 못했습니다";
            Session.ShowError("불러오기 실패", $"「{item.Title}」 작업 내용을 읽지 못했습니다.");
            return null;
        }
        if (workspace.Id <= 0)
            workspace.Id = item.Id;
        if (string.IsNullOrWhiteSpace(workspace.Title))
            workspace.Title = item.Title;
        return workspace;
    }

    private async Task OpenAsync(EditorWorkspaceListItem item)
    {
        if (_opening || item.Id <= 0) return;
        if (!await ConfirmLeaveAsync("이 프로젝트를 불러올까요?")) return;

        _opening = true;
        try
        {
            var workspace = await FetchAsync(item);
            if (workspace is null) return;
            History.Push(Session.Document);
            await Cloud.ApplyLoadedWorkspaceAsync(Session, workspace);
            Session.CloseDialog();
        }
        catch (Exception ex)
        {
            EditorLog.Warn("프로젝트 불러오기 실패: " + ex.Message);
            Session.Status = "프로젝트를 불러오지 못했습니다";
            Session.Notify();
        }
        finally
        {
            _opening = false;
        }
    }

    /// <summary>원본은 그대로 두고, 같은 내용을 「이름-복사」라는 새 프로젝트로 저장한 뒤 그것을 연다.</summary>
    private async Task CopyAsync(EditorWorkspaceListItem item)
    {
        if (_opening || item.Id <= 0) return;
        if (!await ConfirmLeaveAsync("이 프로젝트를 복사해서 열까요?")) return;

        _opening = true;
        try
        {
            var workspace = await FetchAsync(item);
            if (workspace?.Document is null) return;
            var baseTitle = (string.IsNullOrWhiteSpace(workspace.Title) ? workspace.Document.Name : workspace.Title).Trim();
            if (baseTitle.Length > 200 - CopySuffix.Length)
                baseTitle = baseTitle[..(200 - CopySuffix.Length)];
            var title = baseTitle + CopySuffix;
            workspace.Document.Name = title;
            workspace.Title = title;
            workspace.Id = 0;

            History.Push(Session.Document);
            await Cloud.ApplyLoadedWorkspaceAsync(Session, workspace);
            object? ui = workspace.Ui is { ValueKind: System.Text.Json.JsonValueKind.Object } u ? u : null;
            var newId = await Cloud.SaveWorkspaceAsync(
                Session.Document, ui, DesignSaveService.CapturePreview(Session), null);
            if (newId <= 0)
                throw new InvalidOperationException("새 프로젝트 번호를 받지 못했습니다.");
            Session.WorkspaceId = newId;
            Session.Dirty = false;
            Session.Status = $"「{title}」(으)로 복사해서 불러왔습니다";
            Session.CloseDialog();
            Session.Notify();
        }
        catch (Exception ex)
        {
            EditorLog.Warn("프로젝트 복사 실패: " + ex.Message);
            Session.Dirty = true;
            Session.ShowError("복사 실패", "프로젝트를 복사하지 못했습니다.\n" + EditorSession.FriendlyError(ex));
        }
        finally
        {
            _opening = false;
        }
    }
}
