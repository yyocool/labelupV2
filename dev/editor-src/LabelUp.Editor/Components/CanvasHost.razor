@using LabelUp.Editor.Models
@using LabelUp.Editor.Rendering
@using LabelUp.Editor.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using SkiaSharp
@using SkiaSharp.Views.Blazor
@inject EditorSession Session
@inject HistoryService History
@inject IJSRuntime Js
@implements IDisposable

<div class="canvas-stage"
     @ref="_stageRef"
     @onpointerdown="OnPointerDown"
     @onpointermove="OnPointerMove"
     @onpointerup="OnPointerUp"
     @onpointerleave="OnPointerLeave"
     @onwheel="OnWheel"
     @ondrop="OnDrop"
     @ondrop:preventDefault="true"
     @ondragover:preventDefault="true"
     @oncontextmenu="OnContextMenu"
     @oncontextmenu:preventDefault="true"
     @oncontextmenu:stopPropagation="true">
  @{
    var frame = LabelFrame();
    var rTop = frame.Oy - Gap - Ruler;
    var rLeft = frame.Ox - Gap - Ruler;
  }
  <div class="canvas-stage__skia"
       style="@($"left:{frame.Ox:0.##}px;top:{frame.Oy:0.##}px;width:{Math.Max(8, frame.LabelW):0.##}px;height:{Math.Max(8, frame.LabelH):0.##}px")">
    <SKCanvasView @ref="_view"
                  class="skia-view"
                  IgnorePixelScaling="true"
                  OnPaintSurface="OnPaintSurface" />
  </div>
  <div class="ed-guides" aria-hidden="true">
    <div class="ed-guides__h" style="@($"left:{frame.Ox:0.##}px;top:{rTop:0.##}px;width:{frame.LabelW:0.##}px")">
      @foreach (var mark in RulerMarks(Session.Document.WidthMm, frame.Scale))
      {
        <i class="ed-guides__tick @(mark.Is10 ? "is-10" : mark.Is5 ? "is-5" : null)" style="@($"left:{mark.Pos:0.##}px")"></i>
        @if (mark.Is10)
        {
          <em class="ed-guides__num" style="@($"left:{mark.Pos + 2:0.##}px")">@($"{mark.Mm:0}")</em>
        }
      }
      <strong class="ed-guides__size">@($"{Session.Document.WidthMm:0.#}×{Session.Document.HeightMm:0.#} mm")</strong>
    </div>
    <div class="ed-guides__v" style="@($"left:{rLeft:0.##}px;top:{frame.Oy:0.##}px;height:{frame.LabelH:0.##}px")">
      @foreach (var mark in RulerMarks(Session.Document.HeightMm, frame.Scale))
      {
        <i class="ed-guides__tick ed-guides__tick--v @(mark.Is10 ? "is-10" : mark.Is5 ? "is-5" : null)" style="@($"top:{mark.Pos:0.##}px")"></i>
        @if (mark.Is10)
        {
          <em class="ed-guides__num ed-guides__num--v" style="@($"top:{mark.Pos + 2:0.##}px")">@($"{mark.Mm:0}")</em>
        }
      }
    </div>
    <div class="ed-guides__corner" style="@($"left:{rLeft:0.##}px;top:{rTop:0.##}px")"></div>
  </div>
  @if (_ctxOpen)
  {
    var hasSel = Session.SelectedIds.Count > 0;
    <div class="ed-ctx" style="@($"left:{_ctxX}px;top:{_ctxY}px")" @onpointerdown:stopPropagation="true" @oncontextmenu:preventDefault="true">
      <button type="button" disabled="@(!hasSel)" @onclick="CtxDelete">항목삭제</button>
      <button type="button" disabled="@(!hasSel)" @onclick="CtxCopy">항목 복사</button>
      <button type="button" @onclick="CtxPaste">붙여넣기</button>
      <button type="button" disabled="@(!hasSel)" @onclick="CtxSendBack">맨 뒤로 이동</button>
      <button type="button" disabled="@(!hasSel)" @onclick="CtxBringFront">맨 앞으로 이동</button>
    </div>
  }
</div>

@code {
    private SKCanvasView? _view;
    private ElementReference _stageRef;
    private float _viewW = 800;
    private float _viewH = 600;
    private float _stageX;
    private float _stageY;

    private bool _dragging;
    private bool _marquee;
    private bool _paintFailed;
    private HandleKind _handle = HandleKind.None;
    private float _lastX, _lastY;
    private float _startDocX, _startDocY;
    private List<DesignObject> _dragStarts = [];
    private bool _historyPushed;
    private float _mx1, _my1, _mx2, _my2;
    private bool _ctxOpen;
    private float _ctxX, _ctxY;
    private const float Ruler = EditorSession.RulerPx;
    private const float Gap = EditorSession.RulerGapPx;

    private bool _ctxBlocked;
    private bool _skipRender;
    private DotNetObjectReference<CanvasHost>? _self;

    protected override bool ShouldRender()
    {
        if (!_skipRender) return true;
        _skipRender = false;
        return false;
    }

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;
    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        _self?.Dispose();
        _self = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            try { await Js.InvokeVoidAsync("labelUpEditor.bindCanvasStage", _stageRef, _self); }
            catch { }
        }
        if (_ctxBlocked) return;
        try
        {
            await Js.InvokeVoidAsync("labelUpEditor.blockContextMenu", ".canvas-stage");
            _ctxBlocked = true;
        }
        catch
        {
            // JS가 아직 없으면 다음 렌더에서 재시도
        }
    }

    [JSInvokable]
    public void OnStageSize(int w, int h, double x = 0, double y = 0)
    {
        if (w < 80 || h < 80) return;
        _stageX = (float)x;
        _stageY = (float)y;
        var changed = Math.Abs(w - _viewW) >= 2 || Math.Abs(h - _viewH) >= 2;
        _viewW = w;
        _viewH = h;
        if (Session.PendingFit && _viewW >= 360 && _viewH >= 220)
        {
            Session.FitToView(_viewW, _viewH);
            return;
        }
        if (!changed) return;
        _view?.Invalidate();
        InvokeAsync(StateHasChanged);
    }

    private (float X, float Y) StagePoint(MouseEventArgs e)
        => ((float)e.OffsetX, (float)e.OffsetY);

    private (float X, float Y) StagePoint(DragEventArgs e)
        => ((float)e.OffsetX, (float)e.OffsetY);

    private void OnContextMenu(MouseEventArgs e)
    {
        var p = StagePoint(e);
        _ctxX = p.X;
        _ctxY = p.Y;
        _ctxOpen = true;
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (Session.PendingFit && _viewW >= 360 && _viewH >= 220)
            {
                Session.FitToView(_viewW, _viewH);
                return;
            }
            _view?.Invalidate();
            StateHasChanged();
        });
    }

    public void Invalidate() => _view?.Invalidate();

    private (float Ox, float Oy, float Scale, float LabelW, float LabelH) LabelFrame()
    {
        var scale = Session.PxPerMm * Session.Zoom;
        var labelW = Session.Document.WidthMm * scale;
        var labelH = Session.Document.HeightMm * scale;
        var pad = Ruler + Gap + 8f;
        var ox = Math.Max(pad, (_viewW - labelW) / 2f);
        var oy = Math.Max(pad, (_viewH - labelH) / 2f);
        return (ox, oy, scale, labelW, labelH);
    }

    private sealed class RulerMark
    {
        public float Mm;
        public float Pos;
        public bool Is10;
        public bool Is5;
    }

    private IEnumerable<RulerMark> RulerMarks(float mmMax, float scale)
    {
        var step = RulerStep(Session.Zoom);
        for (var mm = 0f; mm <= mmMax + 0.01f; mm += step)
        {
            yield return new RulerMark
            {
                Mm = mm,
                Pos = mm * scale,
                Is10 = Math.Abs(mm % 10f) < 0.01f,
                Is5 = Math.Abs(mm % 5f) < 0.01f
            };
        }
    }

    private void OnPaintSurface(SKPaintSurfaceEventArgs e)
    {
        var canvas = e.Surface.Canvas;
        var info = e.Info;
        try
        {
            PaintSurfaceCore(canvas, info);
            _paintFailed = false;
        }
        catch (Exception ex)
        {
            EditorLog.Error("캔버스 그리기 실패", ex);
            try
            {
                canvas.Clear(new SKColor(0xF4, 0xF1, 0xEE));
            }
            catch { /* ignore */ }
            if (!_paintFailed)
            {
                _paintFailed = true;
                Session.ShowError("화면 오류", EditorSession.FriendlyError(ex));
            }
        }
    }

    private void PaintSurfaceCore(SKCanvas canvas, SKImageInfo info)
    {
        canvas.Clear(new SKColor(0xF4, 0xF1, 0xEE));

        var doc = Session.Document;
        var scale = Session.PxPerMm * Session.Zoom;
        if (info.Width > 8 && doc.WidthMm > 0.01f)
            scale = info.Width / doc.WidthMm;
        var labelW = doc.WidthMm * scale;
        var labelH = doc.HeightMm * scale;

        canvas.Save();
        canvas.Scale(scale);
        DocumentRenderer.DrawCell(
            canvas,
            doc,
            Session.CurrentCell,
            o => Session.ResolveObjectText(o),
            afterBackground: () =>
            {
                if (!Session.ShowGrid)
                    return;
                DrawLabelGridMm(canvas, doc.WidthMm, doc.HeightMm);
            });
        foreach (var sel in Session.SelectedObjects)
            DocumentRenderer.DrawSelection(canvas, sel, Session.PxPerMm, Session.Zoom);
        canvas.Restore();

        if (_marquee)
            DrawMarquee(canvas, 0, 0, scale);
    }

    private static float RulerStep(float zoom)
        => zoom >= 1.4f ? 1f : zoom >= 0.7f ? 2f : 5f;

    private void DrawLabelGridMm(SKCanvas canvas, float mmW, float mmH)
    {
        var step = RulerStep(Session.Zoom);
        var stroke = Math.Max(0.08f, 1f / Math.Max(0.5f, Session.PxPerMm * Session.Zoom));
        using var minor = new SKPaint
        {
            Color = new SKColor(0x7B, 0x28, 0x40, 55),
            StrokeWidth = stroke,
            IsAntialias = false,
            Style = SKPaintStyle.Stroke
        };
        using var mid = new SKPaint
        {
            Color = new SKColor(0x7B, 0x28, 0x40, 90),
            StrokeWidth = stroke,
            IsAntialias = false,
            Style = SKPaintStyle.Stroke
        };
        using var major = new SKPaint
        {
            Color = new SKColor(0x7B, 0x28, 0x40, 140),
            StrokeWidth = stroke * 1.25f,
            IsAntialias = false,
            Style = SKPaintStyle.Stroke
        };
        for (var mm = 0f; mm <= mmW + 0.01f; mm += step)
            canvas.DrawLine(mm, 0, mm, mmH, GridPaint(mm, minor, mid, major));
        for (var mm = 0f; mm <= mmH + 0.01f; mm += step)
            canvas.DrawLine(0, mm, mmW, mm, GridPaint(mm, minor, mid, major));
    }

    private void DrawLabelGrid(SKCanvas canvas, float ox, float oy, float scale, float labelW, float labelH, float mmW, float mmH)
    {
        var step = RulerStep(Session.Zoom);
        canvas.Save();
        canvas.ClipRect(new SKRect(ox, oy, ox + labelW, oy + labelH));
        using var minor = new SKPaint
        {
            Color = new SKColor(0x7B, 0x28, 0x40, 55),
            StrokeWidth = 1f,
            IsAntialias = false,
            Style = SKPaintStyle.Stroke
        };
        using var mid = new SKPaint
        {
            Color = new SKColor(0x7B, 0x28, 0x40, 90),
            StrokeWidth = 1f,
            IsAntialias = false,
            Style = SKPaintStyle.Stroke
        };
        using var major = new SKPaint
        {
            Color = new SKColor(0x7B, 0x28, 0x40, 140),
            StrokeWidth = 1.25f,
            IsAntialias = false,
            Style = SKPaintStyle.Stroke
        };
        for (var mm = 0f; mm <= mmW + 0.01f; mm += step)
        {
            var x = ox + mm * scale;
            canvas.DrawLine(x, oy, x, oy + labelH, GridPaint(mm, minor, mid, major));
        }
        for (var mm = 0f; mm <= mmH + 0.01f; mm += step)
        {
            var y = oy + mm * scale;
            canvas.DrawLine(ox, y, ox + labelW, y, GridPaint(mm, minor, mid, major));
        }
        canvas.Restore();
    }

    private static SKPaint GridPaint(float mm, SKPaint minor, SKPaint mid, SKPaint major)
    {
        if (Math.Abs(mm % 10f) < 0.01f) return major;
        if (Math.Abs(mm % 5f) < 0.01f) return mid;
        return minor;
    }

    private void DrawRulers(SKCanvas canvas, float ox, float oy, float scale, float labelW, float labelH, float mmW, float mmH)
    {
        var rulerBottom = oy - Gap;
        var rulerRight = ox - Gap;
        var rulerTop = rulerBottom - Ruler;
        var rulerLeft = rulerRight - Ruler;

        using (var desk = new SKPaint { Color = new SKColor(0xFF, 0xFF, 0xFF, 230), IsAntialias = true })
            canvas.DrawRoundRect(rulerLeft - 6, rulerTop - 6, labelW + Ruler + Gap + 12, labelH + Ruler + Gap + 12, 8, 8, desk);
        using (var deskLine = new SKPaint
        {
            Color = new SKColor(0xC9, 0xB8, 0xB0),
            IsAntialias = true,
            Style = SKPaintStyle.Stroke,
            StrokeWidth = 1
        })
            canvas.DrawRoundRect(rulerLeft - 6, rulerTop - 6, labelW + Ruler + Gap + 12, labelH + Ruler + Gap + 12, 8, 8, deskLine);

        using var bg = new SKPaint { Color = new SKColor(0xFF, 0xFF, 0xFF), IsAntialias = true };
        canvas.DrawRect(ox, rulerTop, labelW, Ruler, bg);
        canvas.DrawRect(rulerLeft, oy, Ruler, labelH, bg);
        using var corner = new SKPaint { Color = new SKColor(0xF3, 0xE8, 0xEC), IsAntialias = true };
        canvas.DrawRect(rulerLeft, rulerTop, Ruler, Ruler, corner);
        using var frame = new SKPaint
        {
            Color = new SKColor(0x7B, 0x28, 0x40, 160),
            Style = SKPaintStyle.Stroke,
            StrokeWidth = 1.2f,
            IsAntialias = true
        };
        canvas.DrawRect(ox, rulerTop, labelW, Ruler, frame);
        canvas.DrawRect(rulerLeft, oy, Ruler, labelH, frame);
        canvas.DrawRect(rulerLeft, rulerTop, Ruler, Ruler, frame);
        using var edge = new SKPaint { Color = new SKColor(0x7B, 0x28, 0x40, 90), StrokeWidth = 1 };
        canvas.DrawLine(ox, rulerBottom, ox + labelW, rulerBottom, edge);
        canvas.DrawLine(rulerRight, oy, rulerRight, oy + labelH, edge);

        using var tick = new SKPaint { Color = new SKColor(0x4A, 0x44, 0x40), StrokeWidth = 1, IsAntialias = false };
        using var major = new SKPaint { Color = new SKColor(0x2E, 0x2A, 0x27), StrokeWidth = 1.4f, IsAntialias = false };
        using var font = new SKFont(DocumentRenderer.ResolveTypeface(false), 10);
        using var text = new SKPaint { Color = new SKColor(0x2E, 0x2A, 0x27), IsAntialias = true };

        var step = RulerStep(Session.Zoom);
        for (var mm = 0f; mm <= mmW + 0.01f; mm += step)
        {
            var x = ox + mm * scale;
            var is10 = Math.Abs(mm % 10f) < 0.01f;
            var is5 = Math.Abs(mm % 5f) < 0.01f;
            var len = is10 ? 14f : is5 ? 10f : 6f;
            canvas.DrawLine(x, rulerBottom - len, x, rulerBottom, is10 ? major : tick);
            if (is10)
                canvas.DrawText($"{mm:0}", x + 2, rulerTop + 12, SKTextAlign.Left, font, text);
        }
        for (var mm = 0f; mm <= mmH + 0.01f; mm += step)
        {
            var y = oy + mm * scale;
            var is10 = Math.Abs(mm % 10f) < 0.01f;
            var is5 = Math.Abs(mm % 5f) < 0.01f;
            var len = is10 ? 14f : is5 ? 10f : 6f;
            canvas.DrawLine(rulerRight - len, y, rulerRight, y, is10 ? major : tick);
            if (is10)
            {
                canvas.Save();
                canvas.Translate(rulerLeft + 11, y - 2);
                canvas.RotateDegrees(-90);
                canvas.DrawText($"{mm:0}", 0, 0, SKTextAlign.Left, font, text);
                canvas.Restore();
            }
        }

        using var dim = new SKPaint { Color = new SKColor(0x7B, 0x28, 0x40, 180), IsAntialias = true };
        using var dimFont = new SKFont(DocumentRenderer.ResolveTypeface(true), 10);
        canvas.DrawText($"{mmW:0.#}×{mmH:0.#} mm", ox + 8, rulerTop + 18, SKTextAlign.Left, dimFont, dim);
    }

    private void DrawMarquee(SKCanvas canvas, float ox, float oy, float scale)
    {
        var x = ox + Math.Min(_mx1, _mx2) * scale;
        var y = oy + Math.Min(_my1, _my2) * scale;
        var w = Math.Abs(_mx2 - _mx1) * scale;
        var h = Math.Abs(_my2 - _my1) * scale;
        using var fill = new SKPaint { Color = new SKColor(0x7B, 0x28, 0x40, 28), IsAntialias = true };
        using var stroke = new SKPaint
        {
            Color = new SKColor(0x7B, 0x28, 0x40, 200),
            Style = SKPaintStyle.Stroke,
            StrokeWidth = 1,
            IsAntialias = true
        };
        canvas.DrawRect(x, y, w, h, fill);
        canvas.DrawRect(x, y, w, h, stroke);
    }

    private void DrawGuides(SKCanvas canvas, float ox, float oy, float scale, float labelW, float labelH)
    {
        var px = ox + Session.CursorMmX * scale;
        var py = oy + Session.CursorMmY * scale;
        var rulerBottom = oy - Gap;
        var rulerRight = ox - Gap;
        var rulerTop = rulerBottom - Ruler;
        var rulerLeft = rulerRight - Ruler;
        using var gray = new SKPaint
        {
            Color = new SKColor(0x9A, 0x90, 0x88, 160),
            StrokeWidth = 1,
            IsAntialias = false
        };
        canvas.DrawLine(px, rulerBottom, px, py, gray);
        canvas.DrawLine(rulerRight, py, px, py, gray);

        using var red = new SKPaint { Color = new SKColor(0xC4, 0x28, 0x3A, 230), StrokeWidth = 2, IsAntialias = true };
        canvas.DrawLine(px, rulerTop + 1, px, rulerBottom, red);
        canvas.DrawLine(rulerLeft + 1, py, rulerRight, py, red);

        using var font = new SKFont(DocumentRenderer.ResolveTypeface(true), 9);
        using var tp = new SKPaint { Color = new SKColor(0xC4, 0x28, 0x3A), IsAntialias = true };
        canvas.DrawText($"{Session.CursorMmX:0.0}", px + 4, rulerTop + 12, SKTextAlign.Left, font, tp);
        canvas.Save();
        canvas.Translate(rulerLeft + 12, py - 4);
        canvas.RotateDegrees(-90);
        canvas.DrawText($"{Session.CursorMmY:0.0}", 0, 0, SKTextAlign.Left, font, tp);
        canvas.Restore();
    }

    private (float DocX, float DocY) ScreenToDoc(float sx, float sy)
    {
        var (ox, oy, scale, _, _) = LabelFrame();
        return ((sx - ox) / scale, (sy - oy) / scale);
    }

    private bool OverLabel(float docX, float docY)
        => docX >= 0 && docY >= 0 && docX <= Session.Document.WidthMm && docY <= Session.Document.HeightMm;

    private void OnPointerDown(PointerEventArgs e)
    {
        _ctxOpen = false;
        var p = StagePoint(e);
        _lastX = p.X;
        _lastY = p.Y;
        var (dx, dy) = ScreenToDoc(_lastX, _lastY);
        _startDocX = dx;
        _startDocY = dy;
        _historyPushed = false;

        if (e.Button == 2)
        {
            _ctxX = _lastX;
            _ctxY = _lastY;
            _ctxOpen = true;
            return;
        }

        if (e.Button != 0) return;

        if (Session.Selected is { } sel)
        {
            var h = HitTest.HitHandle(sel, dx, dy, Session.Zoom);
            if (h != HandleKind.None && h != HandleKind.Move && !sel.Locked)
            {
                _handle = h;
                _dragging = true;
                _dragStarts = [sel.Clone()];
                return;
            }
        }

        var hit = HitTest.HitObject(Session.CurrentCell.Objects, dx, dy);
        if (hit != null)
        {
            if (e.ShiftKey || e.CtrlKey)
                Session.ToggleSelect(hit.Id);
            else if (!Session.SelectedIds.Contains(hit.Id))
                Session.Select(hit.Id);

            if (!hit.Locked)
            {
                _handle = HandleKind.Move;
                _dragging = true;
                _dragStarts = Session.SelectedObjects.Select(o => o.Clone()).ToList();
            }
            return;
        }

        if (!e.ShiftKey && !e.CtrlKey)
            Session.ClearSelection();
        _marquee = true;
        _mx1 = _mx2 = dx;
        _my1 = _my2 = dy;
        Session.Notify();
    }

    private void OnDrop(DragEventArgs e)
    {
        var col = Session.DragColumn;
        Session.DragColumn = null;
        if (string.IsNullOrWhiteSpace(col)) return;
        var p = StagePoint(e);
        var (dx, dy) = ScreenToDoc(p.X, p.Y);
        History.Push(Session.Document);
        Session.PlaceBoundText(col, dx, dy);
        Session.Notify();
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        _skipRender = true;
        var p = StagePoint(e);
        var x = p.X;
        var y = p.Y;
        var (dx, dy) = ScreenToDoc(x, y);
        Session.CursorMmX = dx;
        Session.CursorMmY = dy;
        Session.CursorOverLabel = OverLabel(dx, dy);

        if (_marquee)
        {
            _mx2 = dx;
            _my2 = dy;
            _view?.Invalidate();
            return;
        }

        if (!_dragging || _dragStarts.Count == 0)
            return;

        if (!_historyPushed)
        {
            History.Push(Session.Document);
            _historyPushed = true;
        }

        if (_handle == HandleKind.Move)
        {
            var ddx = dx - _startDocX;
            var ddy = dy - _startDocY;
            foreach (var start in _dragStarts)
            {
                var live = Session.CurrentCell.Objects.FirstOrDefault(o => o.Id == start.Id);
                if (live is null || live.Locked) continue;
                live.X = start.X + ddx;
                live.Y = start.Y + ddy;
            }
        }
        else if (Session.Selected is { } sel && _dragStarts[0] is { } origin)
        {
            if (_handle == HandleKind.Rotate)
            {
                var cx = origin.X + origin.Width / 2f;
                var cy = origin.Y + origin.Height / 2f;
                sel.Rotation = MathF.Atan2(dy - cy, dx - cx) * 180f / MathF.PI + 90f;
            }
            else
            {
                HitTest.ApplyResize(sel, _handle, dx, dy, _startDocX, _startDocY, origin);
            }
        }

        Session.Dirty = true;
        _view?.Invalidate();
    }

    private void OnPointerLeave(PointerEventArgs e)
    {
        Session.CursorOverLabel = false;
        OnPointerUp(e);
        _view?.Invalidate();
    }

    private void OnPointerUp(PointerEventArgs e)
    {
        if (_marquee)
        {
            var tiny = Math.Abs(_mx2 - _mx1) < 0.35f && Math.Abs(_my2 - _my1) < 0.35f;
            if (!tiny)
            {
                var ids = Session.CurrentCell.Objects
                    .Where(o => o.Visible && HitTest.Intersects(o, _mx1, _my1, _mx2, _my2))
                    .Select(o => o.Id)
                    .ToList();
                Session.SelectMany(ids);
            }
            else
            {
                Session.Notify();
            }
        }
        else if (_dragging)
        {
            Session.Notify();
        }

        _dragging = false;
        _marquee = false;
        _handle = HandleKind.None;
        _dragStarts.Clear();
    }

    private void OnWheel(WheelEventArgs e)
    {
        var delta = e.DeltaY < 0 ? 0.08f : -0.08f;
        Session.SetZoom(Session.Zoom + delta);
    }

    private void CtxDelete()
    {
        _ctxOpen = false;
        if (Session.SelectedIds.Count == 0) return;
        History.Push(Session.Document);
        Session.DeleteSelection();
    }

    private void CtxCopy()
    {
        _ctxOpen = false;
        Session.CopySelection();
    }

    private void CtxPaste()
    {
        _ctxOpen = false;
        History.Push(Session.Document);
        Session.PasteClipboard();
    }

    private void CtxSendBack()
    {
        _ctxOpen = false;
        if (Session.SelectedIds.Count == 0) return;
        History.Push(Session.Document);
        Session.SendSelectionToBack();
    }

    private void CtxBringFront()
    {
        _ctxOpen = false;
        if (Session.SelectedIds.Count == 0) return;
        History.Push(Session.Document);
        Session.BringSelectionToFront();
    }
}
