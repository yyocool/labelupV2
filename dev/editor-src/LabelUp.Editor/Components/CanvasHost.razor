    }

    private void CtxClearColFill()
    {
        if (_ctxTable is null || _ctxCell is not { } cell) return;
        History.Push(Session.Document);
        _ctxTable.SetTableColFill(cell.Col, null);
        Session.Dirty = true;
        Session.Notify();
    }

    private void CtxSetStroke(ChangeEventArgs e)
    {
        if (_ctxTable is null) return;
        History.Push(Session.Document);
        _ctxTable.Stroke = ColorUtil.ToHtmlColor(e.Value?.ToString(), "#000000");
        Session.Dirty = true;
        Session.Notify();
    }

    private void CtxSetBorderWidth(ChangeEventArgs e)
    {
        if (_ctxTable is null) return;
        if (!float.TryParse(e.Value?.ToString(), out var w)) return;
        History.Push(Session.Document);
        _ctxTable.TableBorderWidth = Math.Clamp(w, 0.08f, 4f);
        Session.Dirty = true;
        Session.Notify();
    }

    private void CtxDelete()
    {
        _ctxOpen = false;
        SelectionActions.DeleteSelection(Session, History);
    }

    private void CtxCopy()
    {
        _ctxOpen = false;
        Session.CopySelection();
    }

    private void CtxPaste()
    {
        _ctxOpen = false;
        History.Push(Session.Document);
        Session.PasteClipboard();
    }

    private void CtxSendBack()
    {
        _ctxOpen = false;
        if (Session.SelectedIds.Count == 0) return;
        History.Push(Session.Document);
        Session.SendSelectionToBack();
    }

    private void CtxBringFront()
    {
        _ctxOpen = false;
        if (Session.SelectedIds.Count == 0) return;
        History.Push(Session.Document);
        Session.BringSelectionToFront();
    }
}
