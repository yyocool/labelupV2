@using LabelUp.Editor.Models
@using LabelUp.Editor.Rendering
@using LabelUp.Editor.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using SkiaSharp
@using SkiaSharp.Views.Blazor
@inject EditorSession Session
@inject HistoryService History
@inject FontCatalog Fonts
@inject IJSRuntime Js
@implements IDisposable

<div class="canvas-stage"
     @ref="_stageRef"
     @onpointerdown="OnPointerDown"
     @onpointermove="OnPointerMove"
     @onpointerup="OnPointerUp"
     @onpointerleave="OnPointerLeave"
     @ondblclick="OnDoubleClick"
     @onwheel="OnWheel"
     @ondrop="OnDrop"
     @ondrop:preventDefault="true"
     @ondragover:preventDefault="true"
     @oncontextmenu="OnContextMenu"
     @oncontextmenu:preventDefault="true"
     @oncontextmenu:stopPropagation="true">
  @{
    var frame = LabelFrame();
    var rTop = frame.Oy - Gap - Ruler;
    var rLeft = frame.Ox - Gap - Ruler;
    // 라벨 밖으로 나간 항목까지 보이도록 그림판만 사방으로 넓힌다. 자·안내선과 좌표 계산은
    // 그대로 라벨 왼쪽 위(Ox, Oy)를 기준으로 두므로 다른 곳은 손댈 것이 없다.
    var bleedXPx = frame.BleedX * frame.Scale;
    var bleedYPx = frame.BleedY * frame.Scale;
  }
  <div class="canvas-stage__skia"
       style="@($"left:{frame.Ox - bleedXPx:0.##}px;top:{frame.Oy - bleedYPx:0.##}px;width:{Math.Max(8, frame.LabelW + bleedXPx * 2f):0.##}px;height:{Math.Max(8, frame.LabelH + bleedYPx * 2f):0.##}px")">
    <SKCanvasView @ref="_view"
                  class="skia-view"
                  IgnorePixelScaling="true"
                  OnPaintSurface="OnPaintSurface" />
  </div>
  <div class="canvas-stage__frame"
       style="@($"left:{frame.Ox:0.##}px;top:{frame.Oy:0.##}px;width:{Math.Max(8, frame.LabelW):0.##}px;height:{Math.Max(8, frame.LabelH):0.##}px")"
       aria-hidden="true"></div>
  <div class="ed-guides" aria-hidden="true">
    <div class="ed-guides__h" style="@($"left:{frame.Ox:0.##}px;top:{rTop:0.##}px;width:{frame.LabelW:0.##}px")">
      @foreach (var mark in RulerMarks(Session.Document.WidthMm, frame.Scale))
      {
        <i class="ed-guides__tick @(mark.Is10 ? "is-10" : mark.Is5 ? "is-5" : null)" style="@($"left:{mark.Pos:0.##}px")"></i>
        @if (mark.Is10)
        {
          <em class="ed-guides__num" style="@($"left:{mark.Pos + 2:0.##}px")">@($"{mark.Mm:0}")</em>
        }
      }
      <strong class="ed-guides__size">@($"{Session.Document.WidthMm:0.#}×{Session.Document.HeightMm:0.#} mm")</strong>
    </div>
    <div class="ed-guides__v" style="@($"left:{rLeft:0.##}px;top:{frame.Oy:0.##}px;height:{frame.LabelH:0.##}px")">
      @foreach (var mark in RulerMarks(Session.Document.HeightMm, frame.Scale))
      {
        <i class="ed-guides__tick ed-guides__tick--v @(mark.Is10 ? "is-10" : mark.Is5 ? "is-5" : null)" style="@($"top:{mark.Pos:0.##}px")"></i>
        @if (mark.Is10)
        {
          <em class="ed-guides__num ed-guides__num--v" style="@($"top:{mark.Pos + 2:0.##}px")">@($"{mark.Mm:0}")</em>
        }
      }
    </div>
    <div class="ed-guides__corner" style="@($"left:{rLeft:0.##}px;top:{rTop:0.##}px")"></div>
  </div>
  @if (InlineEdit is { } editing)
  {
    var style = InlineEditStyle(editing, frame.Ox, frame.Oy, frame.Scale);
    <div class="ed-inline-edit"
         style="@style.Outer"
         title="내용 편집 중 — Esc 취소, 바깥을 누르면 완료"
         @onpointerdown:stopPropagation="true"
         @onpointermove:stopPropagation="true"
         @onpointerup:stopPropagation="true"
         @ondblclick:stopPropagation="true"
         @onwheel:stopPropagation="true"
         @onkeydown="OnInlineKeyDown">
      <div @ref="_inlineRef" class="ed-inline-edit__doc" style="@style.Inner"></div>
    </div>
  }
  @if (_ctxOpen)
  {
    var hasSel = Session.SelectedIds.Count > 0;
    <div class="ed-ctx" style="@($"left:{_ctxX}px;top:{_ctxY}px")" @onpointerdown:stopPropagation="true" @oncontextmenu:preventDefault="true">
      @if (_ctxTable is { } table)
      {
        table.EnsureTableSize();
        <div class="ed-ctx__cap">@( _ctxCell is { } loc ? $"표 {loc.Row + 1}행 {loc.Col + 1}열" : "표" )</div>
        @if (_ctxCell is { } cell)
        {
          <label class="ed-ctx__row">
            이 셀 배경
            <input type="color" value="@ColorUtil.ToHtmlColor(table.GetTableCellFill(cell.Row, cell.Col), CtxWhite)" @onchange="e => CtxSetCellFill(e)" />
            <button type="button" class="ed-ctx__clear" @onclick="CtxClearCellFill">지우기</button>
          </label>
          <label class="ed-ctx__row">
            이 행 배경
            <input type="color" value="@ColorUtil.ToHtmlColor(table.TableRowFills.ElementAtOrDefault(cell.Row), CtxWhite)" @onchange="e => CtxSetRowFill(e)" />
            <button type="button" class="ed-ctx__clear" @onclick="CtxClearRowFill">지우기</button>
          </label>
          <label class="ed-ctx__row">
            이 열 배경
            <input type="color" value="@ColorUtil.ToHtmlColor(table.TableColFills.ElementAtOrDefault(cell.Col), CtxWhite)" @onchange="e => CtxSetColFill(e)" />
            <button type="button" class="ed-ctx__clear" @onclick="CtxClearColFill">지우기</button>
          </label>
        }
        <label class="ed-ctx__row">
          테두리 색
          <input type="color" value="@ColorUtil.ToHtmlColor(table.Stroke, CtxBlack)" @onchange="e => CtxSetStroke(e)" />
        </label>
        <label class="ed-ctx__row">
          테두리 굵기
          <input type="number" min="0.08" max="4" step="0.05" value="@table.TableBorderWidth.ToString("0.##")" @onchange="e => CtxSetBorderWidth(e)" />
        </label>
        <div class="ed-ctx__sep"></div>
      }
      <button type="button" disabled="@(!hasSel)" @onclick="CtxDelete">항목삭제</button>
      <button type="button" disabled="@(!hasSel)" @onclick="CtxCopy">항목 복사</button>
      <button type="button" @onclick="CtxPaste">붙여넣기</button>
      <button type="button" disabled="@(!hasSel)" @onclick="CtxSendBack">맨 뒤로 이동</button>
      <button type="button" disabled="@(!hasSel)" @onclick="CtxBringFront">맨 앞으로 이동</button>
    </div>
  }
</div>

@code {
    private SKCanvasView? _view;
    private ElementReference _stageRef;
    private float _viewW = 800;
    private float _viewH = 600;
    private float _stageX;
    private float _stageY;

    private bool _dragging;
    private bool _marquee;
    private bool _paintFailed;
    private HandleKind _handle = HandleKind.None;
    private float _lastX, _lastY;
    private float _startDocX, _startDocY;
    private List<DesignObject> _dragStarts = [];
    private bool _historyPushed;
    private float _mx1, _my1, _mx2, _my2;
    private bool _ctxOpen;
    private float _ctxX, _ctxY;
    private DesignObject? _ctxTable;
    private (int Row, int Col)? _ctxCell;
    private const float Ruler = EditorSession.RulerPx;
    private const float Gap = EditorSession.RulerGapPx;

    private bool _ctxBlocked;
    private string? _cursorKind;
    private bool _skipRender;
    private DotNetObjectReference<CanvasHost>? _self;
    private int _longPressGen;
    private bool _gestureLock;
    private bool _touchPointer;

    protected override bool ShouldRender()
    {
        if (!_skipRender) return true;
        _skipRender = false;
        return false;
    }

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;
    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        CancelLongPress();
        _self?.Dispose();
        _self = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            try { await Js.InvokeVoidAsync("labelUpEditor.bindCanvasStage", _stageRef, _self); }
            catch { }
        }
        if (_inlineId is not null && !_inlineBound)
        {
            _inlineBound = true;
            try
            {
                await Js.InvokeVoidAsync("labelUpEditor.richText.bind", _inlineRef, _self);
                await Js.InvokeVoidAsync("labelUpEditor.richText.setHtml", _inlineRef, InlineEditHtml());
                await Js.InvokeVoidAsync("labelUpEditor.richText.focusEnd", _inlineRef);
            }
            catch (Exception ex)
            {
                EditorLog.Error("캔버스 글 편집기 연결 실패", ex);
            }
        }

        if (_ctxBlocked) return;
        try
        {
            await Js.InvokeVoidAsync("labelUpEditor.blockContextMenu", ".canvas-stage");
            _ctxBlocked = true;
        }
        catch
        {
            // JS가 아직 없으면 다음 렌더에서 재시도
        }
    }

    [JSInvokable]
    public void OnStageSize(int w, int h, double x = 0, double y = 0)
    {
        if (w < 80 || h < 80) return;
        _stageX = (float)x;
        _stageY = (float)y;
        var changed = Math.Abs(w - _viewW) >= 2 || Math.Abs(h - _viewH) >= 2;
        _viewW = w;
        _viewH = h;
        if (Session.PendingFit && _viewW >= 360 && _viewH >= 220)
        {
            Session.FitToView(_viewW, _viewH);
            return;
        }
        if (!changed) return;
        _view?.Invalidate();
        InvokeAsync(StateHasChanged);
    }

    private (float X, float Y) StagePoint(MouseEventArgs e)
        => ((float)e.OffsetX, (float)e.OffsetY);

    /// <summary>
    /// 손잡이 위 커서 이름. 회전 손잡이는 돌림 표, 크기 손잡이는 그 손잡이가 실제로 늘리는
    /// 방향의 양쪽 화살표다. 방향은 항목 회전각을 더해 고르므로 기울어진 항목에서도 맞는다.
    /// </summary>
    private static string? CursorFor(DesignObject obj, HandleKind handle)
    {
        if (handle == HandleKind.Rotate) return "rotate";

        var baseAngle = handle switch
        {
            HandleKind.E or HandleKind.W => 0f,
            HandleKind.Se or HandleKind.Nw => 45f,
            HandleKind.S or HandleKind.N => 90f,
            HandleKind.Ne or HandleKind.Sw => 135f,
            _ => float.NaN
        };
        if (float.IsNaN(baseAngle)) return null;

        var a = (baseAngle + obj.Rotation) % 180f;
        if (a < 0) a += 180f;
        if (a < 22.5f) return "ew";
        if (a < 67.5f) return "nwse";
        if (a < 112.5f) return "ns";
        if (a < 157.5f) return "nesw";
        return "ew";
    }

    private void SetCursor(string? kind)
    {
        if (string.Equals(_cursorKind, kind, StringComparison.Ordinal)) return;
        _cursorKind = kind;
        _ = Js.InvokeVoidAsync("labelUpEditor.setCanvasCursor", kind ?? "");
    }

    private void UpdateHoverCursor(float docX, float docY)
    {
        if (_touchPointer) { SetCursor(null); return; }
        if (Session.Selected is not { } sel || sel.Locked) { SetCursor(null); return; }
        var h = HitTest.HitHandle(sel, docX, docY, Session.Zoom);
        SetCursor(h is HandleKind.None or HandleKind.Move ? null : CursorFor(sel, h));
    }

    private bool IsCoarsePointer()
        => _viewW > 0 && _viewW <= 920;

    private float TouchPadMm()
    {
        var scale = Math.Max(0.2f, Session.PxPerMm * Session.Zoom);
        return 14f / scale;
    }

    [JSInvokable]
    public void OnGestureZoomPan(float zoom, float panX, float panY)
    {
        _gestureLock = true;
        CancelLongPress();
        _dragging = false;
        _marquee = false;
        _handle = HandleKind.None;
        Session.Zoom = Math.Clamp(zoom, EditorSession.MinZoom, EditorSession.MaxZoom);
        Session.PanX = panX;
        Session.PanY = panY;
        _view?.Invalidate();
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public float[] GetViewState()
        => [Session.Zoom, Session.PanX, Session.PanY];

    [JSInvokable]
    public void OnGestureEnd()
    {
        _gestureLock = false;
        Session.Notify();
    }

    private (float X, float Y) StagePoint(DragEventArgs e)
        => ((float)e.OffsetX, (float)e.OffsetY);

    private void OnContextMenu(MouseEventArgs e)
    {
        var p = StagePoint(e);
        OpenContextAt(p.X, p.Y);
    }

    private void OpenContextAt(float sx, float sy)
    {
        _ctxX = sx;
        _ctxY = sy;
        var (dx, dy) = ScreenToDoc(sx, sy);
        var hit = HitTest.HitObject(Session.CurrentCell.Objects, dx, dy);
        if (hit != null && !Session.SelectedIds.Contains(hit.Id))
            Session.Select(hit.Id);
        _ctxTable = hit is { Type: ObjectType.Table } ? hit
            : Session.Selected is { Type: ObjectType.Table } selected ? selected
            : null;
        _ctxCell = _ctxTable is null ? null : HitTest.HitTableCell(_ctxTable, dx, dy);
        _ctxOpen = true;
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(() =>
        {
            CloseInlineIfStale();
            if (Session.PendingFit && _viewW >= 360 && _viewH >= 220)
            {
                Session.FitToView(_viewW, _viewH);
                return;
            }
            _view?.Invalidate();
            StateHasChanged();
        });
    }

    public void Invalidate() => _view?.Invalidate();

    // ── 캔버스에서 바로 글 고치기 ─────────────────────────────────────────────
    // 글상자를 더블클릭하면 그 자리에 HTML 편집기를 얹는다. 속성바가 쓰는 것과 같은
    // richText 편집기라 구간 서식(글꼴·색·기울기)이 그대로 남는다.

    private ElementReference _inlineRef;
    private string? _inlineId;
    private DesignObject? _inlineSnapshot;
    private bool _inlineHistory;
    private bool _inlineBound;

    /// <summary>1mm가 CSS 픽셀 몇 개인지(96dpi). pt로 적힌 글자 크기를 mm에 맞추는 데 쓴다.</summary>
    private const float CssPxPerMm = 96f / 25.4f;

    /// <summary>지금 캔버스에서 내용을 고치고 있는 글상자.</summary>
    private DesignObject? InlineEdit
        => _inlineId is null
            ? null
            : Session.CurrentCell.Objects.FirstOrDefault(o => o.Id == _inlineId);

    /// <summary>더블클릭으로 바로 고칠 수 있는 글상자인지.</summary>
    private static bool CanEditInline(DesignObject obj)
        => obj.Type == ObjectType.Text
           && !obj.Locked
           && !obj.DataBound
           && obj.TextMode != TextMode.Custom;

    private void OnDoubleClick(MouseEventArgs e)
    {
        var p = StagePoint(e);
        var (dx, dy) = ScreenToDoc(p.X, p.Y);
        var hit = HitTest.HitObject(Session.CurrentCell.Objects, dx, dy, _touchPointer ? 1.6f : 0.8f);
        if (hit is null)
            return;
        if (hit.DataBound)
        {
            // 값이 자료표에서 오는 항목은 데이터 판넬을 펼쳐 그 칸에서 고치게 한다.
            Session.Select(hit.Id);
            Session.OpenDataCellFor(hit);
            return;
        }
        if (hit.Type is ObjectType.Barcode or ObjectType.Qr)
        {
            BeginValueEdit(hit);
            return;
        }
        if (hit.Type != ObjectType.Text)
            return;
        if (!CanEditInline(hit))
        {
            // 자료연결 항목은 위에서 이미 판넬로 보냈다.
            Session.Status = hit.Locked
                ? "잠긴 항목은 고칠 수 없습니다"
                : "사용자정의 항목은 속성바에서 바꿔주세요";
            Session.Notify();
            return;
        }
        BeginInlineEdit(hit);
    }

    /// <summary>
    /// 바코드·QR은 캔버스에 글을 얹어 고칠 수 없다(값이 바뀌면 막대를 다시 그려야 한다).
    /// 대신 그 항목을 고르고 속성바 내용 칸으로 커서를 보내 바로 타 넣게 한다.
    /// </summary>
    private void BeginValueEdit(DesignObject obj)
    {
        if (obj.Locked)
        {
            Session.Status = "잠긴 항목은 고칠 수 없습니다";
            Session.Notify();
            return;
        }
        var what = obj.Type == ObjectType.Qr ? "QR" : "바코드";
        Session.FocusValueObjectId = obj.Id;
        Session.Select(obj.Id);
        Session.Status = $"{what} 내용 편집 — 속성바 내용 칸에 타 주세요";
        Session.Notify();
    }

    private void BeginInlineEdit(DesignObject obj)
    {
        if (_inlineId == obj.Id) return;
        Session.Select(obj.Id);
        _inlineId = obj.Id;
        // Esc 로 되돌릴 사본. 고친 내용은 타는 즉시 모델에 들어가므로 취소에는 사본이 필요하다.
        _inlineSnapshot = obj.Clone();
        _inlineHistory = false;
        _inlineBound = false;
        _dragging = false;
        _marquee = false;
        _handle = HandleKind.None;
        _dragStarts.Clear();
        SetCursor(null);
        Session.Status = "내용 편집 중 — Esc 취소, 바깥을 누르면 완료";
        Session.Notify();
    }

    private void EndInlineEdit(bool keep)
    {
        if (_inlineId is null) return;
        var id = _inlineId;
        var snapshot = _inlineSnapshot;
        _inlineId = null;
        _inlineSnapshot = null;
        _inlineHistory = false;
        _inlineBound = false;

        if (!keep && snapshot is not null)
        {
            var list = Session.CurrentCell.Objects;
            var at = list.FindIndex(o => o.Id == id);
            if (at >= 0)
                list[at] = snapshot;
            Session.Status = "내용 편집 취소";
        }
        Session.Notify();
    }

    /// <summary>선택이 옮겨가거나 팝업이 열리면 편집기를 닫는다. 화면에 남아 떠 있으면 안 된다.</summary>
    private void CloseInlineIfStale()
    {
        if (_inlineId is null) return;
        if (Session.Dialog == EditorDialog.None
            && Session.SelectedIds.Contains(_inlineId)
            && InlineEdit is not null)
            return;
        _inlineId = null;
        _inlineSnapshot = null;
        _inlineHistory = false;
        _inlineBound = false;
    }

    private void OnInlineKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            EndInlineEdit(keep: false);
        else if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
            EndInlineEdit(keep: true);
    }

    /// <summary>
    /// 편집기 자리와 글자 크기. 상자는 mm를 96dpi 픽셀로 만들고 화면 배율만큼 한 번에 줄인다.
    /// 이러면 HTML이 pt로 적은 글자 크기가 SkiaSharp가 mm로 그린 크기와 맞는다.
    /// </summary>
    private (string Outer, string Inner) InlineEditStyle(DesignObject o, float ox, float oy, float viewScale)
    {
        var left = ox + o.X * viewScale;
        var top = oy + o.Y * viewScale;
        var w = Math.Max(4f, o.Width * viewScale);
        var h = Math.Max(4f, o.Height * viewScale);
        var rotate = Math.Abs(o.Rotation) > 0.01f ? $"transform:rotate({o.Rotation:0.##}deg);" : "";
        var outer = $"left:{left:0.##}px;top:{top:0.##}px;width:{w:0.##}px;height:{h:0.##}px;{rotate}";

        var zoom = viewScale / CssPxPerMm;
        var padX = DocumentRenderer.TextPadX(o) * CssPxPerMm;
        var justify = o.VerticalAlign switch
        {
            "top" => "flex-start",
            "bottom" => "flex-end",
            _ => "center"
        };
        var align = o.TextAlign switch
        {
            "center" or "right" or "justify" => o.TextAlign,
            _ => "left"
        };
        var wrap = o.TextWrap switch
        {
            "none" => "white-space:pre;",
            "word" => "white-space:pre-wrap;word-break:normal;overflow-wrap:break-word;",
            _ => "white-space:pre-wrap;word-break:break-all;"
        };
        var vertical = string.Equals(o.TextDirection, "vertical", StringComparison.OrdinalIgnoreCase)
            ? "writing-mode:vertical-rl;"
            : "";
        var inner =
            $"width:{o.Width * CssPxPerMm:0.##}px;height:{o.Height * CssPxPerMm:0.##}px;" +
            $"transform:scale({zoom:0.####});padding:0 {padX:0.##}px;" +
            $"justify-content:{justify};text-align:{align};" +
            $"line-height:{Math.Max(0.62f, o.LineHeight):0.##};" +
            $"letter-spacing:{o.LetterSpacing * CssPxPerMm:0.##}px;" +
            $"font-family:{CssFamily(o.FontFamily)};font-size:{FontCatalog.ToPt(o.FontSize):0.##}pt;" +
            $"font-weight:{(o.Bold ? "700" : "400")};font-style:{(o.Italic ? "italic" : "normal")};" +
            $"color:{ColorUtil.ToHtmlColor(o.Fill, "#2e2a27")};" +
            wrap + vertical;
        return (outer, inner);
    }

    private static string CssFamily(string? family)
    {
        var id = FontCatalog.CanonicalId(family);
        return id.Contains(' ', StringComparison.Ordinal) ? "'" + id.Replace("'", "") + "'" : id;
    }

    /// <summary>편집기에 처음 넣을 HTML. 일반텍스트는 구간 서식을 살리고, 워드아트는 줄만 옮긴다.</summary>
    private string InlineEditHtml()
    {
        if (InlineEdit is not { } o) return "";
        // 빈 글상자는 빈 span만 남아 커서가 설 자리가 없다. 줄바꿈 하나를 넣어 준다.
        if (string.IsNullOrEmpty(o.Text))
            return "<div><br></div>";
        if (RichTextModel.UsesRich(o))
            return RichTextModel.ToHtml(o);
        var lines = (o.Text ?? "").Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');
        return string.Concat(lines.Select(line => line.Length == 0
            ? "<div><br></div>"
            : "<div>" + System.Net.WebUtility.HtmlEncode(line).Replace(" ", "&nbsp;") + "</div>"));
    }

    [JSInvokable]
    public void OnRichModel(string json)
    {
        if (InlineEdit is not { } o) return;
        try
        {
            var dto = System.Text.Json.JsonSerializer.Deserialize<RichTextDto>(json, LabelDocumentJson.Options);
            if (dto is null) return;
            if (!_inlineHistory)
            {
                History.Push(Session.Document);
                _inlineHistory = true;
            }
            if (RichTextModel.UsesRich(o))
                RichTextModel.ReplaceFromDto(o, dto);
            else
                o.Text = string.Join('\n', (dto.Paragraphs ?? [])
                    .Select(p => string.Concat((p.Spans ?? []).Select(s => s.Text ?? ""))));
            Session.Dirty = true;
            Session.Notify();
        }
        catch (Exception ex)
        {
            EditorLog.Error("캔버스 글 편집 반영 실패", ex);
        }
    }

