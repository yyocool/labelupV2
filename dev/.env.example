APP_NAME=LabelUp
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=labelupdev
DB_USERNAME=root
DB_PASSWORD=

SESSION_KEY=labelupdev_session
SESSION_LIFETIME=7200

TIMEZONE=Asia/Seoul

# 인쇄용 QR 쿠폰 링크 기본 도메인
QR_PUBLIC_URL=https://www.labelup.co.kr

# 공개 읽기 API(/api/editor/papers)를 호출할 수 있는 추가 출처. 쉼표 구분.
# 기본으로 로컬 편집기 개발 포트(localhost:5224/7117/60705)는 허용되어 있다.
CORS_EXTRA_ORIGINS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_EASY=gpt-4o-mini
OPENAI_MODEL_HARD=gpt-4o-mini
OPENAI_ROUTE_BY_DIFFICULTY=1
OPENAI_MAX_TOKENS=1800
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=low
# USD→KRW 환율·단가(추정 비용 표시용, 필요 시 조정)
OPENAI_USD_KRW=1400
OPENAI_PRICE_MINI_INPUT=0.15
OPENAI_PRICE_MINI_OUTPUT=0.60
OPENAI_PRICE_4O_INPUT=2.50
OPENAI_PRICE_4O_OUTPUT=10.00
OPENAI_PRICE_GPT_IMAGE_LOW=0.02
OPENAI_PRICE_GPT_IMAGE_MEDIUM=0.07
OPENAI_PRICE_GPT_IMAGE_HIGH=0.16

# 소셜 로그인 (발급값 입력 후 버튼 활성화)
# 콜백 URL은 APP_URL 기준:
#   {APP_URL}/auth/naver/callback
#   {APP_URL}/auth/kakao/callback
#   {APP_URL}/auth/google/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 사업자정보 (카카오/네이버 비즈앱 검수·푸터 노출, SEO 관리자 설정과 동일 값 권장)
COMPANY_NAME=
COMPANY_CEO=
COMPANY_BIZ_NO=
COMPANY_MAIL_ORDER_NO=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_PRIVACY_OFFICER=

# 토스페이먼츠 (결제위젯 — 주문서형·결제창형 키: test_gck_ / test_gsk_)
# API 개별 연동키(test_ck_/test_sk_)는 위젯 연동에 쓰지 않음
TOSS_PAYMENTS_ENABLED=1
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_VARIANT_KEY=DEFAULT
TOSS_AGREEMENT_VARIANT_KEY=AGREEMENT
