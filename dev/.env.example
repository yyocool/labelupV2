APP_NAME=LabelUp
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=labelupdev
DB_USERNAME=root
DB_PASSWORD=

SESSION_KEY=labelupdev_session
SESSION_LIFETIME=7200

TIMEZONE=Asia/Seoul

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_EASY=gpt-4o-mini
OPENAI_MODEL_HARD=gpt-4o-mini
OPENAI_ROUTE_BY_DIFFICULTY=1
OPENAI_MAX_TOKENS=1800
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
# USD→KRW 환율·단가(추정 비용 표시용, 필요 시 조정)
OPENAI_USD_KRW=1400
OPENAI_PRICE_MINI_INPUT=0.15
OPENAI_PRICE_MINI_OUTPUT=0.60
OPENAI_PRICE_4O_INPUT=2.50
OPENAI_PRICE_4O_OUTPUT=10.00
OPENAI_PRICE_GPT_IMAGE_LOW=0.02
OPENAI_PRICE_GPT_IMAGE_MEDIUM=0.07
OPENAI_PRICE_GPT_IMAGE_HIGH=0.16

# 소셜 로그인 (발급값 입력 후 버튼 활성화)
# 콜백 URL은 APP_URL 기준:
#   {APP_URL}/auth/naver/callback
#   {APP_URL}/auth/kakao/callback
#   {APP_URL}/auth/google/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
