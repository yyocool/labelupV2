DirectoryIndex index.html
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/octet-stream .dll
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /editor/
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
